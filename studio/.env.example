# Copy to .env and fill in after `npx sanity login` + `npx sanity init`
# (see studio/README.md). These are safe to be public-ish (project id is
# not a secret) but keep the file out of git regardless.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Pitch preview until go-live. Used by "Open preview" in the document menu.
SANITY_STUDIO_PREVIEW_URL=https://movenda-preview.onrender.com
# GROQ playground — only for developers. Leave unset on the hosted Studio.
# SANITY_STUDIO_VISION=true
