---
import "../styles/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";

export interface Props {
  title: string;
  description: string;
  brand?: "movenda" | "mpc";
  path?: string;
  jsonLd?: Record<string, unknown>[];
  lang?: "nl" | "en";
  /** Path of this same page in the other language, for hreflang + the nav switcher. Omit if no translated counterpart exists yet (falls back to /en/ or /). */
  altPath?: string;
  ogImage?: string;
}

const {
  title,
  description,
  brand = "movenda",
  path = "/",
  jsonLd = [],
  lang = "nl",
  altPath,
  ogImage = "/og-default.svg",
} = Astro.props;

// Preview safety net: this site is a pitch preview until Movenda confirms
// go-live. PUBLIC_NOINDEX defaults to "true" so search engines never index
// it by accident. Set PUBLIC_NOINDEX=false in Render env vars only after
// DNS cutover (see DECISIONS.md).
const noindex = import.meta.env.PUBLIC_NOINDEX !== "false";
const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://movenda-preview.onrender.com";
const canonical = new URL(path, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();

// hreflang pair: NL is the default/x-default version (see DECISIONS.md — NL
// is the primary language of the practice). Only emitted when a translated
// counterpart page actually exists (altPath set).
const nlPath = lang === "en" ? altPath : path;
const enPath = lang === "en" ? path : altPath;
---

<!doctype html>
<html lang={lang === "en" ? "en" : "nl-BE"} data-brand={brand}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {nlPath && <link rel="alternate" hreflang="nl-BE" href={new URL(nlPath, siteUrl).toString()} />}
    {enPath && <link rel="alternate" hreflang="en" href={new URL(enPath, siteUrl).toString()} />}
    {nlPath && <link rel="alternate" hreflang="x-default" href={new URL(nlPath, siteUrl).toString()} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {jsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
    ))}
  </head>
  <body class="flex min-h-screen flex-col bg-brand-bg text-brand-text">
    <Header brand={brand} lang={lang} altPath={altPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer brand={brand} lang={lang} />
    <Analytics lang={lang} />
  </body>
</html>
