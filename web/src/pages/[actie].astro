---
import Layout from "../layouts/Layout.astro";
import ActiePagina from "../components/ActiePagina.astro";
import { getActiepaginas, localizeActie } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import { MPC_HOST } from "../lib/site";

export async function getStaticPaths() {
  if (MPC_HOST) return [];
  const paginas = await getActiepaginas();
  return paginas.map((pagina) => ({ params: { actie: pagina.slug }, props: { pagina } }));
}

const { pagina } = Astro.props;
const path = `/${pagina.slug}`;
const shown = localizeActie(pagina, "nl");
const description =
  shown.seoDescription || [shown.slogan, shown.intro?.split("\n")[0]].filter(Boolean).join(" ").slice(0, 160);
---

<Layout
  title={shown.seoTitle || `${shown.titel} | Sportpraktijk Movenda`}
  description={description}
  path={path}
  altPath={`/en/${pagina.slug}`}
  jsonLd={[breadcrumbSchema([{ name: "Home", path: "/" }, { name: shown.titel, path }])]}
  noindex={!pagina.zichtbaarInGoogle}
  ogImage={pagina.foto?.url}
>
  <ActiePagina pagina={pagina} lang="nl" />
</Layout>
