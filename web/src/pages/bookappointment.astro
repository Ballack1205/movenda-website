---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../lib/schema";

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Afspraak", path: "/bookappointment" },
  ]),
];
---

<Layout
  title="Afspraak | Movenda"
  description="Plan een afspraak bij Movenda of het Performance Centre."
  path="/bookappointment"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-bold">Afspraak</h1>
    <p class="mt-4 text-brand-muted">
      De afspraakmodule wordt hier geplaatst zodra de pagina gedeeld is. Tot dan plan je een afspraak via het contactformulier.
    </p>
    <p class="mt-6">
      <a class="font-semibold underline" href="/contact">Naar contact</a>
    </p>
  </section>
</Layout>
