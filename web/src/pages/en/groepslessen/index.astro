---
import Layout from "../../../layouts/Layout.astro";
import {
  getLesrooster,
  getLocatieBySlug,
  getPrijzenByCategorie,
  prijsNaam,
  formatPrijs,
  getDiensten,
  getPagina,
  lesHref,
  paginaAlineas,
  paginaTekst,
} from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/schema";
import { WEEKDAYS_NL, floorNote, weekday } from "../../../lib/i18n";
import LinkedText from "../../../components/LinkedText.astro";

const pagina = await getPagina("groepslessen");
const locatie = (await getLocatieBySlug("mpc"))!;
const intro = paginaAlineas(pagina, "en");
const rooster = await getLesrooster();
const diensten = await getDiensten();
const memberships = await getPrijzenByCategorie("mpc-groep");

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "Movenda Performance Centre", path: "/en/performance" },
    { name: "Group classes", path: "/en/groepslessen" },
  ]),
];
import SectionKicker from "../../../components/SectionKicker.astro";
---

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "Group classes & timetable | Movenda Performance Centre"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en/groepslessen"
  altPath="/groepslessen"
  lang="en"
  jsonLd={jsonLd}
>
  <section class="page-ink mx-auto max-w-6xl px-4 py-12">
    {pagina.ondertitelEn && <p class="text-sm font-semibold uppercase tracking-wide text-brand-primary">{pagina.ondertitelEn}</p>}
    <SectionKicker n={1} />
        <h1 class="mt-2 text-3xl font-bold">{paginaTekst(pagina, "titel", "en")}</h1>
    {intro.map((tekst, i) => (
      <p class="mt-3 max-w-2xl text-brand-muted">
        <LinkedText text={tekst} />{i === intro.length - 1 ? ` ${floorNote(locatie.verdiepingNote, "en") ?? ""}` : ""}
      </p>
    ))}

    <h2 class="mt-10 text-xl font-bold">Timetable</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {WEEKDAYS_NL.map((dag) => {
        const lessen = rooster.filter((r) => r.dag === dag);
        return (
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
            <h3 class="font-semibold text-brand-primary">{weekday(dag, "en")}</h3>
            {lessen.length === 0 ? (
              <p class="mt-2 text-sm text-brand-muted">No class</p>
            ) : (
              <ul class="mt-3 space-y-2 text-sm">
                {lessen.map((les) => (
                  <li>
                    <a href={lesHref(les, diensten, "en")} class="flex min-h-11 items-center gap-1 py-1 hover:underline">
                      <span class="font-medium">{les.van}–{les.tot}</span>
                      <span>· {les.les}</span>
                      {les.coachNaam && <span class="text-brand-muted"> — {les.coachNaam}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>

    {memberships.length > 0 && (
      <div class="mt-12">
        <h2 class="text-xl font-bold">Memberships</h2>
        <p class="mt-2 text-sm text-brand-muted">
          {paginaTekst(pagina, "prijsNotitie", "en")}
          {" "}
          <a href="/en/performance/prijzen" class="font-medium text-brand-primary hover:underline">All fees</a>
        </p>
        <div class="mt-4 overflow-x-auto rounded-2xl border border-brand-border">
          <table class="w-full min-w-[28rem] text-left text-sm">
            <tbody>
              {memberships.map((item, i) => (
                <tr class={i % 2 === 0 ? "bg-brand-surface" : ""}>
                  <td class="px-4 py-3">{prijsNaam(item, "en")}</td>
                  <td class="px-4 py-3 text-right font-semibold text-brand-primary">{formatPrijs(item, "en")}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </section>
</Layout>
