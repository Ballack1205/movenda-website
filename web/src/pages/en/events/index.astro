---
import Layout from "../../../layouts/Layout.astro";
import { getEvents, getPagina, paginaTekst } from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/schema";
import EventVideo from "../../../components/EventVideo.astro";

const events = await getEvents();
const pagina = await getPagina("events");
const today = new Date().toISOString().slice(0, 10);
const eventWhen = (datum: string) => {
  const date = new Date(`${datum}T12:00:00`);
  if (Number.isNaN(date.getTime())) return datum;
  return new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(date);
};
const upcoming = events.filter((event) => event.datum >= today);
const past = events.filter((event) => event.datum < today);
---

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "Events | Movenda"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en/events"
  altPath="/events"
  lang="en"
  jsonLd={[breadcrumbSchema([{ name: "Home", path: "/en" }, { name: "Events", path: "/en/events" }])]}
>
  <section class="page-ink mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">{paginaTekst(pagina, "titel", "en")}</h1>
    {pagina.introEn && <p class="mt-3 text-brand-muted">{pagina.introEn}</p>}
    {events.length === 0 && <p class="mt-8 text-brand-muted">{paginaTekst(pagina, "legeTekst", "en")}</p>}
    {upcoming.length > 0 && (
      <ul class="mt-8 space-y-6">
        {upcoming.map((event) => (
          <li>
            <p class="text-sm text-brand-muted">{eventWhen(event.datum)}{event.locatie ? ` · ${event.locatie}` : ""}</p>
            <h2 class="text-lg font-semibold">{event.titelEn || event.titel}</h2>
            {(event.tekstEn || event.tekst) && <p class="mt-1 text-brand-muted">{event.tekstEn || event.tekst}</p>}
            <EventVideo video={event.video} foto={event.foto} titel={event.titelEn || event.titel} />
          </li>
        ))}
      </ul>
    )}
    {past.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Past</h2>
        <ul class="mt-4 space-y-6">
          {past.map((event) => (
            <li>
              <p class="text-sm text-brand-muted">{eventWhen(event.datum)}{event.locatie ? ` · ${event.locatie}` : ""}</p>
              <h3 class="text-lg font-semibold">{event.titelEn || event.titel}</h3>
              <EventVideo video={event.video} foto={event.foto} titel={event.titelEn || event.titel} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Layout>
