---
import Layout from "../../../layouts/Layout.astro";
import { getEvents, getPagina, paginaTekst } from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/schema";
import EventKaart from "../../../components/EventKaart.astro";

const events = await getEvents();
const pagina = await getPagina("events");
const today = new Date().toISOString().slice(0, 10);
// Furthest in the future on top; past events below, most recent first.
const nieuwsteEerst = (a: { datum: string }, b: { datum: string }) => b.datum.localeCompare(a.datum);
const upcoming = events.filter((event) => event.datum >= today).sort(nieuwsteEerst);
const past = events.filter((event) => event.datum < today).sort(nieuwsteEerst);
---

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "Events | Movenda"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en/events"
  altPath="/events"
  lang="en"
  jsonLd={[breadcrumbSchema([{ name: "Home", path: "/en" }, { name: "Events", path: "/en/events" }])]}
>
  <section class="page-ink">
    <div class="mx-auto max-w-5xl px-4 py-12 md:py-16">
      <h1 class="font-heading text-4xl font-bold md:text-5xl">{paginaTekst(pagina, "titel", "en")}</h1>
      {pagina.introEn && <p class="mt-3 max-w-2xl text-brand-muted">{pagina.introEn}</p>}
      {events.length === 0 && <p class="mt-8 text-brand-muted">{paginaTekst(pagina, "legeTekst", "en")}</p>}

      {upcoming.length > 0 && (
        <div class="mt-12">
          <h2 class="events-kop">Upcoming</h2>
          <ul class="mt-5 space-y-4">
            {upcoming.map((event) => (
              <li><EventKaart event={event} lang="en" /></li>
            ))}
          </ul>
        </div>
      )}

      {past.length > 0 && (
        <div class="mt-14">
          <h2 class="events-kop">Past</h2>
          <ul class="mt-5 space-y-3">
            {past.map((event) => (
              <li><EventKaart event={event} lang="en" afgelopen /></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .events-kop {
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
