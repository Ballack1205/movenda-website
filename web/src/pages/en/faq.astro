---
import Layout from "../../layouts/Layout.astro";
import LinkedText from "../../components/LinkedText.astro";
import { getFaqs, getPagina, getSiteSettings, paginaAlineas, paginaTekst } from "../../lib/content";
import { breadcrumbSchema, faqPageSchema } from "../../lib/schema";
import { faqCopy } from "../../lib/i18n";

const faqs = await getFaqs("movenda");
const settings = await getSiteSettings();
const pagina = await getPagina("faq");
const shown = faqs.map((f) => ({ ...f, ...faqCopy(f, "en") }));

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "FAQ", path: "/en/faq" },
  ]),
  ...(shown.length > 0 ? [faqPageSchema(shown, "/en/faq")] : []),
];
import SectionKicker from "../../components/SectionKicker.astro";
---

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "Frequently asked questions | Movenda Hasselt"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en/faq"
  altPath="/faq"
  lang="en"
  jsonLd={jsonLd}
>
  <section class="page-ink mx-auto max-w-3xl px-4 py-12">
    <SectionKicker n={1} />
        <h1 class="text-3xl font-bold">{paginaTekst(pagina, "titel", "en")}</h1>
    {paginaAlineas(pagina, "en", { email: settings.email }).map((tekst) => (
      <p class="mt-2 text-brand-muted">
        <LinkedText text={tekst} linkClass="font-semibold text-brand-primary hover:underline" />
      </p>
    ))}

    <div class="mt-8 divide-y divide-brand-border rounded-2xl border border-brand-border bg-brand-surface">
      {shown.map((faq) => (
        <details class="group px-6 py-4">
          <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {faq.vraag}
              <span class="text-brand-primary transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm text-brand-muted">{faq.antwoord}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
