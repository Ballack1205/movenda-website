---
import Layout from "../../layouts/Layout.astro";
import { getFaqs, getSiteSettings } from "../../lib/content";
import { breadcrumbSchema, faqPageSchema } from "../../lib/schema";
import { faqCopy } from "../../lib/i18n";

const faqs = await getFaqs("movenda");
const settings = await getSiteSettings();
const shown = faqs.map((f) => ({ ...f, ...faqCopy(f, "en") }));

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "FAQ", path: "/en/faq" },
  ]),
  ...(shown.length > 0 ? [faqPageSchema(shown, "/en/faq")] : []),
];
---

<Layout
  title="Frequently asked questions | Movenda Hasselt"
  description="Answers to the most common questions about appointments, fees, doctor's prescriptions and more at Movenda."
  path="/en/faq"
  altPath="/faq"
  lang="en"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">Frequently asked questions</h1>
    <p class="mt-2 text-brand-muted">
      Can't find your question? Email us at{" "}
      <a href={`mailto:${settings.email}`} class="font-semibold text-brand-primary hover:underline">
        {settings.email}
      </a>.
    </p>

    <div class="mt-8 divide-y divide-brand-border rounded-2xl border border-brand-border bg-brand-surface">
      {shown.map((faq) => (
        <details class="group px-6 py-4">
          <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {faq.vraag}
              <span class="text-brand-primary transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm text-brand-muted">{faq.antwoord}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
