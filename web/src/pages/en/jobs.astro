---
import Layout from "../../layouts/Layout.astro";
import { getVacatures, getSiteSettings, getPagina, paginaAlineas, paginaTekst } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/schema";

const vacatures = await getVacatures();
const settings = await getSiteSettings();
const pagina = await getPagina("jobs");
const [leegKop, ...leegRest] = paginaTekst(pagina, "legeTekst", "en").split("\n");
const leegTekst = leegRest.join(" ").trim();

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "Jobs", path: "/en/jobs" },
  ]),
];
import SectionKicker from "../../components/SectionKicker.astro";
---

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "Jobs | Work at Movenda Hasselt"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en/jobs"
  altPath="/jobs"
  lang="en"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <SectionKicker n={1} />
        <h1 class="text-3xl font-bold">{paginaTekst(pagina, "titel", "en")}</h1>
    {paginaAlineas(pagina, "en").map((tekst) => (
      <p class="mt-2 text-brand-muted">{tekst}</p>
    ))}

    {vacatures.length === 0 ? (
      <div class="mt-10 rounded-2xl border border-brand-border bg-brand-surface p-8 text-center">
        <p class="font-semibold">{leegKop || "No open vacancies at the moment."}</p>
        <p class="mt-2 text-sm text-brand-muted">
          {leegTekst || "Speculative application? Email"}{" "}
          <a href={`mailto:${settings.email}`} class="font-semibold text-brand-primary hover:underline">
            {settings.email}
          </a>.
        </p>
      </div>
    ) : (
      <div class="mt-10 grid gap-6">
        {vacatures.map((vacature) => (
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-6">
            <h2 class="text-lg font-semibold">{vacature.titel}</h2>
            {vacature.locatieNaam && <p class="text-sm font-medium text-brand-primary">{vacature.locatieNaam}</p>}
            <p class="mt-2 whitespace-pre-line text-sm text-brand-muted">{vacature.omschrijving}</p>
            <a
              href={`mailto:${vacature.contactEmail}`}
              class="mt-4 inline-block font-semibold text-brand-primary hover:underline"
            >
              Apply via {vacature.contactEmail} →
            </a>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>
