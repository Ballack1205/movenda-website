---
import Layout from "../../../layouts/Layout.astro";
import DienstDetail from "../../../components/DienstDetail.astro";
import {
  getDienstenByCategorie,
  getDienstBySlug,
  getLocatieBySlug,
  getTeamleden,
  getPrijzen,
  findPrijsVoorDienst,
  dienstHref,
  dienstSeoTitleEn,
  dienstSeoDescriptionEn,
} from "../../../lib/content";
import { serviceNode, breadcrumbNode } from "../../../lib/schema";

export async function getStaticPaths() {
  const diensten = await getDienstenByCategorie("training");
  return diensten.map((dienst) => ({ params: { slug: dienst.slug } }));
}

const { slug } = Astro.params;
const dienst = await getDienstBySlug(slug!, "training");

if (!dienst) {
  return Astro.redirect("/en/training");
}

const locatie = (await getLocatieBySlug("olympia"))!;
const alleTeamleden = await getTeamleden();
const team = alleTeamleden.filter((t) => dienst.gekoppeldeTeamleden.includes(t.slug));
const path = dienstHref(dienst, "en");
const prijs = findPrijsVoorDienst(dienst, await getPrijzen());

const jsonLd = [
  serviceNode(dienst, locatie, { path, prijs, team, lang: "en" }),
  breadcrumbNode([
    { name: "Home", path: "/en" },
    { name: "Training", path: "/en/training" },
    { name: dienst.titelEn || dienst.titel, path },
  ]),
];
---

<Layout
  title={dienstSeoTitleEn(dienst)}
  description={dienstSeoDescriptionEn(dienst)}
  path={path}
  altPath={dienstHref(dienst)}
  lang="en"
  jsonLd={jsonLd}
  ogImage={dienst.afbeelding}
  ogImageAlt={`${dienst.titelEn || dienst.titel} at Movenda in Hasselt`}
>
  <DienstDetail
    dienst={dienst}
    team={team}
    locatie={locatie}
    backHref="/en/training"
    backLabel="← Back to training"
    lang="en"
  />
</Layout>
