---
import Layout from "../../../layouts/Layout.astro";
import BlogPostCard from "../../../components/BlogPostCard.astro";
import { getBlogPosts, getPagina, paginaAlineas, paginaTekst } from "../../../lib/content";
import { blogListSchema, breadcrumbSchema } from "../../../lib/schema";
import SectionKicker from "../../../components/SectionKicker.astro";
import LinkedText from "../../../components/LinkedText.astro";

const posts = await getBlogPosts();
const pagina = await getPagina("blog");

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "Blog", path: "/en/blog" },
  ]),
  blogListSchema(posts, "en"),
];
---

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "Blog | Movenda"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en/blog"
  altPath="/blog"
  lang="en"
  jsonLd={jsonLd}
  extraLinks={[
    { rel: "alternate", type: "application/rss+xml", href: "/rss.xml", title: "Movenda blog" },
    { rel: "alternate", type: "text/markdown", href: "/blog.md", title: "Blog (Markdown)" },
  ]}
>
  <section class="mx-auto max-w-6xl px-4 py-12 lg:py-16">
    <SectionKicker n={1} />
    {paginaTekst(pagina, "ondertitel", "en") && (
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-primary">{paginaTekst(pagina, "ondertitel", "en")}</p>
    )}
    <h1 class="mt-2 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
      {paginaTekst(pagina, "titel", "en")}
    </h1>
    {paginaAlineas(pagina, "en").map((tekst) => (
      <p class="mt-4 max-w-2xl text-lg text-brand-muted"><LinkedText text={tekst} /></p>
    ))}

    {posts.length === 0 ? (
      <p class="mt-10 text-brand-muted">{paginaTekst(pagina, "legeTekst", "en")}</p>
    ) : (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {posts.map((post) => (
          <BlogPostCard post={post} lang="en" />
        ))}
      </div>
    )}
  </section>
</Layout>
