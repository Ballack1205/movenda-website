---
import BlogTagPage from "../../../../components/BlogTagPage.astro";
import { getBlogPosts } from "../../../../lib/content";
import { BLOG_TAGS } from "../../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return BLOG_TAGS.filter((tag) => posts.some((post) => post.tags?.includes(tag.value))).map((tag) => ({
    params: { tag: tag.value },
  }));
}
---

<BlogTagPage lang="en" tag={Astro.params.tag!} />
