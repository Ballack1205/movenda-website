---
import Layout from "../../../layouts/Layout.astro";
import DienstDetail from "../../../components/DienstDetail.astro";
import {
  getDienstenByCategorie,
  getDienstBySlug,
  getLocatieBySlug,
  getTeamleden,
  getPrijzen,
  findPrijsVoorDienst,
  dienstHref,
  dienstSeoTitleEn,
  dienstSeoDescriptionEn,
} from "../../../lib/content";
import { serviceNode, breadcrumbNode } from "../../../lib/schema";

export async function getStaticPaths() {
  const diensten = await getDienstenByCategorie("mpc");
  return diensten.map((dienst) => ({ params: { slug: dienst.slug } }));
}

const { slug } = Astro.params;
const dienst = await getDienstBySlug(slug!, "mpc");

if (!dienst) {
  return Astro.redirect("/en/mpc");
}

const locatie = (await getLocatieBySlug("mpc"))!;
const alleTeamleden = await getTeamleden();
const team = alleTeamleden.filter((t) => dienst.gekoppeldeTeamleden.includes(t.slug));
const path = dienstHref(dienst, "en");
const prijs = findPrijsVoorDienst(dienst, await getPrijzen());

const jsonLd = [
  serviceNode(dienst, locatie, { path, prijs, team, lang: "en" }),
  breadcrumbNode([
    { name: "Home", path: "/en" },
    { name: "Movenda Performance Centre", path: "/en/mpc" },
    { name: dienst.titelEn || dienst.titel, path },
  ]),
];
---

<Layout
  title={dienstSeoTitleEn(dienst)}
  description={dienstSeoDescriptionEn(dienst)}
  path={path}
  altPath={dienstHref(dienst)}
  brand="mpc"
  lang="en"
  jsonLd={jsonLd}
  ogImage={dienst.afbeelding}
  ogImageAlt={`${dienst.titelEn || dienst.titel} at the Movenda Performance Centre`}
>
  <DienstDetail
    dienst={dienst}
    team={team}
    locatie={locatie}
    backHref="/en/mpc"
    backLabel="← Back to MPC"
    lang="en"
  />
</Layout>
