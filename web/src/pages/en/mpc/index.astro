---
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import GoogleReviewBadge from "../../../components/GoogleReviewBadge.astro";
import { getDienstenByCategorie, getLocatieBySlug } from "../../../lib/content";
import { localBusinessSchema, breadcrumbSchema } from "../../../lib/schema";
import mpcHero from "../../../assets/marketing/mpc-hero.jpg";

const diensten = await getDienstenByCategorie("mpc");
const locatie = (await getLocatieBySlug("mpc"))!;

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "Movenda Performance Centre", path: "/en/mpc" },
  ]),
];
---

<Layout
  title="Performance training & sports rehabilitation Hasselt | Movenda Performance Centre"
  description="Movenda Performance Centre in Kuringen: data-driven performance training and sports rehabilitation for recreational and professional athletes."
  path="/en/mpc"
  altPath="/mpc"
  brand="mpc"
  lang="en"
  jsonLd={jsonLd}
>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-primary">
        Movenda Performance Centre
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Perform at your highest level, data-driven
      </h1>
      <p class="mt-4 max-w-xl text-brand-muted">
        A multidisciplinary performance centre focused on maximising performance for
        (semi-)professional athletes and evidence-based medical rehabilitation. Open space,
        high-end equipment and one-on-one coaching.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark">
          Call {locatie.telefoon}
        </a>
        <a href="/en/contact" class="rounded-full border border-brand-border px-6 py-3 font-semibold text-brand-text transition hover:border-brand-primary">
          Contact us
        </a>
      </div>
      <div class="mt-6">
        <GoogleReviewBadge locatie="mpc" />
      </div>
    </div>
    <Image
      src={mpcHero}
      alt="Movenda Performance Centre training space"
      width={640}
      height={800}
      class="aspect-[4/5] w-full rounded-3xl object-cover shadow-xl"
      priority
    />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="text-2xl font-bold">Our services</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {diensten.map((dienst) => (
        <div class="rounded-2xl border border-brand-border bg-brand-surface p-8">
          <h3 class="text-xl font-semibold">{dienst.titelEn || dienst.titel}</h3>
          <p class="mt-2 text-brand-muted">{dienst.intro}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
