---
import Layout from "../../../layouts/Layout.astro";
import { getLocatieBySlug, getSiteSettings, getPagina, paginaAlineas, paginaTekst } from "../../../lib/content";
import { breadcrumbSchema } from "../../../lib/schema";

const locatie = (await getLocatieBySlug("mpc"))!;
const settings = await getSiteSettings();
const pagina = await getPagina("mpc-visie");

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "Movenda Performance Centre", path: "/en/mpc" },
    { name: "Vision", path: "/en/mpc/visie" },
  ]),
];
import SectionKicker from "../../../components/SectionKicker.astro";
---

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "Vision | Movenda Performance Centre"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en/mpc/visie"
  altPath="/mpc/visie"
  brand="mpc"
  lang="en"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <a href="/en/mpc" class="text-sm font-medium text-brand-primary">← Back to MPC</a>
    <SectionKicker n={1} />
        <h1 class="mt-4 text-3xl font-bold">{paginaTekst(pagina, "titel", "en")}</h1>
    {settings.slogans.mpc && (
      <p class="mt-3 text-lg font-medium text-brand-primary">{settings.slogans.mpc}</p>
    )}
    <div class="mt-6 space-y-4 leading-relaxed text-brand-muted">
      {paginaAlineas(pagina, "en").map((tekst) => <p>{tekst}</p>)}
      <p>
        {locatie.adres}. By appointment only.
      </p>
    </div>
    <a href="/en/contact" class="mt-10 inline-block rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark">
      {paginaTekst(pagina, "ctaTekst", "en") || "Contact us"}
    </a>
  </article>
</Layout>
