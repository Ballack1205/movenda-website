---
import { getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import MpcHome from "../../components/MpcHome.astro";
import { MPC_HOST, THEME } from "../../lib/site";
import LabCover from "../../components/LabCover.astro";
import LabStrip from "../../components/LabStrip.astro";
import GoogleReviewBadge from "../../components/GoogleReviewBadge.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import BookingButton from "../../components/BookingButton.astro";
import PartnerBand from "../../components/PartnerBand.astro";
import NewsletterBlock from "../../components/NewsletterBlock.astro";
import InstagramFeed from "../../components/InstagramFeed.astro";
import GetuigenisCarousel from "../../components/GetuigenisCarousel.astro";
import GoogleReviewsFeed from "../../components/GoogleReviewsFeed.astro";
import TeamCarousel from "../../components/TeamCarousel.astro";
import SloganBanner from "../../components/SloganBanner.astro";
import HomePijler from "../../components/HomePijler.astro";
import PaginaFoto from "../../components/PaginaFoto.astro";
import CmsFoto from "../../components/CmsFoto.astro";
import {
  getTeamleden,
  getSiteSettings,
  getDienstenByCategorie,
  getPartners,
  getGetuigenissen,
  getLocaties,
  getPagina,
  homePijlerDiensten,
  homeDeurNaam,
  homeDeurRegel,
  homeDeurTekst,
  localizeInternalHref,
  paginaAlineas,
  paginaTekst,
  teamCounts,
} from "../../lib/content";
import { partnerBandTitle } from "../../lib/i18n";
import homeHero from "../../assets/marketing/home-hero.jpg";
import mpcHero from "../../assets/marketing/mpc-hero.jpg";
import homeSquats from "../../assets/marketing/home-squats.jpg";
import kineHero from "../../assets/marketing/kine-hero.jpg";
import trainingSecondary from "../../assets/marketing/training-secondary.jpg";

const team = await getTeamleden();
const settings = await getSiteSettings();
const alleDiensten = {
  kine: await getDienstenByCategorie("kine"),
  training: await getDienstenByCategorie("training"),
  mpc: await getDienstenByCategorie("mpc"),
};
const afspraakHref =
  settings.booking.enabled && settings.booking.url ? settings.booking.url : "/en/contact";
const partners = await getPartners("movenda");
const getuigenissen = await getGetuigenissen("olympia", "en");

// Photo label: "Olympia · Hasselt | Performance Centre · Kuringen", from the Locatie records.
// Main practice (Olympia) first.
const heroLocaties = (await getLocaties())
  .sort((a, b) => (a.slug === "olympia" ? -1 : b.slug === "olympia" ? 1 : 0))
  .map((loc) => ({
  href: `/en/locaties/${loc.slug}`,
  naam: loc.naam.replace(/^Movenda\s+/i, ""),
  gemeente: loc.adres.split(",").pop()?.trim().replace(/^\d{4}\s*/, "") ?? "",
}));

const pagina = await getPagina("home");
// The MPC teaser card at the bottom reuses the MPC page hero photo (Pagina's → MPC → Hoofdfoto).
const mpcPagina = await getPagina("mpc");
const mpcTeaserFoto = mpcPagina.foto
  ? { url: mpcPagina.foto, hotspot: mpcPagina.fotoHotspot, alt: mpcPagina.fotoAlt }
  : undefined;

const heroSizes = "(min-width: 1024px) 60vw, 100vw";
const heroWidths = [640, 960, 1280];
const heroPreload = pagina.foto ? null : await getImage({ src: homeHero, widths: heroWidths, sizes: heroSizes });
const heroLinks = heroPreload
  ? [
      {
        rel: "preload",
        as: "image",
        href: heroPreload.src,
        imagesrcset: heroPreload.srcSet.attribute,
        imagesizes: heroSizes,
        fetchpriority: "high" as const,
      },
    ]
  : [];

const { kinesisten: kinesistenCount, trainers: trainerCount } = teamCounts(team);
const heroIntro = paginaAlineas(pagina, "en", { kinesisten: kinesistenCount, trainers: trainerCount });
const heroEyebrow = paginaTekst(pagina, "ondertitel", "en");
const deurFallback = {
  "/kinesitherapie": kineHero,
  "/training": trainingSecondary,
  "/mpc": mpcHero,
} as const;
const labDeuren = settings.homeDeuren.map((deur, i) => ({
  n: i + 1,
  href: localizeInternalHref(deur.href, "en"),
  title: homeDeurNaam(deur, "en"),
  line: homeDeurRegel(deur, "en"),
  body: homeDeurTekst(deur, "en"),
  foto: deur.foto,
  fallback: deurFallback[deur.href as keyof typeof deurFallback] ?? homeHero,
  alt: homeDeurNaam(deur, "en"),
}));
---

{MPC_HOST ? (
  <MpcHome lang="en" path="/en" altPath="/" />
) : (

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "Physiotherapy & personal training Hasselt | Movenda"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en"
  altPath="/"
  lang="en"
  extraLinks={heroLinks}
>
  {THEME === "lab" && (
      <LabCover
        pagina={pagina}
        fallback={homeHero}
        alt="A Movenda trainer coaching a client during a session"
        shout="Movenda"
        line="Move. Recover. Perform."
        nextLabel="Continue"
      />
  )}
  <div class:list={[THEME === "lab" && "lab-sheet"]}>
  {THEME === "lab" ? (
    <>
      <section id="lab-next" class="lab-intro" data-reveal>
        <h2 class="lab-shout lab-intro__title">{settings.homeDeurenTitelEn || settings.homeDeurenTitel}</h2>
        <p>{heroIntro.join(" ")}</p>
        <a href="/en/contact" class="lab-intro__cta">Contact us</a>
      </section>
      <LabStrip items={labDeuren} />
    </>
  ) : (
  <section class="hero relative overflow-hidden">
    <div
      class="mx-auto grid max-w-6xl gap-8 px-4 pt-8 pb-6 sm:pb-10 lg:max-w-none lg:grid-cols-[1fr_minmax(0,36rem)_minmax(0,36rem)_1fr] lg:gap-0 lg:px-0 lg:pt-0 lg:pb-0"
    >
      <div class="hero-copy order-last flex flex-col justify-center lg:order-none lg:col-start-2 lg:col-end-3 lg:py-10 lg:pr-10 lg:pl-4 xl:pr-12">
        {/* Eyebrow: on mobile it sits on the photo (see .hero-eyebrow below) so the H1 starts right under it. */}
        <p class="hero-in hidden text-base font-medium text-brand-primary lg:block">
          {heroEyebrow}
        </p>
        <h1 class="hero-in text-display lg:mt-3">
          {paginaTekst(pagina, "titel", "en")}
        </h1>
        <p class="hero-in mt-5 max-w-md text-[1.0625rem] leading-relaxed text-brand-muted">
          {heroIntro.join(" ")}
        </p>
        {/* Both CTAs fit on one row from 360px up (tighter padding + text-sm below sm). Narrower than that they stack full-width. */}
        <div class="hero-in mt-6 flex flex-wrap items-center gap-2.5 sm:gap-3">
          <a
            href={`tel:${settings.telefoonOlympia.replace(/\s+/g, "")}`}
            class="whitespace-nowrap rounded-full bg-brand-primary px-4 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-primary-dark max-[359px]:w-full sm:px-6 sm:text-base"
          >
            Call {settings.telefoonOlympia}
          </a>
          <a
            href="/en/contact"
            class="whitespace-nowrap rounded-full border border-brand-border px-4 py-3 text-center text-sm font-semibold text-brand-text transition hover:border-brand-primary max-[359px]:w-full sm:px-6 sm:text-base"
          >
            Contact us
          </a>
          <BookingButton lang="en" />
        </div>
        <div class="hero-in mt-7 flex flex-col items-center gap-y-1 border-t border-brand-border pt-5 sm:flex-row sm:flex-wrap sm:gap-x-8 sm:gap-y-3">
          <GoogleReviewBadge locatie="olympia" lang="en" />
          <SocialLinks lang="en" class="-mx-2" />
        </div>
      </div>

      <div class="hero-media relative -mx-4 -mt-8 sm:mx-0 sm:mt-0 lg:col-start-3 lg:col-end-5 lg:min-h-[32rem]">
        <PaginaFoto
          pagina={pagina}
          fallback={homeHero}
          alt="A Movenda trainer coaching a client during a session"
          width={1280}
          height={853}
          widths={heroWidths}
          sizes={heroSizes}
          class="hero-photo aspect-[4/3] w-full object-cover sm:aspect-[3/2] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
          priority
        />
        {/* Mobile eyebrow: a compact glass chip bottom-left on the photo, with a soft scrim behind it so it reads on any crop. */}
        <div
          class="hero-eyebrow pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-center bg-gradient-to-t from-black/55 via-black/20 to-transparent px-4 pb-4 pt-20 sm:px-5 lg:hidden"
        >
          <p
            class="inline-flex max-w-full items-center gap-2 whitespace-nowrap rounded-full bg-black/60 px-3.5 py-2 text-[0.75rem] font-semibold leading-tight tracking-tight text-white ring-1 ring-white/25 min-[375px]:text-[0.8125rem] sm:text-sm"
          >
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-white shadow-[0_0_0_3px_rgba(255,255,255,0.25)]" aria-hidden="true"></span>
            {heroEyebrow}
          </p>
        </div>
        <figure class="hero-inset absolute bottom-6 -left-10 hidden w-40 xl:block">
          <CmsFoto
            foto={settings.homePijlers.kine.foto}
            fallback={kineHero}
            alt="A Movenda physiotherapist treating a patient"
            width={352}
            height={440}
            class="aspect-[4/5] w-full object-cover ring-8 ring-brand-bg"
          />
        </figure>
        <nav
          aria-label="Our locations"
          class="hero-label absolute bottom-6 right-6 hidden items-center gap-3 rounded-full bg-white/90 py-2 pl-3 pr-4 text-sm text-brand-text shadow-md backdrop-blur lg:flex"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand-primary" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          {heroLocaties.map((loc, i) => (
            <>
              {i > 0 && <span class="h-4 w-px bg-brand-border" aria-hidden="true"></span>}
              <a href={loc.href} class="whitespace-nowrap hover:text-brand-primary">
                <span class="font-semibold">{loc.naam}</span>
                <span class="text-brand-muted"> · {loc.gemeente}</span>
              </a>
            </>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <style>
    @media (prefers-reduced-motion: no-preference) {
      .hero-in {
        animation: hero-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }
      .hero-in:nth-child(2) { animation-delay: 0.06s; }
      .hero-in:nth-child(3) { animation-delay: 0.12s; }
      .hero-in:nth-child(4) { animation-delay: 0.18s; }
      .hero-in:nth-child(5) { animation-delay: 0.24s; }
      /* Scale only the photo — see the matching comment on the Dutch homepage. */
      .hero-photo {
        animation: hero-settle 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }
      .hero-inset,
      .hero-label {
        animation: hero-rise 0.7s 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }
    }
    @keyframes hero-rise {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: none; }
    }
    @keyframes hero-settle {
      from { transform: scale(1.02); }
      to { transform: none; }
    }
  </style>
  )}

  {THEME !== "lab" && <PartnerBand
    partners={partners}
    title={partnerBandTitle(settings.partnerband.titel, "en")}
    snelheid={settings.partnerband.snelheid}
    animatie={settings.partnerband.animatie}
  />}

  {THEME !== "lab" && settings.slogans.home && (
    <SloganBanner quote={settings.slogans.home} image={homeSquats} foto={pagina.bannerFoto} />
  )}

  {THEME !== "lab" && <section class="mx-auto max-w-6xl divide-y divide-brand-border px-4 py-4">
    <HomePijler
      pijler={settings.homePijlers.kine}
      diensten={homePijlerDiensten("kine", alleDiensten)}
      image={kineHero}
      imageAlt="Physiotherapist treating a patient at Movenda in Hasselt"
      aanbodHref="/en/kinesitherapie"
      aanbodLabel="See our physiotherapy services"
      afspraakHref={afspraakHref}
      lang="en"
    />
    <HomePijler
      pijler={settings.homePijlers.training}
      diensten={homePijlerDiensten("training", alleDiensten)}
      image={trainingSecondary}
      imageAlt="Personal trainer coaching a client through an exercise at Movenda"
      aanbodHref="/en/training"
      aanbodLabel="See our training services"
      afspraakHref={afspraakHref}
      lang="en"
      reverse
    />
    <HomePijler
      pijler={settings.homePijlers.mpc}
      diensten={homePijlerDiensten("mpc", alleDiensten)}
      image={mpcHero}
      imageAlt="Performance training at the Movenda Performance Centre in Kuringen"
      aanbodHref="/en/mpc"
      aanbodLabel="Discover the Performance Centre"
      afspraakHref={afspraakHref}
      lang="en"
    />
  </section>}

  <section class="mx-auto grid max-w-6xl gap-4 px-4 pt-2 pb-10 sm:grid-cols-2 sm:gap-6 sm:py-16">
    <a
      href="/en/locaties/olympia"
      class="group rounded-2xl border border-brand-border bg-brand-surface p-6 transition hover:border-brand-primary sm:p-8"
    >
      <h2 class="text-2xl font-bold text-brand-primary">Movenda — Kuringersteenweg</h2>
      <p class="mt-2 text-brand-muted">
        Physiotherapy and personal training on Kuringersteenweg in Hasselt. Manual therapy,
        dry needling, acupuncture, sport-specific training and more.
      </p>
      <span class="mt-4 inline-block font-semibold text-brand-primary group-hover:underline">
        See the location →
      </span>
    </a>
    <a
      href="/en/mpc"
      class="group relative overflow-hidden rounded-2xl p-6 text-white transition hover:opacity-95 sm:p-8"
    >
      <CmsFoto foto={mpcTeaserFoto} fallback={mpcHero} alt="" decorative width={640} height={480} class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-brand-header/80"></div>
      <div class="relative">
        <h2 class="text-2xl font-bold text-white">Movenda Performance Centre</h2>
        <p class="mt-2 text-white/80">
          Performance training and sports rehabilitation in Kuringen, data-driven and one-on-one,
          for recreational and professional athletes.
        </p>
        <span class="mt-4 inline-block font-semibold text-white group-hover:underline">
          See MPC →
        </span>
      </div>
    </a>
  </section>

  <section class="bg-brand-surface py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-2xl font-bold">Our team</h2>
      <p class="mt-2 max-w-2xl text-brand-muted">
        {team.length} physiotherapists, personal trainers and performance coaches — each with their
        own specialisation.
      </p>
      <div class="mt-8">
        <TeamCarousel team={team} lang="en" />
      </div>
      <a href="/en/team" class="mt-6 inline-block font-semibold text-brand-primary hover:underline">
        Meet the full team →
      </a>
    </div>
  </section>

  <GetuigenisCarousel items={getuigenissen} lang="en" />

  <GoogleReviewsFeed settings={settings} lang="en" />

  <InstagramFeed settings={settings} lang="en" />

  <NewsletterBlock settings={settings} lang="en" />
  </div>
</Layout>
)}
