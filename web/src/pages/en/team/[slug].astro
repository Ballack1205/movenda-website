---
import Layout from "../../../layouts/Layout.astro";
import {
  getTeamleden,
  getTeamlidBySlug,
  getLocaties,
  locatieKorteNamen,
  rolKort,
  truncateAtSentence,
} from "../../../lib/content";
import { personNode, breadcrumbNode } from "../../../lib/schema";
import { teamPhotoSrc } from "../../../lib/images";

export async function getStaticPaths() {
  const team = await getTeamleden();
  return team.map((lid) => ({ params: { slug: lid.slug } }));
}

const { slug } = Astro.params;
const lid = await getTeamlidBySlug(slug!);

if (!lid) {
  return Astro.redirect("/en/team");
}

const locaties = await getLocaties();
const rol = lid.rolEn || lid.rol;
const bio = lid.bioEn || lid.bio;
const opleiding = (lid.opleiding || "").split("\n").map((r) => r.trim()).filter(Boolean);

const jsonLd = [
  personNode(lid, "en"),
  breadcrumbNode([
    { name: "Home", path: "/en" },
    { name: "Team", path: "/en/team" },
    { name: `${lid.voornaam} ${lid.naam}`, path: `/en/team/${lid.slug}` },
  ]),
];

const title = `${lid.voornaam} ${lid.naam} | ${rolKort(rol)} Hasselt | Movenda`;
import SectionKicker from "../../../components/SectionKicker.astro";
import TeamlidProfiel from "../../../components/TeamlidProfiel.astro";
---

<Layout
  title={title.length <= 60 ? title : `${lid.voornaam} ${lid.naam} | ${rolKort(rol)} | Movenda`}
  description={truncateAtSentence(bio, 155)}
  path={`/en/team/${lid.slug}`}
  altPath={`/team/${lid.slug}`}
  lang="en"
  jsonLd={jsonLd}
  ogImage={lid.foto}
  ogImageShape="square"
  ogImageAlt={`${lid.voornaam} ${lid.naam}, ${rol} at Movenda`}
>
  <article class="page-ink mx-auto max-w-3xl px-4 py-12">
    <a href="/en/team" class="text-sm font-medium text-brand-primary hover:underline">← Back to the team</a>

    <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-start">
      <div class="aspect-[2/3] w-40 shrink-0 overflow-hidden rounded-2xl bg-brand-header">
        {lid.foto ? (
          <img
            src={teamPhotoSrc(lid.foto, "detail")}
            alt={`${lid.voornaam} ${lid.naam}`}
            width="160"
            height="240"
            class="h-full w-full object-cover object-top"
          />
        ) : (
          <div class="flex h-full w-full items-center justify-center text-3xl font-bold text-white/80">
            {lid.voornaam[0]}{lid.naam[0]}
          </div>
        )}
      </div>
      <div>
        <SectionKicker n={1} />
        <h1 class="text-3xl font-bold">{lid.voornaam} {lid.naam}</h1>
        <p class="mt-1 text-lg font-medium text-brand-primary">{rol}</p>
        <p class="mt-2 text-sm text-brand-muted">{locatieKorteNamen(lid.locaties, locaties).join(" · ")}</p>
        {opleiding.map((r) => <p class="mt-1 text-xs text-brand-muted">{r}</p>)}
      </div>
    </div>

    {!lid.bioEn && (
      <p class="mt-6 rounded-xl bg-brand-surface px-3 py-2 text-xs text-brand-muted">
        This bio is currently in Dutch. The English translation will follow.
      </p>
    )}
    <TeamlidProfiel lid={lid} lang="en" />

    <p class="mt-8">
      <a href={`mailto:${lid.email}`} class="font-semibold text-brand-primary hover:underline">
        {lid.email}
      </a>
    </p>
  </article>
</Layout>
