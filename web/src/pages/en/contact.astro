---
import Layout from "../../layouts/Layout.astro";
import { getLocaties } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/schema";

const locaties = (await getLocaties()).sort((a, b) =>
  a.slug === "olympia" ? -1 : b.slug === "olympia" ? 1 : 0,
);
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || "https://movenda-contact-api.onrender.com";

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "Contact", path: "/en/contact" },
  ]),
];
---

<Layout
  title="Contact & appointments | Movenda Hasselt"
  description="Get in touch with Movenda (Olympia, Hasselt) or the Movenda Performance Centre (Kuringen) by phone, email or the contact form."
  path="/en/contact"
  altPath="/contact"
  lang="en"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold">Get in touch</h1>
    <p class="mt-2 max-w-2xl text-brand-muted">
      Have a question or want to book an appointment? Fill in the form and we'll get back to you
      as soon as possible. You can also call or email us directly.
    </p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {locaties.map((locatie) => (
        <div class="rounded-2xl border border-brand-border bg-brand-surface p-6">
          <h2 class="text-lg font-semibold text-brand-primary">{locatie.naam}</h2>
          <p class="mt-2 text-sm text-brand-muted">{locatie.adres}</p>
          <p class="mt-3 text-sm">
            <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="font-semibold text-brand-primary hover:underline">
              {locatie.telefoon}
            </a>
          </p>
          <p class="text-sm">
            <a href={`mailto:${locatie.email}`} class="font-semibold text-brand-primary hover:underline">
              {locatie.email}
            </a>
          </p>
        </div>
      ))}
    </div>

    <form class="mt-12 grid gap-4" data-contact-form>
      <div class="grid gap-4 sm:grid-cols-2">
        <input class="rounded-lg border border-brand-border px-4 py-3" type="text" name="naam" placeholder="Name" required />
        <input class="rounded-lg border border-brand-border px-4 py-3" type="email" name="email" placeholder="Email" required />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <input class="rounded-lg border border-brand-border px-4 py-3" type="tel" name="telefoon" placeholder="Phone (optional)" />
        <select class="rounded-lg border border-brand-border px-4 py-3" name="locatie">
          <option value="">Which location?</option>
          <option value="Movenda Olympia">Movenda — Olympia</option>
          <option value="Movenda Performance Centre">Movenda Performance Centre</option>
        </select>
      </div>
      <textarea class="rounded-lg border border-brand-border px-4 py-3" name="bericht" rows="5" placeholder="Your message" required minlength="5"></textarea>
      <input class="hidden" type="text" name="website" tabindex="-1" autocomplete="off" />
      <button type="submit" class="w-fit rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark">
        Send
      </button>
      <p class="text-sm" data-contact-status role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>

<script define:vars={{ apiUrl: contactApiUrl }} is:inline>
  const form = document.querySelector("[data-contact-form]");
  const status = document.querySelector("[data-contact-status]");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    const button = form.querySelector("button[type=submit]");
    button.disabled = true;
    status.textContent = "Sending…";
    status.className = "text-sm text-brand-muted";

    try {
      const res = await fetch(`${apiUrl}/api/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("send_failed");
      status.textContent = "Thanks! We'll get back to you as soon as possible.";
      status.className = "text-sm font-semibold text-brand-primary";
      window.mvTrack?.("form_submit", { form: "contact" });
      form.reset();
    } catch {
      status.textContent = "Something went wrong sending this. Please call or email us directly — see above.";
      status.className = "text-sm font-semibold text-red-600";
    } finally {
      button.disabled = false;
    }
  });
</script>
