---
import AanbodOverzicht from "../../../components/AanbodOverzicht.astro";
import Layout from "../../../layouts/Layout.astro";
import { getPagina, paginaAlineas, paginaTekst } from "../../../lib/content";
import { getBriefAanbod } from "../../../lib/nav";
import { breadcrumbSchema } from "../../../lib/schema";

const pagina = await getPagina("b2b");
const aanbod = (await getBriefAanbod("en")).find((group) => group.label === "B2B")?.children ?? [];

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/en" },
    { name: "B2B", path: "/en/b2b" },
  ]),
];
---

<Layout
  title={paginaTekst(pagina, "seoTitle", "en") || "B2B for companies | Movenda"}
  description={paginaTekst(pagina, "seoDescription", "en")}
  path="/en/b2b"
  altPath="/b2b"
  lang="en"
  jsonLd={jsonLd}
>
  <AanbodOverzicht
    kicker={paginaTekst(pagina, "ondertitel", "en")}
    titel={paginaTekst(pagina, "titel", "en")}
    alineaas={paginaAlineas(pagina, "en")}
    blokken={pagina.blokken}
    aanbodTitel="Offer"
    aanbod={aanbod}
    lang="en"
  >
    <a slot="actions" href="/en/contact?behandeling=B2B" class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white">
      Request a tailored proposal
    </a>
  </AanbodOverzicht>
</Layout>
