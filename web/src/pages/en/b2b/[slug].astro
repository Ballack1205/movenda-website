---
import Layout from "../../../layouts/Layout.astro";
import DienstDetail from "../../../components/DienstDetail.astro";
import {
  getDiensten,
  getLocatieBySlug,
  getTeamleden,
  getPrijzen,
  findPrijsVoorDienst,
  dienstHref,
  dienstSeoTitleEn,
  dienstSeoDescriptionEn,
  isB2bDienst,
} from "../../../lib/content";
import { serviceNode, breadcrumbNode } from "../../../lib/schema";

export async function getStaticPaths() {
  const diensten = await getDiensten();
  return diensten.filter(isB2bDienst).map((dienst) => ({ params: { slug: dienst.slug } }));
}

const { slug } = Astro.params;
const dienst = (await getDiensten()).find((item) => item.slug === slug && isB2bDienst(item));

if (!dienst) {
  return Astro.redirect("/en/b2b");
}

const locatie = (await getLocatieBySlug("mpc"))!;
const team = (await getTeamleden()).filter((lid) => dienst.gekoppeldeTeamleden.includes(lid.slug));
const path = dienstHref(dienst, "en");
const prijs = findPrijsVoorDienst(dienst, await getPrijzen());

const jsonLd = [
  serviceNode(dienst, locatie, { path, prijs, team, lang: "en" }),
  breadcrumbNode([
    { name: "Home", path: "/en" },
    { name: "B2B", path: "/en/b2b" },
    { name: dienst.titelEn || dienst.titel, path },
  ]),
];
---

<Layout
  title={dienstSeoTitleEn(dienst)}
  description={dienstSeoDescriptionEn(dienst)}
  path={path}
  altPath={dienstHref(dienst)}
  lang="en"
  jsonLd={jsonLd}
>
  <DienstDetail
    dienst={dienst}
    team={team}
    locatie={locatie}
    backHref="/en/b2b"
    backLabel="← Back to B2B"
    lang="en"
  />
</Layout>
