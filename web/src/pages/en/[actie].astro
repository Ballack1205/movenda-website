---
import Layout from "../../layouts/Layout.astro";
import ActiePagina from "../../components/ActiePagina.astro";
import { getActiepaginas, localizeActie } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/schema";
import { MPC_HOST, PREVIEW_URL } from "../../lib/site";

export async function getStaticPaths() {
  const briefHost = import.meta.env.PUBLIC_SITE_URL?.replace(/\/+$/, "") === PREVIEW_URL;
  if (MPC_HOST || briefHost) return [];
  const paginas = await getActiepaginas();
  return paginas.map((pagina) => ({ params: { actie: pagina.slug }, props: { pagina } }));
}

const { pagina } = Astro.props;
const path = `/en/${pagina.slug}`;
const shown = localizeActie(pagina, "en");
const description =
  shown.seoDescription || [shown.slogan, shown.intro?.split("\n")[0]].filter(Boolean).join(" ").slice(0, 160);
---

<Layout
  title={shown.seoTitle || `${shown.titel} | Movenda`}
  description={description}
  path={path}
  altPath={`/${pagina.slug}`}
  lang="en"
  jsonLd={[breadcrumbSchema([{ name: "Home", path: "/en" }, { name: shown.titel, path }])]}
  noindex={!pagina.zichtbaarInGoogle}
  ogImage={pagina.foto?.url}
>
  <ActiePagina pagina={pagina} lang="en" />
</Layout>
