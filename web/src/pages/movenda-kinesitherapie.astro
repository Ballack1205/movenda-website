---
import AanbodOverzicht from "../components/AanbodOverzicht.astro";
import Layout from "../layouts/Layout.astro";
import PaginaFoto from "../components/PaginaFoto.astro";
import { getLocatieBySlug, getPagina, paginaAlineas, paginaTekst } from "../lib/content";
import { getBriefAanbod } from "../lib/nav";
import { breadcrumbSchema, localBusinessSchema } from "../lib/schema";
import kineHero from "../assets/marketing/kine-hero.jpg";

const locatie = (await getLocatieBySlug("olympia"))!;
const pagina = await getPagina("kinesitherapie");
const aanbod = (await getBriefAanbod("nl")).find((group) => group.href === "/movenda-kinesitherapie")?.children ?? [];

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Kinesitherapie", path: "/movenda-kinesitherapie" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "Aanbod kinesitherapie | Movenda Hasselt"}
  description={pagina.seoDescription || ""}
  path="/movenda-kinesitherapie"
  altPath="/en/movenda-kinesitherapie"
  jsonLd={jsonLd}
>
  <AanbodOverzicht
    class="page-ink"
    kicker={pagina.ondertitel}
    titel={pagina.titel}
    alineaas={paginaAlineas(pagina)}
    blokken={pagina.blokken}
    aanbodTitel={paginaTekst(pagina, "aanbodTitel") || "Aanbod"}
    aanbod={aanbod}
  >
    <a slot="actions" href={pagina.knopUrl || "/team#keuzehulp"} class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white">
      {paginaTekst(pagina, "knopLabel") || "Plan je afspraak"}
    </a>
    <PaginaFoto
      slot="media"
      pagina={pagina}
      fallback={kineHero}
      alt={pagina.fotoAlt || "Kinesist in Hasselt geeft een manuele behandeling bij Movenda"}
      width={640}
      height={720}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 42vw, 100vw"
      class="aspect-[4/4.5] w-full object-cover"
      priority
    />
  </AanbodOverzicht>
</Layout>
