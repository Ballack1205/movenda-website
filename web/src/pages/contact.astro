---
import Layout from "../layouts/Layout.astro";
import Routebeschrijving from "../components/Routebeschrijving.astro";
import ContactVerwijsVraag from "../components/ContactVerwijsVraag.astro";
import { getLocaties, getPagina, paginaAlineas } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";

const locaties = (await getLocaties()).sort((a, b) =>
  a.slug === "olympia" ? -1 : b.slug === "olympia" ? 1 : 0,
);
const pagina = await getPagina("contact");
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || "https://movenda-contact-api.onrender.com";
const olympia = locaties.find((l) => l.slug === "olympia");
const mapSrc = (adres: string) =>
  `https://maps.google.com/maps?q=${encodeURIComponent(adres)}&z=15&output=embed`;


const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact" },
  ]),
];
import SectionKicker from "../components/SectionKicker.astro";
---

<Layout
  title={pagina.seoTitle || "Contact & afspraak | Movenda Hasselt"}
  description={pagina.seoDescription || ""}
  path="/contact"
  altPath="/en/contact"
  jsonLd={jsonLd}
>
  <section class="grid min-h-[70vh] md:grid-cols-2">
    {locaties.map((locatie) => (
        <div class="flex min-h-[24rem] flex-col border-brand-border md:border-r md:last:border-r-0">
          {locatie.foto && (
            <img
              src={locatie.foto}
              alt={locatie.slug === "mpc" ? "Ingang van Performance Centre aan de Lammerweg" : "Ingang van Movenda aan de Kuringersteenweg"}
              width="1600"
              height="1067"
              class="aspect-[16/10] w-full object-cover object-[center_30%]"
            />
          )}
          <div class="flex flex-1 flex-col justify-end p-8 md:p-12">
          <h2 class="text-3xl font-semibold">{locatie.slug === "mpc" ? "Performance Centre — Lammerweg" : "Movenda — Kuringersteenweg"}</h2>
          <p class="mt-2 text-sm text-brand-muted">{locatie.adres}</p>
          {locatie.urenNote && <p class="mt-1 text-xs text-brand-muted">{locatie.urenNote}</p>}
          <ul class="mt-3 space-y-1 text-sm text-brand-muted">
            {locatie.uren.map((u) => (
              <li class="flex justify-between gap-4">
                <span>{u.dag}</span>
                <span>{u.van}–{u.tot}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-4">
            <p class="text-sm">
              <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="font-semibold text-brand-primary hover:underline">
                {locatie.telefoon}
              </a>
            </p>
            <p class="text-sm">
              <a href={`mailto:${locatie.email}`} class="font-semibold text-brand-primary hover:underline">
                {locatie.email}
              </a>
            </p>
            <p class="mt-3 min-h-[2.5rem] text-xs text-brand-muted">
              BTW {locatie.btw}
              {locatie.iban && <> · IBAN {locatie.iban}</>}
              {locatie.bic && <> · BIC {locatie.bic}</>}
              {locatie.rpr && <> · {locatie.rpr}</>}
            </p>
            {locatie.instagram && (
              <a href={locatie.instagram} class="mt-2 inline-block text-xs font-semibold text-brand-primary hover:underline" target="_blank" rel="noopener">Instagram</a>
            )}
          </div>
          </div>
          <iframe
            title={`Kaart ${locatie.slug === "mpc" ? "Performance Centre" : "Movenda"}`}
            src={mapSrc(locatie.adres)}
            class="h-72 w-full border-0"
            loading="eager"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      ))}
  </section>

  <section class="px-4 py-12 md:px-12">

    {olympia && (
      <Routebeschrijving
        locatie={olympia}
        title="Eerste keer bij Movenda?"
        class="mt-8"
      />
    )}

    <form class="mt-12 grid gap-4" data-contact-form>
      <div class="grid gap-4 sm:grid-cols-2">
        <input class="rounded-lg border border-brand-border px-4 py-3" type="text" name="naam" placeholder="Naam" required />
        <input class="rounded-lg border border-brand-border px-4 py-3" type="email" name="email" placeholder="E-mail" required />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <input class="rounded-lg border border-brand-border px-4 py-3" type="tel" name="telefoon" placeholder="Telefoon" required />
        <select class="rounded-lg border border-brand-border px-4 py-3" name="locatie">
          <option value="">Voor welke vestiging?</option>
          <option value="Movenda — Kuringersteenweg">Movenda — Kuringersteenweg</option>
          <option value="Performance Centre — Lammerweg">Performance Centre — Lammerweg</option>
        </select>
      </div>
      <ContactVerwijsVraag opties={pagina.verwijsopties} />
      <fieldset class="rounded-lg border border-brand-border px-4 py-3">
        <legend class="px-1 text-sm font-semibold">Waarvoor wil je langskomen?</legend>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm">
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="waarvoor" value="Kinesitherapie" /> Kinesitherapie</label>
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="waarvoor" value="Personal Training" /> Personal Training</label>
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="waarvoor" value="Andere" /> Andere</label>
        </div>
      </fieldset>
      <fieldset class="rounded-lg border border-brand-border px-4 py-3">
        <legend class="px-1 text-sm font-semibold">Heb je een voorschrift van je arts?</legend>
        <p class="text-xs text-brand-muted">Enkel van toepassing voor kinesitherapie</p>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm">
          <label class="inline-flex items-center gap-2"><input type="radio" name="voorschrift" value="Ja" /> Ja</label>
          <label class="inline-flex items-center gap-2"><input type="radio" name="voorschrift" value="Nee" /> Nee</label>
          <label class="inline-flex items-center gap-2"><input type="radio" name="voorschrift" value="Niet van toepassing" /> Niet van toepassing</label>
        </div>
      </fieldset>
      <textarea class="rounded-lg border border-brand-border px-4 py-3" name="bericht" rows="5" placeholder="Jouw vraag of bericht" required minlength="5"></textarea>
      <input class="hidden" type="text" name="website" tabindex="-1" autocomplete="off" />
      <button type="submit" class="w-fit rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark">
        Verstuur mijn vraag
      </button>
      <p class="text-sm" data-contact-status role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>

<script define:vars={{ apiUrl: contactApiUrl }} is:inline>
  const form = document.querySelector("[data-contact-form]");
  const status = document.querySelector("[data-contact-status]");
  const locatie = new URLSearchParams(location.search).get("locatie");
  const locatieVeld = form?.querySelector("select[name=locatie]");
  if (locatie && locatieVeld) locatieVeld.value = locatie;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const waarvoor = fd.getAll("waarvoor");
    const data = Object.fromEntries(fd.entries());
    data.waarvoor = waarvoor.join(", ");
    const button = form.querySelector("button[type=submit]");
    button.disabled = true;
    status.textContent = "Verzenden…";
    status.className = "text-sm text-brand-muted";

    try {
      const res = await fetch(`${apiUrl}/api/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("send_failed");
      status.textContent = "Bedankt voor je bericht! We hebben je aanvraag goed ontvangen en nemen zo snel mogelijk contact met je op.";
      status.className = "text-sm font-semibold text-brand-primary";
      window.mvTrack?.("form_submit", { form: "contact" });
      form.reset();
    } catch {
      status.textContent =
        "Er ging iets mis bij het verzenden. Bel of mail ons gerust rechtstreeks — zie de gegevens hierboven.";
      status.className = "text-sm font-semibold text-red-600";
    } finally {
      button.disabled = false;
    }
  });
</script>
