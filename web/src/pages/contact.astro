---
import Layout from "../layouts/Layout.astro";
import { getLocaties } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";

const locaties = (await getLocaties()).sort((a, b) =>
  a.slug === "olympia" ? -1 : b.slug === "olympia" ? 1 : 0,
);
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || "https://movenda-contact-api.onrender.com";
const olympia = locaties.find((l) => l.slug === "olympia");
const mapEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(olympia?.adres || "Kuringersteenweg 242 Hasselt")}&z=15&output=embed`;

const hoeGevonden = [
  "Huisarts",
  "Specialist",
  "Gynaecoloog",
  "Vroedvrouw",
  "Familie",
  "Vrienden",
  "Sportclub trainer of coach",
  "Google / Google Maps",
  "Instagram",
  "Facebook",
  "Een evenement of activiteit van Movenda",
  "Via een andere zorgverlener",
  "Bedrijf / werkgever",
  "Andere",
];

const followUpNaam = ["Huisarts", "Specialist", "Gynaecoloog", "Vroedvrouw", "Via een andere zorgverlener"];

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact" },
  ]),
];
---

<Layout
  title="Contact & afspraak | Movenda Hasselt"
  description="Neem contact op met Movenda (Olympia, Hasselt) of het Movenda Performance Centre (Kuringen) via telefoon, e-mail of het contactformulier."
  path="/contact"
  altPath="/en/contact"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold">Neem contact op</h1>
    <p class="mt-2 max-w-2xl text-brand-muted">
      Heb je een vraag of wil je een afspraak maken? Vul het formulier in en we nemen zo snel
      mogelijk contact met je op. Je kan ons ook rechtstreeks bellen of mailen.
    </p>

    <div class="mt-10 grid items-stretch gap-8 sm:grid-cols-2">
      {locaties.map((locatie) => (
        <div class="flex flex-col rounded-2xl border border-brand-border bg-brand-surface p-6">
          <h2 class="text-lg font-semibold text-brand-primary">{locatie.naam}</h2>
          <p class="mt-2 text-sm text-brand-muted">{locatie.adres}</p>
          {locatie.urenNote && <p class="mt-1 text-xs text-brand-muted">{locatie.urenNote}</p>}
          <ul class="mt-3 space-y-1 text-sm text-brand-muted">
            {locatie.uren.map((u) => (
              <li class="flex justify-between gap-4">
                <span>{u.dag}</span>
                <span>{u.van}–{u.tot}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-4">
            <p class="text-sm">
              <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="font-semibold text-brand-primary hover:underline">
                {locatie.telefoon}
              </a>
            </p>
            <p class="text-sm">
              <a href={`mailto:${locatie.email}`} class="font-semibold text-brand-primary hover:underline">
                {locatie.email}
              </a>
            </p>
            <p class="mt-3 min-h-[2.5rem] text-xs text-brand-muted">
              BTW {locatie.btw}
              {locatie.iban && <> · IBAN {locatie.iban}</>}
              {locatie.bic && <> · BIC {locatie.bic}</>}
              {locatie.rpr && <> · {locatie.rpr}</>}
            </p>
            {locatie.instagram && (
              <a href={locatie.instagram} class="mt-2 inline-block text-xs font-semibold text-brand-primary hover:underline" target="_blank" rel="noopener">Instagram</a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!--
      Click-to-load map: the Google Maps iframe sets Google cookies as soon
      as it loads, which would need consent. Loading it only on an explicit
      click keeps the page cookie-free by default (see /privacy#cookies).
    -->
    {olympia?.mapsUrl && (
      <div
        class="mt-8 flex h-72 flex-col items-center justify-center gap-3 rounded-2xl border border-brand-border bg-brand-surface p-6 text-center"
        data-map
        data-map-src={mapEmbedSrc}
      >
        <svg class="h-8 w-8 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s-6-5.4-6-11a6 6 0 1 1 12 0c0 5.6-6 11-6 11z" />
          <circle cx="12" cy="10" r="2.5" />
        </svg>
        <p class="text-sm font-semibold">{olympia.naam}</p>
        <p class="-mt-2 text-sm text-brand-muted">{olympia.adres}</p>
        <div class="mt-1 flex flex-wrap justify-center gap-2">
          <button
            type="button"
            data-map-load
            class="rounded-full bg-brand-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-primary-dark"
          >
            Kaart tonen
          </button>
          <a
            href={olympia.mapsUrl}
            target="_blank"
            rel="noopener"
            class="rounded-full border border-brand-border px-4 py-2 text-sm font-semibold text-brand-text transition hover:bg-brand-bg"
          >
            Route in Google Maps
          </a>
        </div>
        <p class="text-xs text-brand-muted">De kaart van Google laadt pas na je klik.</p>
      </div>
    )}

    {olympia?.routebeschrijving && (
      <div class="mt-8 rounded-2xl border border-brand-border bg-brand-surface p-6">
        <h2 class="font-semibold">Eerste keer bij Movenda — Olympia?</h2>
        <p class="mt-2 text-sm text-brand-muted">
          {olympia.routebeschrijving}
        </p>
      </div>
    )}

    <form class="mt-12 grid gap-4" data-contact-form>
      <div class="grid gap-4 sm:grid-cols-2">
        <input class="rounded-lg border border-brand-border px-4 py-3" type="text" name="naam" placeholder="Naam" required />
        <input class="rounded-lg border border-brand-border px-4 py-3" type="email" name="email" placeholder="E-mail" required />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <input class="rounded-lg border border-brand-border px-4 py-3" type="tel" name="telefoon" placeholder="Telefoon" required />
        <select class="rounded-lg border border-brand-border px-4 py-3" name="locatie">
          <option value="">Voor welke vestiging?</option>
          <option value="Movenda Olympia">Movenda — Olympia</option>
          <option value="Movenda Performance Centre">Movenda Performance Centre</option>
        </select>
      </div>
      <fieldset class="rounded-lg border border-brand-border px-4 py-3">
        <legend class="px-1 text-sm font-semibold">Waarvoor wil je langskomen?</legend>
        <div class="mt-2 flex flex-wrap gap-4 text-sm">
          <label><input type="checkbox" name="waarvoor" value="Kinesitherapie" /> Kinesitherapie</label>
          <label><input type="checkbox" name="waarvoor" value="Personal Training" /> Personal Training</label>
          <label><input type="checkbox" name="waarvoor" value="Andere" /> Andere</label>
        </div>
      </fieldset>
      <fieldset class="rounded-lg border border-brand-border px-4 py-3">
        <legend class="px-1 text-sm font-semibold">Heb je een voorschrift van je arts?</legend>
        <p class="text-xs text-brand-muted">Enkel van toepassing voor kinesitherapie</p>
        <div class="mt-2 flex flex-wrap gap-4 text-sm">
          <label><input type="radio" name="voorschrift" value="Ja" /> Ja</label>
          <label><input type="radio" name="voorschrift" value="Nee" /> Nee</label>
          <label><input type="radio" name="voorschrift" value="Niet van toepassing" /> Niet van toepassing</label>
        </div>
      </fieldset>
      <label class="text-sm">
        <span class="font-semibold">Hoe ben je bij ons terechtgekomen?</span>
        <select class="mt-1 w-full rounded-lg border border-brand-border px-4 py-3" name="hoeGevonden" data-hoe>
          <option value="">Kies wat het best past</option>
          {hoeGevonden.map((opt) => (
            <option value={opt}>{opt}</option>
          ))}
        </select>
      </label>
      <input class="hidden rounded-lg border border-brand-border px-4 py-3" type="text" name="hoeGevondenDetail" data-hoe-detail placeholder="Naam / extra info" />
      <textarea class="hidden rounded-lg border border-brand-border px-4 py-3" name="clubNaam" rows="2" data-club placeholder="Naam van de club"></textarea>
      <input class="hidden rounded-lg border border-brand-border px-4 py-3" type="text" name="eventNaam" data-event placeholder="Welk event?" />
      <textarea class="rounded-lg border border-brand-border px-4 py-3" name="bericht" rows="5" placeholder="Jouw vraag of bericht" required minlength="5"></textarea>
      <input class="hidden" type="text" name="website" tabindex="-1" autocomplete="off" />
      <button type="submit" class="w-fit rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark">
        Verstuur mijn vraag
      </button>
      <p class="text-sm" data-contact-status role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>

<script define:vars={{ apiUrl: contactApiUrl, followUpNaam }} is:inline>
  const form = document.querySelector("[data-contact-form]");
  const status = document.querySelector("[data-contact-status]");
  const hoe = document.querySelector("[data-hoe]");
  const detail = document.querySelector("[data-hoe-detail]");
  const club = document.querySelector("[data-club]");
  const eventField = document.querySelector("[data-event]");

  // Click-to-load Google Maps (see comment on the [data-map] element).
  const mapBox = document.querySelector("[data-map]");
  mapBox?.querySelector("[data-map-load]")?.addEventListener("click", () => {
    const iframe = document.createElement("iframe");
    iframe.title = "Kaart Movenda Olympia";
    iframe.src = mapBox.dataset.mapSrc;
    iframe.className = "h-72 w-full";
    iframe.setAttribute("loading", "lazy");
    iframe.setAttribute("referrerpolicy", "no-referrer-when-downgrade");
    mapBox.replaceChildren(iframe);
    mapBox.className = "mt-8 h-72 overflow-hidden rounded-2xl border border-brand-border";
    window.mvTrack?.("map_load");
  });

  hoe?.addEventListener("change", () => {
    const v = hoe.value;
    detail.classList.toggle("hidden", !followUpNaam.includes(v) && v !== "Andere");
    club.classList.toggle("hidden", v !== "Sportclub trainer of coach");
    eventField.classList.toggle("hidden", v !== "Een evenement of activiteit van Movenda");
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const waarvoor = fd.getAll("waarvoor");
    const data = Object.fromEntries(fd.entries());
    data.waarvoor = waarvoor.join(", ");
    const button = form.querySelector("button[type=submit]");
    button.disabled = true;
    status.textContent = "Verzenden…";
    status.className = "text-sm text-brand-muted";

    try {
      const res = await fetch(`${apiUrl}/api/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("send_failed");
      status.textContent = "Bedankt voor je bericht! We hebben je aanvraag goed ontvangen en nemen zo snel mogelijk contact met je op.";
      status.className = "text-sm font-semibold text-brand-primary";
      window.mvTrack?.("form_submit", { form: "contact" });
      form.reset();
    } catch {
      status.textContent =
        "Er ging iets mis bij het verzenden. Bel of mail ons gerust rechtstreeks — zie de gegevens hierboven.";
      status.className = "text-sm font-semibold text-red-600";
    } finally {
      button.disabled = false;
    }
  });
</script>
