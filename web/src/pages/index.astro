---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import GoogleReviewBadge from "../components/GoogleReviewBadge.astro";
import BookingButton from "../components/BookingButton.astro";
import PartnerBand from "../components/PartnerBand.astro";
import NewsletterBlock from "../components/NewsletterBlock.astro";
import GetuigenisQuote from "../components/GetuigenisQuote.astro";
import {
  getLocaties,
  getTeamleden,
  getSiteSettings,
  getDienstenByCategorie,
  getPartners,
  getGetuigenissen,
  dienstHref,
} from "../lib/content";
import { teamPhotoSrc } from "../lib/images";
import { organizationSchema, localBusinessSchema } from "../lib/schema";
import homeHero from "../assets/marketing/home-hero.jpg";
import mpcHero from "../assets/marketing/mpc-hero.jpg";

const locaties = await getLocaties();
const olympia = locaties.find((l) => l.slug === "olympia")!;
const mpc = locaties.find((l) => l.slug === "mpc")!;
const team = await getTeamleden();
const settings = await getSiteSettings();
const kine = await getDienstenByCategorie("kine");
const training = await getDienstenByCategorie("training");
const mpcDiensten = await getDienstenByCategorie("mpc");
const partners = await getPartners("movenda");
const getuigenissen = await getGetuigenissen();
const homeQuote = getuigenissen[0];

const kinesistenCount = team.filter((t) => t.rol.toLowerCase().includes("kinesitherapeut")).length;
const trainerCount = team.filter(
  (t) => t.rol.toLowerCase().includes("trainer") || t.rol.toLowerCase().includes("coach"),
).length;

const jsonLd = [organizationSchema(), localBusinessSchema(olympia), localBusinessSchema(mpc)];
---

<Layout
  title="Movenda Hasselt: kinesitherapie, personal training & performance"
  description="Movenda is dé groepspraktijk kinesitherapie en personal training in Hasselt, met een tweede vestiging Movenda Performance Centre in Kuringen."
  path="/"
  altPath="/en"
  jsonLd={jsonLd}
>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 lg:grid-cols-2 lg:py-16">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-primary">
        Kinesitherapie · Personal training · Performance
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Bewegen, herstellen en presteren in Hasselt
      </h1>
      <p class="mt-4 max-w-xl text-lg text-brand-muted">
        Sportpraktijk Movenda is dé plaats voor kinesitherapie en personal training in Hasselt. Met
        een team van {kinesistenCount} kinesisten en {trainerCount} personal trainers begeleiden we
        jou bij herstel, blessurepreventie en een gezonde, actieve levensstijl — medisch verantwoord
        en volledig op maat.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-2 text-sm font-semibold text-brand-muted">
        <span>{kinesistenCount} Kinesisten</span>
        <span>{trainerCount} Personal trainers</span>
        <span>{locaties.length} Vestigingen</span>
        <span>10+ Jaar ervaring</span>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`tel:${settings.telefoonOlympia.replace(/\s+/g, "")}`}
          class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark"
        >
          Bel {settings.telefoonOlympia}
        </a>
        <a
          href="/contact"
          class="rounded-full border border-brand-border px-6 py-3 font-semibold text-brand-text transition hover:border-brand-primary"
        >
          Contacteer ons
        </a>
        <BookingButton />
      </div>
      <div class="mt-6">
        <GoogleReviewBadge locatie="olympia" />
      </div>
    </div>
    <div class="relative">
      <Image
        src={homeHero}
        alt="Personal trainer en klant tijdens een training bij Movenda"
        width={640}
        height={800}
        class="aspect-[4/5] w-full rounded-3xl object-cover shadow-xl"
        priority
      />
    </div>
  </section>

  {settings.slogans.home && (
    <p class="bg-brand-header py-6 text-center text-lg font-semibold text-white sm:text-xl">
      {settings.slogans.home}
    </p>
  )}

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-2xl font-bold">Kinesitherapie</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {kine.map((dienst) => (
        <a
          href={dienstHref(dienst)}
          class="rounded-full border border-brand-border bg-brand-surface px-4 py-1.5 text-sm text-brand-text transition hover:border-brand-primary"
        >
          {dienst.titel.replace(/ Hasselt$/, "")}
        </a>
      ))}
    </div>

    <h2 class="mt-10 text-2xl font-bold">Training</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {training.map((dienst) => (
        <a
          href={dienstHref(dienst)}
          class="rounded-full border border-brand-border bg-brand-surface px-4 py-1.5 text-sm text-brand-text transition hover:border-brand-primary"
        >
          {dienst.titel.replace(/ Hasselt$/, "")}
        </a>
      ))}
    </div>

    <h2 class="mt-10 text-2xl font-bold">Movenda Performance Centre</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {mpcDiensten.map((dienst) => (
        <a
          href={dienstHref(dienst)}
          class="rounded-full border border-brand-border bg-brand-surface px-4 py-1.5 text-sm text-brand-text transition hover:border-brand-primary"
        >
          {dienst.titel}
        </a>
      ))}
    </div>
  </section>

  <PartnerBand
    partners={partners}
    title={settings.partnerband.titel}
    snelheid={settings.partnerband.snelheid}
    animatie={settings.partnerband.animatie}
  />

  <section class="mx-auto grid max-w-6xl gap-6 px-4 py-16 sm:grid-cols-2">
    <a
      href="/locaties/olympia"
      class="group rounded-2xl border border-brand-border bg-brand-surface p-8 transition hover:border-brand-primary"
    >
      <h2 class="text-2xl font-bold text-brand-primary">Movenda — Olympia</h2>
      <p class="mt-2 text-brand-muted">
        Kinesitherapie en personal training in Sportcentrum Olympia, Hasselt. Manuele therapie,
        dry needling, acupunctuur, sportspecifieke training en meer.
      </p>
      <span class="mt-4 inline-block font-semibold text-brand-primary group-hover:underline">
        Bekijk de vestiging →
      </span>
    </a>
    <a
      href="/mpc"
      class="group relative overflow-hidden rounded-2xl p-8 text-white transition hover:opacity-95"
    >
      <Image
        src={mpcHero}
        alt=""
        width={640}
        height={480}
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-brand-header/80"></div>
      <div class="relative">
        <h2 class="text-2xl font-bold text-white">Movenda Performance Centre</h2>
        <p class="mt-2 text-white/80">
          Performance training en sportrevalidatie in Kuringen, data-gedreven en één-op-één, voor
          recreatieve en professionele sporters.
        </p>
        <span class="mt-4 inline-block font-semibold text-white group-hover:underline">
          Bekijk MPC →
        </span>
      </div>
    </a>
  </section>

  <section class="bg-brand-surface py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-2xl font-bold">Ons team</h2>
      <p class="mt-2 max-w-2xl text-brand-muted">
        {team.length} kinesisten, personal trainers en performance coaches — elk met hun eigen
        specialisatie.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        {team.slice(0, 8).map((lid) => (
          <a href={`/team/${lid.slug}`} class="group w-24 text-center">
            <div class="aspect-[2/3] w-full overflow-hidden rounded-xl bg-brand-header">
              {lid.foto ? (
                <img
                  src={teamPhotoSrc(lid.foto, "card")}
                  alt={`${lid.voornaam} ${lid.naam}`}
                  width="96"
                  height="144"
                  loading="lazy"
                  class="h-full w-full object-cover object-top transition group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-lg font-bold text-white/80">
                  {lid.voornaam[0]}{lid.naam[0]}
                </div>
              )}
            </div>
            <p class="mt-2 text-xs font-medium text-brand-text">{lid.voornaam}</p>
          </a>
        ))}
      </div>
      <a href="/team" class="mt-6 inline-block font-semibold text-brand-primary hover:underline">
        Bekijk het volledige team →
      </a>
    </div>
  </section>

  {homeQuote && <GetuigenisQuote item={homeQuote} />}

  <NewsletterBlock settings={settings} />
</Layout>
