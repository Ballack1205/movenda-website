---
import AanbodOverzicht from "../components/AanbodOverzicht.astro";
import Layout from "../layouts/Layout.astro";
import GoogleReviewBadge from "../components/GoogleReviewBadge.astro";
import PaginaFoto from "../components/PaginaFoto.astro";
import { getLocatieBySlug, getPagina, paginaAlineas } from "../lib/content";
import { getBriefAanbod } from "../lib/nav";
import { breadcrumbSchema, localBusinessSchema } from "../lib/schema";
import kineHero from "../assets/marketing/kine-hero.jpg";

const locatie = (await getLocatieBySlug("olympia"))!;
const pagina = await getPagina("kinesitherapie");
const aanbod = (await getBriefAanbod("nl")).find((group) => group.href === "/kinesitherapie")?.children ?? [];

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Kinesitherapie", path: "/kinesitherapie" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "Kinesitherapie Hasselt | Movenda"}
  description={pagina.seoDescription || ""}
  path="/kinesitherapie"
  altPath="/en/kinesitherapie"
  jsonLd={jsonLd}
>
  <AanbodOverzicht
    class="kine-page"
    kicker={pagina.ondertitel}
    titel={pagina.titel}
    alineaas={paginaAlineas(pagina)}
    blokken={pagina.blokken}
    aanbodTitel="Aanbod"
    aanbod={aanbod}
  >
    <a slot="actions" href="/team#keuzehulp" class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white">
      Plan je afspraak
    </a>
    <GoogleReviewBadge slot="actions" locatie="olympia" />
    <PaginaFoto
      slot="media"
      pagina={pagina}
      fallback={kineHero}
      alt={pagina.fotoAlt || "Begeleiding bij Movenda"}
      width={640}
      height={720}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 42vw, 100vw"
      class="aspect-[4/4.5] w-full object-cover"
      priority
    />
  </AanbodOverzicht>
</Layout>
