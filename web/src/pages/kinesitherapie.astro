---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import GoogleReviewBadge from "../components/GoogleReviewBadge.astro";
import DienstCard from "../components/DienstCard.astro";
import { getDienstenByCategorie, getLocatieBySlug, getSiteSettings } from "../lib/content";
import { breadcrumbSchema, localBusinessSchema } from "../lib/schema";
import kineHero from "../assets/marketing/kine-hero.jpg";
import kineSecondary from "../assets/marketing/kine-secondary.jpg";

const locatie = (await getLocatieBySlug("olympia"))!;
const diensten = await getDienstenByCategorie("kine");
const settings = await getSiteSettings();

const klachten = [
  "Rug- en nekklachten",
  "Sportblessures & sportrevalidatie",
  "Postoperatieve revalidatie",
  "Pre- en postnatale klachten",
  "Cardiovasculaire revalidatie",
  "Chronische pijn",
];

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Kinesitherapie", path: "/kinesitherapie" },
  ]),
];
---

<Layout
  title="Kinesitherapie Hasselt | Movenda"
  description="Team van ervaren kinesisten in Hasselt: manuele therapie, dry needling, acupunctuur, pre- en postnatale kinesitherapie en meer."
  path="/kinesitherapie"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h1 class="text-3xl font-bold">Kinesitherapie Hasselt</h1>
        {settings.slogans.kine && (
          <p class="mt-2 text-lg font-medium text-brand-primary">{settings.slogans.kine}</p>
        )}
        <p class="mt-3 max-w-xl text-brand-muted">
          Bij Movenda in Hasselt vind je een team van ervaren kinesisten die je begeleiden bij
          uiteenlopende spier- en gewrichtsklachten. Of je nu last hebt van rugpijn, herstelt na
          een blessure of een operatie, of gewoon pijnvrij wil bewegen — onze kinesitherapeuten
          stellen een behandeling op maat voor jou op.
        </p>
        <p class="mt-3 max-w-xl text-brand-muted">
          Wij combineren klassieke kinesitherapie met de nieuwste technieken en inzichten. Elke
          behandeling duurt 30 minuten één-op-één, waarna je extra tijd krijgt om je oefeningen
          zelfstandig verder te zetten. Zo werk jij actief mee aan je eigen herstel.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`}
            class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark"
          >
            Bel {locatie.telefoon}
          </a>
          <GoogleReviewBadge locatie="olympia" />
        </div>
      </div>
      <Image
        src={kineHero}
        alt="Manuele therapie behandeling bij Movenda"
        width={640}
        height={720}
        class="aspect-[4/4.5] w-full rounded-3xl object-cover shadow-xl"
        priority
      />
    </div>

    <h2 class="mt-12 text-xl font-bold">Klachten die we behandelen</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {klachten.map((k) => (
        <span class="rounded-full border border-brand-border bg-brand-surface px-4 py-1.5 text-sm text-brand-text">
          {k}
        </span>
      ))}
    </div>

    <h2 class="mt-10 text-xl font-bold">Onze behandeltechnieken</h2>
    <div class="mt-4 grid gap-6 lg:grid-cols-3">
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-2">
        {diensten.map((dienst) => (
          <DienstCard dienst={dienst} />
        ))}
      </div>
      <Image
        src={kineSecondary}
        alt="Taping en verzorging bij Movenda"
        width={480}
        height={640}
        class="aspect-[16/10] w-full rounded-2xl object-cover lg:aspect-[3/4]"
      />
    </div>

    <p class="mt-8 text-sm text-brand-muted">
      Wij werken enkel op afspraak vanuit onze praktijk in Sportcentrum Olympia,{" "}
      {locatie.adres}.
    </p>
  </section>
</Layout>
