---
import Layout from "../layouts/Layout.astro";
import {
  getDiensten,
  getSiteSettings,
  getTeamleden,
  formatEuro,
  dienstMenuLabel,
  type Dienst,
  type Teamlid,
} from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";

const settings = await getSiteSettings();
const info = settings.prijzenInfo;
const team = await getTeamleden();
const diensten = await getDiensten();

const aanbod: { slug: string; categorie: Dienst["categorie"] }[] = [
  { slug: "manuele-therapie", categorie: "kine" },
  { slug: "oefentherapie", categorie: "kine" },
  { slug: "algemene-kinesitherapie", categorie: "kine" },
  { slug: "sportrevalidatie", categorie: "mpc-rehab" },
  { slug: "pre-en-postnatale-kinesitherapie", categorie: "kine" },
  { slug: "bekkenbodemtherapie", categorie: "kine" },
  { slug: "lymfedrainage", categorie: "kine" },
  { slug: "acupunctuur", categorie: "kine" },
  { slug: "dry-needling", categorie: "kine" },
  { slug: "cupping", categorie: "kine" },
  { slug: "auriculotherapie", categorie: "kine" },
  { slug: "cardiovasculaire-revalidatie", categorie: "kine" },
  { slug: "taping", categorie: "kine" },
  { slug: "barefoot", categorie: "kine" },
  { slug: "performance-training", categorie: "mpc-training" },
  { slug: "personal-training", categorie: "mpc-training" },
  { slug: "personal-training", categorie: "training" },
  { slug: "duotraining", categorie: "mpc-training" },
  { slug: "duotraining", categorie: "training" },
];

function tariefFor(dienst: Dienst, lid: Teamlid): string | undefined {
  if (dienst.categorie === "kine") return formatEuro(lid.tariefKine);
  if (dienst.categorie === "training") return formatEuro(lid.tariefPt);
  return formatEuro(lid.tariefPerformance || lid.tariefPtMpc);
}

const rubrieken = aanbod.flatMap((pick) => {
  const dienst = diensten.find((d) => d.slug === pick.slug && d.categorie === pick.categorie);
  if (!dienst || dienst.toonInMenu === false) return [];
  const matched = team.filter((lid) =>
    lid.specialisaties.some((s) => s.dienst?.slug === dienst.slug && s.dienst.categorie === dienst.categorie),
  );
  const mensen = matched.filter((lid) => tariefFor(dienst, lid));
  return [{ dienst, mensen }];
});

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Prijzen", path: "/prijzen" },
  ]),
];
import SectionKicker from "../components/SectionKicker.astro";
---

<Layout
  title="Tarieven kinesitherapie & personal training | Movenda"
  description="Overzicht van de tarieven voor kinesitherapie en personal training bij Movenda Hasselt, en hoeveel je terugkrijgt van je ziekenfonds."
  path="/prijzen"
  altPath="/en/prijzen"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <SectionKicker n={1} />
        <h1 class="text-3xl font-bold">Tarieven &amp; terugbetaling</h1>
    {info.intro && <p class="mt-3 max-w-2xl text-brand-muted">{info.intro}</p>}
    {info.basishonorarium && (
      <p class="mt-2 max-w-2xl text-brand-muted">
        Ons basishonorarium is <strong>€{info.basishonorarium}</strong>. Het exacte tarief hangt
        af van de behandelende therapeut, specialisatie en ervaring.
      </p>
    )}
    <div class="mt-8 rounded-2xl border border-brand-border bg-brand-surface p-6">
      <h2 class="text-xl font-semibold">Terugbetaling</h2>
      <p class="mt-2 text-sm text-brand-muted">
        Je ontvangt na elke sessie een getuigschrift voor verstrekte hulp. Daarmee vraag je zelf
        een terugbetaling aan bij je ziekenfonds (via de app of op kantoor).
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {info.terugbetalingStandaard && (
          <div>
            <p class="text-sm font-semibold">Standaard verzekerde</p>
            <p class="text-sm text-brand-muted">{info.terugbetalingStandaard}</p>
          </div>
        )}
        {info.terugbetalingVt && (
          <div>
            <p class="text-sm font-semibold">Verhoogde tegemoetkoming (VT/BIM)</p>
            <p class="text-sm text-brand-muted">{info.terugbetalingVt}</p>
          </div>
        )}
      </div>
      {info.nomenclatuur && info.nomenclatuur.length > 0 && (
        <div class="mt-6 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="text-brand-muted">
              <tr>
                <th class="py-2 pr-4 font-medium">Categorie</th>
                <th class="py-2 pr-4 font-medium">Omschrijving</th>
                <th class="py-2 text-right font-medium">Ereloon</th>
              </tr>
            </thead>
            <tbody>
              {info.nomenclatuur.map((n) => (
                <tr class="border-t border-brand-border">
                  <td class="py-2 pr-4">{n.categorie}</td>
                  <td class="py-2 pr-4">{n.omschrijving}</td>
                  <td class="py-2 text-right">{n.bedrag}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {info.voorwaarden && <p class="mt-4 text-xs text-brand-muted">{info.voorwaarden}</p>}
      {info.annulatiebeleid && (
        <p class="mt-4 text-sm text-brand-muted"><strong>Annulatie:</strong> {info.annulatiebeleid}</p>
      )}
    </div>

    <div class="mt-12 space-y-10">
      {rubrieken.map(({ dienst, mensen }) => (
        <section>
          <h2 class="text-xl font-semibold">{dienstMenuLabel(dienst)}</h2>
          {mensen.length > 0 ? (
            <div class="mt-3 divide-y divide-brand-border border-y border-brand-border">
              {mensen.map((lid) => (
                <details class="group">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2 text-sm [&::-webkit-details-marker]:hidden">
                    <span>{lid.voornaam} {lid.naam}</span>
                    <span class="text-brand-muted" aria-hidden="true">+</span>
                  </summary>
                  <p class="pb-3 text-sm text-brand-muted">
                    {dienst.categorie === "kine" ? "Hasselt" : dienst.categorie === "training" ? "Hasselt" : "Performance Centre"}
                    {" "}
                    <span class="font-medium text-brand-text">{tariefFor(dienst, lid)}</span>
                  </p>
                </details>
              ))}
            </div>
          ) : (
            <p class="mt-2 text-sm text-brand-muted">Tarief op aanvraag bij de therapeut.</p>
          )}
        </section>
      ))}
    </div>
  </section>
</Layout>
