---
import Layout from "../layouts/Layout.astro";
import GetuigenisCarousel from "../components/GetuigenisCarousel.astro";
import {
  getPrijzenByCategorie,
  getSiteSettings,
  getTeamleden,
  getGetuigenissen,
  formatPrijs,
  formatEuro,
} from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";

const kine = await getPrijzenByCategorie("kine");
const training = await getPrijzenByCategorie("training");
const settings = await getSiteSettings();
const info = settings.prijzenInfo;
const team = await getTeamleden();
const getuigenissen = await getGetuigenissen("olympia");

const kineTarieven = team.filter((t) => t.tariefKine);
const ptTarieven = team.filter((t) => t.tariefPt || t.tariefPtMpc || t.tariefPerformance);

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Prijzen", path: "/prijzen" },
  ]),
];
---

<Layout
  title="Tarieven kinesitherapie & personal training | Movenda"
  description="Overzicht van de tarieven voor kinesitherapie en personal training bij Movenda Hasselt, en hoeveel je terugkrijgt van je ziekenfonds."
  path="/prijzen"
  altPath="/en/prijzen"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold">Tarieven &amp; terugbetaling</h1>
    {info.intro && <p class="mt-3 max-w-2xl text-brand-muted">{info.intro}</p>}
    {info.basishonorarium && (
      <p class="mt-2 max-w-2xl text-brand-muted">
        Ons basishonorarium is <strong>€{info.basishonorarium}</strong>. Het exacte tarief hangt
        af van de behandelende therapeut, specialisatie en ervaring.
      </p>
    )}
    {settings.slogans.prijzenKine && (
      <p class="mt-4 text-lg font-semibold text-brand-primary">{settings.slogans.prijzenKine}</p>
    )}

    {kineTarieven.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Tarieven per therapeut — kinesitherapie</h2>
        <div class="mt-4 overflow-hidden rounded-2xl border border-brand-border">
          <table class="w-full text-left text-sm">
            <tbody>
              {kineTarieven.map((lid, i) => (
                <tr class={i % 2 === 0 ? "bg-brand-surface" : ""}>
                  <td class="px-4 py-3">
                    <a href={`/team/${lid.slug}`} class="font-medium hover:text-brand-primary">{lid.voornaam} {lid.naam}</a>
                    <span class="text-brand-muted"> — {lid.rol}</span>
                  </td>
                  <td class="px-4 py-3 text-right font-semibold text-brand-primary">{formatEuro(lid.tariefKine)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {kine.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Kinesitherapie — behandelingen</h2>
        <div class="mt-4 overflow-hidden rounded-2xl border border-brand-border">
          <table class="w-full text-left text-sm">
            <tbody>
              {kine.map((item, i) => (
                <tr class={i % 2 === 0 ? "bg-brand-surface" : ""}>
                  <td class="px-4 py-3">{item.naam}</td>
                  <td class="px-4 py-3 text-right font-semibold text-brand-primary">{formatPrijs(item)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {info.nomenclatuur && info.nomenclatuur.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Nomenclatuur</h2>
        <div class="mt-4 overflow-hidden rounded-2xl border border-brand-border">
          <table class="w-full text-left text-sm">
            <thead class="bg-brand-surface text-brand-muted">
              <tr>
                <th class="px-4 py-2 font-medium">Categorie</th>
                <th class="px-4 py-2 font-medium">Omschrijving</th>
                <th class="px-4 py-2 text-right font-medium">Ereloon</th>
              </tr>
            </thead>
            <tbody>
              {info.nomenclatuur.map((n) => (
                <tr class="border-t border-brand-border">
                  <td class="px-4 py-2">{n.categorie}</td>
                  <td class="px-4 py-2">{n.omschrijving}</td>
                  <td class="px-4 py-2 text-right font-semibold">{n.bedrag}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {settings.slogans.prijzenPt && (
      <p class="mt-12 text-lg font-semibold text-brand-primary">{settings.slogans.prijzenPt}</p>
    )}

    {ptTarieven.length > 0 && (
      <div class="mt-6">
        <h2 class="text-xl font-semibold">Tarieven per therapeut — training</h2>
        <div class="mt-4 overflow-hidden rounded-2xl border border-brand-border">
          <table class="w-full text-left text-sm">
            <thead class="bg-brand-surface text-brand-muted">
              <tr>
                <th class="px-4 py-2 font-medium">Therapeut</th>
                <th class="px-4 py-2 text-right font-medium">Olympia</th>
                <th class="px-4 py-2 text-right font-medium">MPC</th>
              </tr>
            </thead>
            <tbody>
              {ptTarieven.map((lid) => (
                <tr class="border-t border-brand-border">
                  <td class="px-4 py-3">
                    <a href={`/team/${lid.slug}`} class="font-medium hover:text-brand-primary">{lid.voornaam} {lid.naam}</a>
                  </td>
                  <td class="px-4 py-3 text-right font-semibold text-brand-primary">{formatEuro(lid.tariefPt) || "—"}</td>
                  <td class="px-4 py-3 text-right font-semibold text-brand-primary">
                    {formatEuro(lid.tariefPerformance || lid.tariefPtMpc) || "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {training.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Personal Training — Olympia</h2>
        <div class="mt-4 overflow-hidden rounded-2xl border border-brand-border">
          <table class="w-full text-left text-sm">
            <tbody>
              {training.map((item, i) => (
                <tr class={i % 2 === 0 ? "bg-brand-surface" : ""}>
                  <td class="px-4 py-3">
                    {item.naam}
                    {item.notitie && <span class="block text-xs text-brand-muted">{item.notitie}</span>}
                  </td>
                  <td class="px-4 py-3 text-right font-semibold text-brand-primary">{formatPrijs(item)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <div id="mpc" class="mt-12 scroll-mt-24 rounded-2xl border border-brand-border bg-brand-surface p-6">
      <h2 class="text-xl font-semibold">Movenda Performance Centre</h2>
      <p class="mt-2 text-sm text-brand-muted">
        Training, sportrevalidatie en groepslessen in Kuringen. Prijzen exclusief BTW, enkel op
        afspraak.
      </p>
      <a href="/mpc/prijzen" class="mt-4 inline-block font-semibold text-brand-primary hover:underline">
        Bekijk de MPC-tarieven →
      </a>
    </div>

    <div class="mt-12 rounded-2xl border border-brand-border bg-brand-surface p-6">
      <h2 class="text-xl font-semibold">Terugbetaling</h2>
      <p class="mt-2 text-sm text-brand-muted">
        Je ontvangt na elke sessie een getuigschrift voor verstrekte hulp. Daarmee vraag je zelf
        een terugbetaling aan bij je ziekenfonds (via de app of op kantoor).
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {info.terugbetalingStandaard && (
          <div>
            <p class="text-sm font-semibold">Standaard verzekerde</p>
            <p class="text-sm text-brand-muted">{info.terugbetalingStandaard}</p>
          </div>
        )}
        {info.terugbetalingVt && (
          <div>
            <p class="text-sm font-semibold">Verhoogde tegemoetkoming (VT/BIM)</p>
            <p class="text-sm text-brand-muted">{info.terugbetalingVt}</p>
          </div>
        )}
      </div>
      {info.voorwaarden && <p class="mt-4 text-xs text-brand-muted">{info.voorwaarden}</p>}
      {info.annulatiebeleid && (
        <p class="mt-4 text-sm text-brand-muted"><strong>Annulatie:</strong> {info.annulatiebeleid}</p>
      )}
    </div>
  </section>

  <GetuigenisCarousel items={getuigenissen} />
</Layout>
