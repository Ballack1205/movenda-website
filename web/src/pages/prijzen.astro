---
import Layout from "../layouts/Layout.astro";
import {
  getPrijzenByCategorie,
  getSiteSettings,
  getTeamleden,
  prijsNaam,
  type Prijsitem,
  type Teamlid,
} from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";

const settings = await getSiteSettings();
const info = settings.prijzenInfo;
const team = await getTeamleden();
const kine = await getPrijzenByCategorie("kine");
const training = await getPrijzenByCategorie("training");

const byNaam = (a: Teamlid, b: Teamlid) =>
  a.naam.localeCompare(b.naam, "nl") || a.voornaam.localeCompare(b.voornaam, "nl");
const kineTeam = team.filter((lid) => lid.tariefKine).sort(byNaam);
const ptTeam = team.filter((lid) => lid.tariefPt).sort(byNaam);

function startprijs(item: Prijsitem): string {
  if (item.opAanvraag) return "Op aanvraag";
  return item.vanaf ? `Vanaf €${item.bedrag}` : `€${item.bedrag}`;
}

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Prijzen", path: "/prijzen" },
  ]),
];
---

<Layout
  title="Tarieven kinesitherapie & personal training | Movenda"
  description="Overzicht van de tarieven voor kinesitherapie en personal training bij Movenda Hasselt, en hoeveel je terugkrijgt van je ziekenfonds."
  path="/prijzen"
  altPath="/en/prijzen"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 pb-16 pt-8">
    <h1>Tarieven &amp; terugbetaling</h1>
    {info.intro && <p class="mt-4 max-w-2xl text-brand-muted">{info.intro}</p>}
    {info.basishonorarium && (
      <p class="mt-3 max-w-2xl text-brand-muted">
        Ons basishonorarium is <strong>€{info.basishonorarium}</strong>. Het exacte tarief hangt
        af van de behandelende therapeut, specialisatie en ervaring.
      </p>
    )}

    {kine.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Kinesitherapie</h2>
        <ul class="mt-3 border-t border-brand-border">
          {kine.map((item) => (
            <li class="flex items-baseline justify-between gap-6 border-b border-brand-border py-3">
              <span>{prijsNaam(item)}</span>
              <span class="shrink-0 font-semibold">{startprijs(item)}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {training.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Personal training</h2>
        <ul class="mt-3 border-t border-brand-border">
          {training.map((item) => (
            <li class="flex items-baseline justify-between gap-6 border-b border-brand-border py-3">
              <span>
                {prijsNaam(item)}
                {item.notitie && <span class="mt-0.5 block text-sm text-brand-muted">{item.notitie}</span>}
              </span>
              <span class="shrink-0 font-semibold">{startprijs(item)}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="mt-8 text-sm text-brand-muted">
      Tarieven van het Performance Centre staan op de{" "}
      <a href="/mpc/prijzen" class="underline underline-offset-4">prijzenpagina van het centre</a>.
    </p>

    <div class="mt-12 border-t border-brand-border pt-8">
      <h2 class="text-xl font-semibold">Terugbetaling</h2>
      <p class="mt-2 text-sm text-brand-muted">
        Je ontvangt na elke sessie een getuigschrift voor verstrekte hulp. Daarmee vraag je zelf
        een terugbetaling aan bij je ziekenfonds (via de app of op kantoor).
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {info.terugbetalingStandaard && (
          <div>
            <p class="text-sm font-semibold">Standaard verzekerde</p>
            <p class="text-sm text-brand-muted">{info.terugbetalingStandaard}</p>
          </div>
        )}
        {info.terugbetalingVt && (
          <div>
            <p class="text-sm font-semibold">Verhoogde tegemoetkoming (VT/BIM)</p>
            <p class="text-sm text-brand-muted">{info.terugbetalingVt}</p>
          </div>
        )}
      </div>
      {info.voorwaarden && <p class="mt-4 text-xs text-brand-muted">{info.voorwaarden}</p>}
      {info.annulatiebeleid && (
        <p class="mt-4 text-sm text-brand-muted"><strong>Annulatie:</strong> {info.annulatiebeleid}</p>
      )}
    </div>

    {(kineTeam.length > 0 || ptTeam.length > 0) && (
      <div class="mt-14">
        <h2 class="text-xl font-semibold">Tarieven per therapeut</h2>
        <p class="mt-2 text-sm text-brand-muted">Het bedrag van jouw sessie hangt af van wie je behandelt.</p>

        {kineTeam.length > 0 && (
          <div class="mt-8">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">Kinesitherapie</h3>
            <div class="mt-2 divide-y divide-brand-border border-y border-brand-border">
              {kineTeam.map((lid) => (
                <details class="group">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2 text-sm [&::-webkit-details-marker]:hidden">
                    <span>{lid.voornaam} {lid.naam}</span>
                    <span class="text-brand-muted" aria-hidden="true">+</span>
                  </summary>
                  <p class="pb-3 text-sm">
                    <span class="font-medium">€{lid.tariefKine} / 30 min</span>
                  </p>
                </details>
              ))}
            </div>
          </div>
        )}

        {ptTeam.length > 0 && (
          <div class="mt-8">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">Personal training</h3>
            <div class="mt-2 divide-y divide-brand-border border-y border-brand-border">
              {ptTeam.map((lid) => (
                <details class="group">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2 text-sm [&::-webkit-details-marker]:hidden">
                    <span>{lid.voornaam} {lid.naam}</span>
                    <span class="text-brand-muted" aria-hidden="true">+</span>
                  </summary>
                  <p class="pb-3 text-sm">
                    <span class="font-medium">€{lid.tariefPt} / 60 min</span>
                  </p>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </section>
</Layout>
