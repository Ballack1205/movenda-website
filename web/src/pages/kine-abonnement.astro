---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../lib/schema";
---

<Layout
  title="Kiné-abonnement | Movenda Hasselt"
  description="Zelfstandig oefenen bij Movenda aan de Kuringersteenweg in Hasselt."
  path="/kine-abonnement"
  jsonLd={[breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Kiné-abonnement", path: "/kine-abonnement" }])]}
>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-bold">Kiné-abonnement</h1>
    <p class="mt-4 text-brand-muted">
      Na een behandeling kun je, wanneer dat in je traject past, zelfstandig verder oefenen in de praktijk aan de Kuringersteenweg.
      Het tarief staat op de prijspagina, niet op de behandelpagina’s.
    </p>
    <p class="mt-6">
      <a class="font-semibold underline" href="/prijzen">Prijzen en terugbetaling</a>
    </p>
  </section>
</Layout>
