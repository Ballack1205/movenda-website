---
import Layout from "../layouts/Layout.astro";
import LinkedText from "../components/LinkedText.astro";
import { getPagina, getSiteSettings, paginaAlineas } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";

const pagina = await getPagina("kine-abonnement");
const settings = await getSiteSettings();
const alineas = paginaAlineas(pagina);
---

<Layout
  title={pagina.seoTitle || "Kiné-fitnessabonnement | Movenda Hasselt"}
  description={pagina.seoDescription || ""}
  path="/kine-abonnement"
  jsonLd={[breadcrumbSchema([{ name: "Home", path: "/" }, { name: "Kiné-abonnement", path: "/kine-abonnement" }])]}
>
  <section class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(16rem,26rem)]">
    <div>
    {pagina.ondertitel && <p class="brief-kicker">{pagina.ondertitel}</p>}
    <h1 class="brief-title brief-title--wide">{pagina.titel}</h1>
    {alineas.map((tekst, i) => (
      <p class:list={["brief-lead", i < alineas.length - 1 && "brief-lead--wide"]}>
        <LinkedText text={tekst} />
      </p>
    ))}
    <p class="brief-kicker mt-10">Meer info?</p>
    <a class="brief-textlink" href={`mailto:${settings.email}`}>{settings.email}</a>
    </div>
    <img
      src="/marketing/kine-fitness-abo.jpg"
      alt="Kine-fitnessabonnement van Olympia en Movenda, 40 euro per maand"
      width="987"
      height="1400"
      class="mx-auto h-auto w-full max-w-md"
    />
  </section>
</Layout>
