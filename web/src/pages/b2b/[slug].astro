---
import Layout from "../../layouts/Layout.astro";
import DienstDetail from "../../components/DienstDetail.astro";
import {
  getDiensten,
  getLocatieBySlug,
  getTeamleden,
  getPrijzen,
  findPrijsVoorDienst,
  dienstHref,
  isB2bDienst,
} from "../../lib/content";
import { serviceNode, breadcrumbNode } from "../../lib/schema";

export async function getStaticPaths() {
  const diensten = await getDiensten();
  return diensten.filter(isB2bDienst).map((dienst) => ({ params: { slug: dienst.slug } }));
}

const { slug } = Astro.params;
const dienst = (await getDiensten()).find((item) => item.slug === slug && isB2bDienst(item));

if (!dienst) {
  return Astro.redirect("/b2b");
}

const locatie = (await getLocatieBySlug("mpc"))!;
const team = (await getTeamleden()).filter((lid) => dienst.gekoppeldeTeamleden.includes(lid.slug));
const path = dienstHref(dienst);
const prijs = findPrijsVoorDienst(dienst, await getPrijzen());

const jsonLd = [
  serviceNode(dienst, locatie, { path, prijs, team }),
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "B2B", path: "/b2b" },
    { name: dienst.titel, path },
  ]),
];
---

<Layout
  title={dienst.seoTitle}
  description={dienst.seoDescription}
  path={path}
  altPath={dienstHref(dienst, "en")}
  jsonLd={jsonLd}
>
  <DienstDetail
    dienst={dienst}
    team={team}
    locatie={locatie}
    backHref="/b2b"
    backLabel="← Terug naar B2B"
  />
</Layout>
