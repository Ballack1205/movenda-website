---
import AanbodOverzicht from "../../components/AanbodOverzicht.astro";
import Layout from "../../layouts/Layout.astro";
import PaginaFoto from "../../components/PaginaFoto.astro";
import { getPagina, paginaAlineas, paginaTekst } from "../../lib/content";
import { getBriefAanbod } from "../../lib/nav";
import { breadcrumbSchema } from "../../lib/schema";
import b2bHero from "../../assets/marketing/home-b2b.jpg";

const pagina = await getPagina("b2b");
const aanbod = (await getBriefAanbod("nl")).find((group) => group.label === "B2B")?.children ?? [];

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "B2B", path: "/b2b" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "B2B voor bedrijven | Movenda"}
  description={pagina.seoDescription || ""}
  path="/b2b"
  altPath="/en/b2b"
  jsonLd={jsonLd}
>
  <AanbodOverzicht
    class="page-ink"
    kicker={pagina.ondertitel}
    titel={pagina.titel}
    alineaas={paginaAlineas(pagina)}
    blokken={pagina.blokken}
    aanbodTitel={paginaTekst(pagina, "aanbodTitel") || "Aanbod"}
    aanbod={aanbod}
  >
    <a slot="actions" href={pagina.knopUrl || "/contact?behandeling=B2B"} class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white">
      {paginaTekst(pagina, "knopLabel") || "Vraag een voorstel op maat"}
    </a>
    <PaginaFoto
      slot="media"
      pagina={pagina}
      fallback={b2bHero}
      alt={pagina.fotoAlt || "Training met een bedrijf bij Movenda"}
      width={640}
      height={720}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 42vw, 100vw"
      class="aspect-[4/4.5] w-full object-cover"
      priority
    />
  </AanbodOverzicht>
</Layout>
