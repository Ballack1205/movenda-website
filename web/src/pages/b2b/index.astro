---
import AanbodOverzicht from "../../components/AanbodOverzicht.astro";
import Layout from "../../layouts/Layout.astro";
import { getDienstBySlug, getPagina, paginaAlineas } from "../../lib/content";
import { getBriefAanbod } from "../../lib/nav";
import { breadcrumbSchema } from "../../lib/schema";

const pagina = await getPagina("b2b");
const aanbod = (await getBriefAanbod("nl")).find((group) => group.label === "B2B")?.children ?? [];
const groep = await getDienstBySlug("kleine-groepstraining", "mpc");
const teamtraining = await getDienstBySlug("teamtraining", "mpc");
const raw = groep?.afbeelding || teamtraining?.afbeelding || "/dienst-covers/kleine-groepstraining.jpg";
const foto = raw.startsWith("/") ? raw : `${raw.split("?")[0]}?w=2000&fit=max&auto=format`;

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "B2B", path: "/b2b" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "B2B voor bedrijven | Movenda"}
  description={pagina.seoDescription || ""}
  path="/b2b"
  altPath="/en/b2b"
  jsonLd={jsonLd}
>
  {foto && (
    <div class="b2b-cover">
      <img src={foto} alt="Een kleine groep traint in het Performance Centre" width="1600" height="2200" />
    </div>
  )}
  <AanbodOverzicht
    class="page-ink"
    kicker={pagina.ondertitel}
    titel={pagina.titel}
    alineaas={paginaAlineas(pagina)}
    blokken={pagina.blokken}
    aanbodTitel="Aanbod"
    aanbod={aanbod}
  >
    <a slot="actions" href="/contact?behandeling=B2B" class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white">
      Vraag een voorstel op maat
    </a>
  </AanbodOverzicht>
</Layout>
