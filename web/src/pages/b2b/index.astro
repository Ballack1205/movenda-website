---
import AanbodOverzicht from "../../components/AanbodOverzicht.astro";
import Layout from "../../layouts/Layout.astro";
import { getPagina, paginaAlineas } from "../../lib/content";
import { getBriefAanbod } from "../../lib/nav";
import { breadcrumbSchema } from "../../lib/schema";

const pagina = await getPagina("b2b");
const aanbod = (await getBriefAanbod("nl")).find((group) => group.label === "B2B")?.children ?? [];

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "B2B", path: "/b2b" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "B2B voor bedrijven | Movenda"}
  description={pagina.seoDescription || ""}
  path="/b2b"
  altPath="/en/b2b"
  jsonLd={jsonLd}
>
  <AanbodOverzicht
    kicker={pagina.ondertitel}
    titel={pagina.titel}
    alineaas={paginaAlineas(pagina)}
    blokken={pagina.blokken}
    aanbodTitel="Aanbod"
    aanbod={aanbod}
  >
    <a slot="actions" href="/contact?behandeling=B2B" class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white">
      Vraag een voorstel op maat
    </a>
  </AanbodOverzicht>
</Layout>
