---
import LocatiePage from "../../components/LocatiePage.astro";
import { getLocaties } from "../../lib/content";

export async function getStaticPaths() {
  const locaties = await getLocaties();
  return locaties.map((locatie) => ({ params: { slug: locatie.slug } }));
}
---

<LocatiePage lang="nl" slug={Astro.params.slug!} />
