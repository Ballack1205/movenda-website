---
import Layout from "../layouts/Layout.astro";
import PartnerBand from "../components/PartnerBand.astro";
import PaginaFoto from "../components/PaginaFoto.astro";
import { getLocaties, getPartners, getFaqs, getSiteSettings, getPagina, paginaAlineas } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import overHero from "../assets/marketing/over-hero.jpg";

const locatie = (await getLocaties()).find((l) => l.slug === "olympia")!;
const partners = await getPartners("movenda");
const faqs = (await getFaqs("movenda")).slice(0, 5);
const settings = await getSiteSettings();
// All copy on this page is Julie's: Studio → Pagina's → Over ons.
const pagina = await getPagina("over");
const alineas = paginaAlineas(pagina);

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Over ons", path: "/over" },
  ]),
];
import SectionKicker from "../components/SectionKicker.astro";
---

<Layout
  title={pagina.seoTitle || "Over Movenda | Groepspraktijk kinesitherapie Hasselt"}
  description={pagina.seoDescription || ""}
  path="/over"
  altPath="/en/over"
  jsonLd={jsonLd}
>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 lg:grid-cols-2">
    <div>
      <SectionKicker n={1} />
        <h1 class="text-3xl font-bold">{pagina.titel}</h1>
      {alineas.map((tekst) => (
        <p class="mt-4 text-brand-muted">{tekst}</p>
      ))}
    </div>
    <PaginaFoto
      pagina={pagina}
      fallback={overHero}
      alt="Coach en klant bij Movenda"
      width={640}
      height={480}
      class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl"
      priority
    />
  </section>

  {settings.slogans.home && (
    <p class="mx-auto max-w-3xl px-4 pb-8 text-center text-xl font-semibold text-brand-primary">
      {settings.slogans.home}
    </p>
  )}

  <section class="mx-auto max-w-3xl px-4 pb-12">
    <div class="divide-y divide-brand-border rounded-2xl border border-brand-border bg-brand-surface">
      {pagina.blokken.map((item) => (
        <details class="group px-6 py-4">
          <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {item.kop}
              <span class="text-brand-primary transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm text-brand-muted">{item.tekst}</p>
          {item.kop.includes("Performance") && (
            <a href="/mpc" class="mt-3 inline-block text-sm font-semibold text-brand-primary hover:underline">
              Meer over MPC →
            </a>
          )}
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {pagina.kenmerken.map((f) => (
        <div class="rounded-2xl border border-brand-border bg-brand-surface p-6">
          <h3 class="font-semibold text-brand-primary">{f.kop}</h3>
          <p class="mt-1 text-sm text-brand-muted">{f.tekst}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-12">
    <h2 class="text-2xl font-bold">{pagina.stappenTitel}</h2>
    {pagina.stappenIntro && <p class="mt-2 text-brand-muted">{pagina.stappenIntro}</p>}
    <ol class="mt-6 grid gap-4">
      {pagina.stappen.map((s, i) => (
        <li class="rounded-2xl border border-brand-border bg-brand-surface p-6">
          <p class="text-sm font-semibold text-brand-primary">Stap {i + 1} — {s.kop}</p>
          <p class="mt-1 text-sm text-brand-muted">{s.tekst}</p>
        </li>
      ))}
    </ol>
  </section>

  {faqs.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-12">
      <h2 class="text-2xl font-bold">Veelgestelde vragen</h2>
      <div class="mt-4 divide-y divide-brand-border rounded-2xl border border-brand-border bg-brand-surface">
        {faqs.map((faq) => (
          <details class="group px-6 py-4">
            <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
              {faq.vraag}
            </summary>
            <p class="mt-3 text-sm text-brand-muted">{faq.antwoord}</p>
          </details>
        ))}
      </div>
      <a href="/faq" class="mt-4 inline-block text-sm font-semibold text-brand-primary hover:underline">
        Alle vragen →
      </a>
    </section>
  )}

  <PartnerBand
    partners={partners}
    title={settings.partnerband.titel}
    snelheid={settings.partnerband.snelheid}
    animatie={settings.partnerband.animatie}
  />

  <section class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-sm text-brand-muted">
      Vragen over onze aanpak?{" "}
      <a href="/contact" class="font-semibold text-brand-primary hover:underline">Neem contact op</a>{" "}
      of bel <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="font-semibold text-brand-primary hover:underline">{locatie.telefoon}</a>.
    </p>
  </section>
</Layout>
