---
import Layout from "../../layouts/Layout.astro";
import GoogleReviewBadge from "../../components/GoogleReviewBadge.astro";
import { getDienstenByCategorie, getLocatieBySlug } from "../../lib/content";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";

const diensten = await getDienstenByCategorie("mpc");
const locatie = (await getLocatieBySlug("mpc"))!;

// Extra programma's van het echte MPC-aanbod die (nog) geen eigen CMS-dienst
// hebben — zie movenda.be homepage. Zodra Julie hierover meer copy heeft,
// verdienen deze een volwaardige `dienst`-record in de Studio.
const extraProgrammas = ["Boxing", "Corporate coaching", "HIIT & Full Body", "PowerPlus & Running", "SkiFit", "Data-analyse"];

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Movenda Performance Centre", path: "/mpc" },
  ]),
];
---

<Layout
  title="Performance training & sportrevalidatie Hasselt | Movenda Performance Centre"
  description="Movenda Performance Centre in Kuringen: data-gedreven performance training en sportrevalidatie voor recreatieve en professionele sporters."
  path="/mpc"
  altPath="/en/mpc"
  brand="mpc"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="text-sm font-semibold uppercase tracking-wide" style="color:#ff4d2e;">
      Movenda Performance Centre
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
      Presteer op je hoogste niveau, data-gedreven begeleid
    </h1>
    <p class="mt-4 max-w-2xl" style="color:#a3aab0;">
      Een multidisciplinair performance centre gericht op prestatiemaximalisatie van
      (semi-)professionele sporters en medische revalidatie op basis van data-analyse. Open
      ruimte, hoogwaardige toestellen en een één-op-één begeleiding.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="rounded-full px-6 py-3 font-semibold text-white" style="background-color:#ff4d2e;">
        Bel {locatie.telefoon}
      </a>
      <a href="/contact" class="rounded-full border px-6 py-3 font-semibold" style="border-color:#262b2f;">
        Contacteer ons
      </a>
    </div>
    <div class="mt-6">
      <GoogleReviewBadge locatie="mpc" />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="text-2xl font-bold">Onze diensten</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {diensten.map((dienst) => (
        <a href={`/mpc/${dienst.slug}`} class="rounded-2xl border p-8 transition" style="border-color:#262b2f;">
          <h3 class="text-xl font-semibold">{dienst.titel}</h3>
          <p class="mt-2" style="color:#a3aab0;">{dienst.intro}</p>
          <span class="mt-4 inline-block font-semibold" style="color:#ff4d2e;">Meer info →</span>
        </a>
      ))}
    </div>

    <h2 class="mt-12 text-xl font-bold">Nog meer programma's</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {extraProgrammas.map((p) => (
        <span class="rounded-full border px-4 py-1.5 text-sm" style="border-color:#262b2f; color:#a3aab0;">
          {p}
        </span>
      ))}
    </div>
  </section>
</Layout>
