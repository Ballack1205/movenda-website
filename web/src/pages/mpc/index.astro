---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import GoogleReviewBadge from "../../components/GoogleReviewBadge.astro";
import SocialLinks from "../../components/SocialLinks.astro";
import DienstCard from "../../components/DienstCard.astro";
import PartnerBand from "../../components/PartnerBand.astro";
import GetuigenisCarousel from "../../components/GetuigenisCarousel.astro";
import PaginaFoto from "../../components/PaginaFoto.astro";
import {
  getDienstenByCategorie,
  getLocatieBySlug,
  getPartners,
  getFaqs,
  getSiteSettings,
  getGetuigenissen,
  getPagina,
  paginaAlineas,
} from "../../lib/content";
import { localBusinessSchema, breadcrumbSchema, faqPageSchema } from "../../lib/schema";
import mpcHero from "../../assets/marketing/mpc-hero.jpg";
import mpcSecondary from "../../assets/marketing/mpc-secondary.jpg";

const training = await getDienstenByCategorie("mpc-training");
const rehab = await getDienstenByCategorie("mpc-rehab");
const groep = await getDienstenByCategorie("mpc-groep");
const locatie = (await getLocatieBySlug("mpc"))!;
const partners = await getPartners("mpc");
const faqs = await getFaqs("mpc");
const settings = await getSiteSettings();
const getuigenissen = await getGetuigenissen("mpc");
// H1, intro, hero photo and the three pillar texts: Studio → Pagina's → MPC (overzicht).
const pagina = await getPagina("mpc");

// Pillar order is fixed (training, rehab, group); Julie edits title + text per pillar.
const pillarTargets = [
  { href: "#training", foto: training.find((d) => d.afbeelding)?.afbeelding },
  { href: "#sportrevalidatie", foto: rehab.find((d) => d.afbeelding)?.afbeelding },
  { href: "/mpc/groepslessen", foto: groep.find((d) => d.afbeelding)?.afbeelding },
];
const pillars = pillarTargets.map((t, i) => ({
  ...t,
  titel: pagina.pijlers[i]?.kop || "",
  tekst: pagina.pijlers[i]?.tekst || "",
})).filter((p) => p.titel);

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Movenda Performance Centre", path: "/mpc" },
  ]),
  ...(faqs.length > 0 ? [faqPageSchema(faqs, "/mpc")] : []),
];
---

<Layout
  title={pagina.seoTitle || "Movenda Performance Centre | Performance training Hasselt"}
  description={pagina.seoDescription || ""}
  path="/mpc"
  altPath="/en/mpc"
  brand="mpc"
  jsonLd={jsonLd}
>
  {/*
    Hero. On phones the photo comes first, full-bleed, with the brand name in a glass chip on the
    photo (same pattern as the homepage); the copy follows. From md up: copy left, rounded photo right.
  */}
  <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 pb-10 pt-0 md:grid-cols-2 md:gap-10 md:py-16">
    <div class="order-last min-w-0 md:order-none">
      {/* Eyebrow: on phones it sits on the photo (chip below), so it is hidden here until md. */}
      <p class="hidden text-sm font-semibold uppercase tracking-wide text-brand-primary md:block">
        Movenda Performance Centre
      </p>
      <h1 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl md:mt-3 xl:text-5xl">
        {pagina.titel}
      </h1>
      {settings.slogans.mpc && (
        <p class="mt-2 text-pretty text-lg font-medium text-brand-primary">{settings.slogans.mpc}</p>
      )}
      {paginaAlineas(pagina).map((tekst) => (
        <p class="mt-4 max-w-xl text-pretty text-brand-muted">{tekst}</p>
      ))}
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="rounded-full bg-brand-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-primary-dark sm:px-6 sm:text-base">
          Bel {locatie.telefoon}
        </a>
        <a href="/contact" class="rounded-full border border-brand-border px-5 py-3 text-sm font-semibold text-brand-text transition hover:border-brand-primary sm:px-6 sm:text-base">
          Contacteer ons
        </a>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
        <GoogleReviewBadge locatie="mpc" class="w-full justify-center sm:w-auto sm:justify-start" />
        <SocialLinks brand="mpc" class="w-full justify-center sm:w-auto sm:justify-start" />
      </div>
    </div>
    <div class="relative -mx-4 md:mx-0">
      <PaginaFoto
        pagina={pagina}
        fallback={mpcHero}
        alt="Movenda Performance Centre trainingsruimte"
        width={800}
        height={600}
        class="aspect-[4/3] w-full object-cover object-top sm:aspect-[16/10] md:aspect-[4/3] md:rounded-3xl md:shadow-xl xl:aspect-[5/4]"
        priority
      />
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-center bg-gradient-to-t from-black/55 via-black/20 to-transparent px-4 pb-4 pt-20 md:hidden"
      >
        <p
          class="inline-flex max-w-full items-center gap-2 whitespace-nowrap rounded-full bg-black/60 px-3.5 py-2 text-[0.8125rem] font-bold leading-tight tracking-tight text-white ring-1 ring-white/25 sm:text-sm"
        >
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-white shadow-[0_0_0_3px_rgba(255,255,255,0.25)]" aria-hidden="true"></span>
          Movenda Performance Centre
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8">
    <h2 class="text-2xl font-bold">Drie pijlers</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {pillars.map((p) => (
        <a href={p.href} class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-brand-border bg-brand-surface transition hover:border-brand-primary">
          {p.foto && (
            <img
              src={`${p.foto}?w=800&h=500&fit=crop&auto=format`}
              alt=""
              width="800"
              height="500"
              class="aspect-[16/10] w-full object-cover"
            />
          )}
          <div class="p-5">
            <h3 class="text-lg font-semibold">{p.titel}</h3>
            <p class="mt-1 text-sm text-brand-muted">{p.tekst}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="training" class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="text-2xl font-bold">Training</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {training.map((dienst) => (
        <DienstCard dienst={dienst} />
      ))}
    </div>
  </section>

  <section id="sportrevalidatie" class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid items-start gap-6 xl:grid-cols-3">
      <div class="min-w-0 xl:col-span-2">
        <h2 class="text-2xl font-bold">Sportrevalidatie</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {rehab.map((dienst) => (
            <DienstCard dienst={dienst} />
          ))}
        </div>
      </div>
      <Image
        src={mpcSecondary}
        alt="Trainingsruimte bij het Movenda Performance Centre"
        width={640}
        height={480}
        class="aspect-[16/10] w-full rounded-2xl object-cover xl:aspect-[3/4] xl:mt-14"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="text-2xl font-bold">Groepslessen</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {groep.map((dienst) => (
        <DienstCard dienst={dienst} />
      ))}
    </div>
    <a href="/mpc/groepslessen" class="mt-6 inline-block font-semibold text-brand-primary hover:underline">
      Bekijk het lesrooster →
    </a>
  </section>

  <GetuigenisCarousel items={getuigenissen} title="Wat onze atleten zeggen" />

  {partners.length > 0 && (
    <PartnerBand
      partners={partners}
      title={settings.partnerband.titelMpc}
      snelheid={settings.partnerband.snelheid}
      animatie={settings.partnerband.animatie}
    />
  )}

  {faqs.length > 0 && (
    <section id="faq" class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="text-2xl font-bold">Veelgestelde vragen</h2>
      <div class="mt-6 divide-y divide-brand-border rounded-2xl border border-brand-border bg-brand-surface">
        {faqs.map((faq) => (
          <details class="group px-6 py-4">
            <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">
                {faq.vraag}
                <span class="text-brand-primary transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-3 text-sm text-brand-muted">{faq.antwoord}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</Layout>
