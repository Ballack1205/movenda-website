---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getDienstenByCategorie, getLocatieBySlug } from "../../lib/content";
import { localBusinessSchema, breadcrumbSchema } from "../../lib/schema";
import mpcHero from "../../assets/marketing/mpc-hero.jpg";
import mpcSecondary from "../../assets/marketing/mpc-secondary.jpg";

const diensten = await getDienstenByCategorie("mpc");
const locatie = (await getLocatieBySlug("mpc"))!;

// Extra programma's van het echte MPC-aanbod die (nog) geen eigen CMS-dienst
// hebben — zie movenda.be homepage. Zodra Julie hierover meer copy heeft,
// verdienen deze een volwaardige `dienst`-record in de Studio.
const extraProgrammas = ["Boxing", "Corporate coaching", "HIIT & Full Body", "PowerPlus & Running", "SkiFit", "Data-analyse"];

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Movenda Performance Centre", path: "/mpc" },
  ]),
];
---

<Layout
  title="Performance training & sportrevalidatie Hasselt | Movenda Performance Centre"
  description="Movenda Performance Centre in Kuringen: data-gedreven performance training en sportrevalidatie voor recreatieve en professionele sporters."
  path="/mpc"
  altPath="/en/mpc"
  brand="mpc"
  jsonLd={jsonLd}
>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-primary">
        Movenda Performance Centre
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Presteer op je hoogste niveau, data-gedreven begeleid
      </h1>
      <p class="mt-4 max-w-xl text-brand-muted">
        Een multidisciplinair performance centre gericht op prestatiemaximalisatie van
        (semi-)professionele sporters en medische revalidatie op basis van data-analyse. Open
        ruimte, hoogwaardige toestellen en een één-op-één begeleiding.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark">
          Bel {locatie.telefoon}
        </a>
        <a href="/contact" class="rounded-full border border-brand-border px-6 py-3 font-semibold text-brand-text transition hover:border-brand-primary">
          Contacteer ons
        </a>
      </div>
    </div>
    <Image
      src={mpcHero}
      alt="Movenda Performance Centre trainingsruimte"
      width={640}
      height={800}
      class="aspect-[4/5] w-full rounded-3xl object-cover shadow-xl"
      priority
    />
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="text-2xl font-bold">Onze diensten</h2>
    <div class="mt-6 grid gap-6 lg:grid-cols-3">
      <div class="grid gap-6 sm:grid-cols-2 lg:col-span-2">
        {diensten.map((dienst) => (
          <a href={`/mpc/${dienst.slug}`} class="rounded-2xl border border-brand-border bg-brand-surface p-8 transition hover:border-brand-primary">
            <h3 class="text-xl font-semibold">{dienst.titel}</h3>
            <p class="mt-2 text-brand-muted">{dienst.intro}</p>
            <span class="mt-4 inline-block font-semibold text-brand-primary">Meer info →</span>
          </a>
        ))}
      </div>
      <Image
        src={mpcSecondary}
        alt="Trainingsruimte bij het Movenda Performance Centre"
        width={480}
        height={640}
        class="hidden aspect-[3/4] w-full rounded-2xl object-cover lg:block"
      />
    </div>

    <h2 class="mt-12 text-xl font-bold">Nog meer programma's</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {extraProgrammas.map((p) => (
        <span class="rounded-full border border-brand-border bg-brand-surface px-4 py-1.5 text-sm text-brand-muted">
          {p}
        </span>
      ))}
    </div>
  </section>
</Layout>
