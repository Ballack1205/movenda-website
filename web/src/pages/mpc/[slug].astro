---
import { dienstHref, getDienstenByCategorie } from "../../lib/content";

export async function getStaticPaths() {
  const diensten = await getDienstenByCategorie("mpc");
  return diensten.map((dienst) => ({
    params: { slug: dienst.slug },
    props: { to: dienstHref(dienst) },
  }));
}

const { to } = Astro.props;
return Astro.redirect(to, 301);
---
