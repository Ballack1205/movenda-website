---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import GoogleReviewBadge from "../components/GoogleReviewBadge.astro";
import DienstCard from "../components/DienstCard.astro";
import PaginaFoto from "../components/PaginaFoto.astro";
import { getDienstenByCategorie, getLocatieBySlug, getSiteSettings, getPagina, paginaAlineas } from "../lib/content";
import { breadcrumbSchema, localBusinessSchema } from "../lib/schema";
import trainingHero from "../assets/marketing/training-hero.jpg";
import trainingSecondary from "../assets/marketing/training-secondary.jpg";

const locatie = (await getLocatieBySlug("olympia"))!;
const diensten = await getDienstenByCategorie("training");
const settings = await getSiteSettings();
const pagina = await getPagina("training");
// Same list Julie edits for the homepage pijler (siteSettings -> Homepage).
const doelgroepen = settings.homePijlers.training.lijst;

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Training", path: "/training" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "Training Hasselt: personal, duo & sportspecifiek | Movenda"}
  description={pagina.seoDescription || ""}
  path="/training"
  altPath="/en/training"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h1 class="text-3xl font-bold">{pagina.titel}</h1>
        {paginaAlineas(pagina).map((tekst) => (
          <p class="mt-3 max-w-xl text-brand-muted">{tekst}</p>
        ))}
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`}
            class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark"
          >
            Bel {locatie.telefoon}
          </a>
          <GoogleReviewBadge locatie="olympia" />
        </div>
      </div>
      <PaginaFoto
        pagina={pagina}
        fallback={trainingHero}
        alt="Personal training sessie bij Movenda"
        width={640}
        height={480}
        class="aspect-[4/3] w-full rounded-3xl object-cover shadow-xl"
        priority
      />
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-2">
        {diensten.map((dienst) => (
          <DienstCard dienst={dienst} />
        ))}
      </div>
      <Image
        src={trainingSecondary}
        alt="Krachttraining bij Movenda"
        width={480}
        height={640}
        class="aspect-[16/10] w-full rounded-2xl object-cover lg:aspect-[3/4]"
      />
    </div>

    <h2 class="mt-12 text-xl font-bold">Voor wie?</h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {doelgroepen.map((d) => (
        <span class="rounded-full border border-brand-border bg-brand-surface px-4 py-1.5 text-sm text-brand-text">
          {d}
        </span>
      ))}
    </div>

    <p class="mt-10 text-sm text-brand-muted">
      Voor performance training en topsportbegeleiding: bekijk het{" "}
      <a href="/mpc" class="font-semibold text-brand-primary hover:underline">Movenda Performance Centre</a>.
    </p>
  </section>
</Layout>
