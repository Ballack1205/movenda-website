---
import Layout from "../../layouts/Layout.astro";
import {
  getLesrooster,
  getLocatieBySlug,
  getPrijzenByCategorie,
  formatPrijs,
  getDiensten,
  lesHref,
} from "../../lib/content";
import { breadcrumbSchema } from "../../lib/schema";

const locatie = (await getLocatieBySlug("mpc"))!;
const rooster = await getLesrooster();
const diensten = await getDiensten();
const memberships = await getPrijzenByCategorie("mpc-groep");

const dagen = ["Maandag", "Dinsdag", "Woensdag", "Donderdag", "Vrijdag", "Zaterdag"];

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Movenda Performance Centre", path: "/performance" },
    { name: "Groepslessen", path: "/groepslessen" },
  ]),
];
---

<Layout
  title="Groepslessen & lesrooster | Movenda Performance Centre"
  description="GX small group training in Kuringen: maximaal acht deelnemers, met coaching op techniek en niveau. Lesrooster van het Movenda Performance Centre."
  path="/groepslessen"
  altPath="/en/groepslessen"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-primary">GX</p>
    <h1 class="mt-2 text-3xl font-bold">GX (small) group training</h1>
    <p class="mt-3 text-xl font-semibold">Samen trainen. Persoonlijk blijven groeien.</p>
    <p class="mt-3 max-w-3xl text-brand-muted">
      GX combineert de energie van een groep met de kwaliteit van gerichte coaching. Elke sessie telt
      maximaal acht deelnemers. Daardoor kan de coach techniek opvolgen, oefeningen aanpassen en iedereen
      uitdagen op een niveau dat past. Je traint samen, maar je progressie blijft persoonlijk.
    </p>
    <h2 class="mt-8 text-xl font-bold">Waarom GX</h2>
    <ul class="mt-3 max-w-3xl list-disc space-y-1 pl-5 text-brand-muted">
      <li>Maximaal acht deelnemers per sessie</li>
      <li>Professionele coaching en technische correctie</li>
      <li>Schaalbare oefeningen binnen één groepsformat</li>
      <li>Vaste trainingsmomenten die regelmaat ondersteunen</li>
      <li>Gedeelde energie, persoonlijke aandacht en ruimte om te groeien</li>
    </ul>
    <p class="mt-6 max-w-3xl text-brand-muted">
      Coach, dag, uur, duur, locatie en vrije plaatsen staan alleen in het lessenrooster hieronder.
      Locatie: Performance Centre Kuringen, Lammerweg 33, 3511 Kuringen. {locatie.verdiepingNote}
    </p>
    <p class="mt-4">
      <a href="#inschrijven" class="font-semibold text-brand-primary hover:underline">Boek een proefles</a>
    </p>

    <h2 class="mt-10 text-xl font-bold">Lesrooster</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {dagen.map((dag) => {
        const lessen = rooster.filter((r) => r.dag === dag);
        return (
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
            <h3 class="font-semibold text-brand-primary">{dag}</h3>
            {lessen.length === 0 ? (
              <p class="mt-2 text-sm text-brand-muted">Geen les</p>
            ) : (
              <ul class="mt-3 space-y-2 text-sm">
                {lessen.map((les) => (
                  <li>
                    <a href={lesHref(les, diensten)} class="flex min-h-11 items-center gap-1 py-1 hover:underline">
                      <span class="font-medium">{les.van}–{les.tot}</span>
                      <span>· {les.les}</span>
                      {les.coachNaam && <span class="text-brand-muted"> — {les.coachNaam}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>

    {memberships.length > 0 && (
      <div class="mt-12">
        <h2 class="text-xl font-bold">Memberships</h2>
        <p class="mt-2 text-sm text-brand-muted">
          Prijzen exclusief BTW. Annuleren tot 24u op voorhand.
          {" "}
          <a href="/performance/prijzen" class="font-medium text-brand-primary hover:underline">Alle tarieven</a>
        </p>
        <div class="mt-4 overflow-x-auto rounded-2xl border border-brand-border">
          <table class="w-full min-w-[28rem] text-left text-sm">
            <tbody>
              {memberships.map((item, i) => (
                <tr class={i % 2 === 0 ? "bg-brand-surface" : ""}>
                  <td class="px-4 py-3">{item.naam}</td>
                  <td class="px-4 py-3 text-right font-semibold text-brand-primary">{formatPrijs(item)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <form id="inschrijven" class="mt-12 max-w-xl space-y-3" data-groep-form>
      <h2 class="text-xl font-bold">Inschrijven</h2>
      <p class="text-sm text-brand-muted">Zonder betaling. Je aanvraag komt bij ons binnen per mail.</p>
      <input class="w-full rounded-lg border border-brand-border px-4 py-3" name="naam" placeholder="Naam" required />
      <input class="w-full rounded-lg border border-brand-border px-4 py-3" type="email" name="email" placeholder="E-mail" required />
      <input class="w-full rounded-lg border border-brand-border px-4 py-3" type="tel" name="telefoon" placeholder="Telefoon" />
      <input class="w-full rounded-lg border border-brand-border px-4 py-3" name="les" placeholder="Les" required />
      <textarea class="w-full rounded-lg border border-brand-border px-4 py-3" name="bericht" rows="3" placeholder="Bericht"></textarea>
      <input class="hidden" name="website" tabindex="-1" autocomplete="off" />
      <button class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white" type="submit">Verstuur</button>
      <p class="hidden text-sm" data-groep-status></p>
    </form>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-groep-form]");
  const status = document.querySelector<HTMLElement>("[data-groep-status]");
  const api = import.meta.env.PUBLIC_CONTACT_API_URL || "https://movenda-contact-api.onrender.com";
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status) return;
    const data = Object.fromEntries(new FormData(form).entries());
    status.classList.remove("hidden");
    status.textContent = "Bezig…";
    try {
      const res = await fetch(`${api}/api/groepslessen`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("send");
      form.reset();
      status.textContent = "Verstuurd. We nemen contact op.";
    } catch {
      status.textContent = "Versturen lukte niet. Mail ons gerust rechtstreeks.";
    }
  });
</script>
