---
import Layout from "../layouts/Layout.astro";
import { getVacatures, getSiteSettings } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";

const vacatures = await getVacatures();
const settings = await getSiteSettings();

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Vacatures", path: "/jobs" },
  ]),
];
---

<Layout
  title="Vacatures | Werken bij Movenda Hasselt"
  description="Bekijk de openstaande vacatures bij Movenda in Hasselt en het Movenda Performance Centre in Kuringen."
  path="/jobs"
  altPath="/en/jobs"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">Werken bij Movenda</h1>
    <p class="mt-2 text-brand-muted">
      Word je graag deel van ons team van kinesisten, personal trainers en performance coaches?
    </p>

    {vacatures.length === 0 ? (
      <div class="mt-10 rounded-2xl border border-brand-border bg-brand-surface p-8 text-center">
        <p class="font-semibold">Momenteel geen openstaande vacatures.</p>
        <p class="mt-2 text-sm text-brand-muted">
          Interesse om toch je spontane sollicitatie te sturen? Mail naar{" "}
          <a href={`mailto:${settings.email}`} class="font-semibold text-brand-primary hover:underline">
            {settings.email}
          </a>.
        </p>
      </div>
    ) : (
      <div class="mt-10 grid gap-6">
        {vacatures.map((vacature) => (
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-6">
            <h2 class="text-lg font-semibold">{vacature.titel}</h2>
            {vacature.locatieNaam && <p class="text-sm font-medium text-brand-primary">{vacature.locatieNaam}</p>}
            <p class="mt-2 whitespace-pre-line text-sm text-brand-muted">{vacature.omschrijving}</p>
            <a
              href={`mailto:${vacature.contactEmail}`}
              class="mt-4 inline-block font-semibold text-brand-primary hover:underline"
            >
              Solliciteer via {vacature.contactEmail} →
            </a>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>
