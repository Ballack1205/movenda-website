---
import Layout from "../layouts/Layout.astro";
import { getVacatures, getSiteSettings, getPagina, paginaAlineas } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";

const vacatures = await getVacatures();
const settings = await getSiteSettings();
const pagina = await getPagina("jobs");
// "No vacancies" text: first line bold, the rest followed by the mail address.
const [leegKop, ...leegRest] = (pagina.legeTekst || "").split("\n");
const leegTekst = leegRest.join(" ").trim();

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Vacatures", path: "/jobs" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "Vacatures | Werken bij Movenda Hasselt"}
  description={pagina.seoDescription || ""}
  path="/jobs"
  altPath="/en/jobs"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">{pagina.titel}</h1>
    {paginaAlineas(pagina).map((tekst) => (
      <p class="mt-2 text-brand-muted">{tekst}</p>
    ))}

    {vacatures.length === 0 ? (
      <div class="mt-10 rounded-2xl border border-brand-border bg-brand-surface p-8 text-center">
        <p class="font-semibold">{leegKop || "Momenteel geen openstaande vacatures."}</p>
        <p class="mt-2 text-sm text-brand-muted">
          {leegTekst || "Spontaan solliciteren? Mail naar"}{" "}
          <a href={`mailto:${settings.email}`} class="font-semibold text-brand-primary hover:underline">
            {settings.email}
          </a>.
        </p>
      </div>
    ) : (
      <div class="mt-10 grid gap-6">
        {vacatures.map((vacature) => (
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-6">
            <h2 class="text-lg font-semibold">{vacature.titel}</h2>
            {vacature.locatieNaam && <p class="text-sm font-medium text-brand-primary">{vacature.locatieNaam}</p>}
            <p class="mt-2 whitespace-pre-line text-sm text-brand-muted">{vacature.omschrijving}</p>
            <a
              href={`mailto:${vacature.contactEmail}`}
              class="mt-4 inline-block font-semibold text-brand-primary hover:underline"
            >
              Solliciteer via {vacature.contactEmail} →
            </a>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>
