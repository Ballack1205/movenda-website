---
import Layout from "../../layouts/Layout.astro";
import DienstDetail from "../../components/DienstDetail.astro";
import {
  getDienstenByCategorie,
  getDienstBySlug,
  getLocatieBySlug,
  getTeamleden,
  getPrijzen,
  findPrijsVoorDienst,
  dienstHref,
} from "../../lib/content";
import { serviceNode, breadcrumbNode } from "../../lib/schema";

export async function getStaticPaths() {
  const diensten = await getDienstenByCategorie("training");
  return diensten.map((dienst) => ({ params: { slug: dienst.slug } }));
}

const { slug } = Astro.params;
const dienst = await getDienstBySlug(slug!, "training");

if (!dienst) {
  return Astro.redirect("/training");
}

const locatie = (await getLocatieBySlug("olympia"))!;
const alleTeamleden = await getTeamleden();
const team = alleTeamleden.filter((t) => dienst.gekoppeldeTeamleden.includes(t.slug));
const path = dienstHref(dienst);
const prijs = findPrijsVoorDienst(dienst, await getPrijzen());

const jsonLd = [
  serviceNode(dienst, locatie, { path, prijs, team }),
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "Training", path: "/training" },
    { name: dienst.titel, path },
  ]),
];
---

<Layout
  title={dienst.seoTitle}
  description={dienst.seoDescription}
  path={path}
  jsonLd={jsonLd}
  ogImage={dienst.afbeelding}
  ogImageAlt={`${dienst.titel} bij Movenda in Hasselt`}
>
  <DienstDetail
    dienst={dienst}
    team={team}
    locatie={locatie}
    backHref="/training"
    backLabel="← Terug naar training"
  />
</Layout>
