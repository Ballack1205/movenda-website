---
import Layout from "../layouts/Layout.astro";
import LinkedText from "../components/LinkedText.astro";
import { getFaqs, getPagina, getSiteSettings, paginaAlineas } from "../lib/content";
import { breadcrumbSchema, faqPageSchema } from "../lib/schema";

const faqs = await getFaqs("movenda");
const settings = await getSiteSettings();
const pagina = await getPagina("faq");

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "FAQ", path: "/faq" },
  ]),
  ...(faqs.length > 0 ? [faqPageSchema(faqs)] : []),
];
import SectionKicker from "../components/SectionKicker.astro";
---

<Layout
  title={pagina.seoTitle || "Veelgestelde vragen | Movenda Hasselt"}
  description={pagina.seoDescription || ""}
  path="/faq"
  altPath="/en/faq"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <SectionKicker n={1} />
        <h1 class="text-3xl font-bold">{pagina.titel}</h1>
    {paginaAlineas(pagina, "nl", { email: settings.email }).map((tekst) => (
      <p class="mt-2 text-brand-muted">
        <LinkedText text={tekst} linkClass="font-semibold text-brand-primary hover:underline" />
      </p>
    ))}

    <div class="mt-8 divide-y divide-brand-border rounded-2xl border border-brand-border bg-brand-surface">
      {faqs.map((faq) => (
        <details class="group px-6 py-4">
          <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {faq.vraag}
              <span class="text-brand-primary transition group-open:rotate-45">+</span>
            </span>
          </summary>
          <p class="mt-3 text-sm text-brand-muted">{faq.antwoord}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
