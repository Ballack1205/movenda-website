---
import { toHTML } from "@portabletext/to-html";
import Layout from "../../layouts/Layout.astro";
import { getBlogPosts, getBlogPostBySlug, getRelatedBlogPosts } from "../../lib/content";
import { blogPhotoSrc } from "../../lib/images";
import { blogPostingNode, breadcrumbNode } from "../../lib/schema";
import { absoluteUrl } from "../../lib/site";
import { blogTagLabel, formatBlogDate } from "../../lib/blog";
import BlogPostCard from "../../components/BlogPostCard.astro";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug!);

if (!post) {
  return Astro.redirect("/blog");
}

function escapeAttr(value: string) {
  return value.replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
}

const bodyHtml = toHTML(post.body as any, {
  components: {
    types: {
      image: ({ value }) => {
        const src = value?.url as string | undefined;
        if (!src) return "";
        const alt = escapeAttr((value.alt as string) || post.titel);
        return `<figure class="article-photo"><img src="${blogPhotoSrc(src, "inline")}" alt="${alt}" width="960" height="720" /></figure>`;
      },
    },
  },
});

const hasInlineImages = /<img\b/i.test(bodyHtml);
const extraPhotos = !hasInlineImages ? post.photos || [] : [];

function injectPhotos(html: string, photos: string[], alt: string) {
  if (!photos.length) return html;
  const figures = photos.map(
    (src) =>
      `<figure class="article-photo"><img src="${blogPhotoSrc(src, "inline")}" alt="${escapeAttr(alt)}" width="960" height="720" /></figure>`,
  );
  const parts = html.split(/(<\/h[2-4]>)/i);
  if (parts.length < 2) return `${html}${figures.join("")}`;
  let photoIdx = 0;
  let out = "";
  for (const part of parts) {
    out += part;
    if (/<\/h[2-4]>/i.test(part) && photoIdx < figures.length) {
      out += figures[photoIdx++];
    }
  }
  if (photoIdx < figures.length) out += figures.slice(photoIdx).join("");
  return out;
}

const articleHtml = injectPhotos(bodyHtml, extraPhotos, post.titel);
const contain = post.coverFit === "contain";
const related = await getRelatedBlogPosts(post.slug, 3);
const tags = post.tags || [];

const jsonLd = [
  breadcrumbNode([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog" },
    { name: post.titel, path: `/blog/${post.slug}` },
  ]),
  blogPostingNode(post),
];
---

<Layout
  title={post.seoTitle || `${post.titel} | Movenda blog`}
  description={post.seoDescription || post.excerpt || ""}
  path={`/blog/${post.slug}`}
  altPath={`/en/blog/${post.slug}`}
  jsonLd={jsonLd}
  ogImage={post.cover}
  article={{
    publishedTime: post.publicatiedatum,
    modifiedTime: post.updatedAt,
    // OG expects a profile URL here; the team page is the author's profile.
    author: post.auteurSlug ? absoluteUrl(`/team/${post.auteurSlug}`) : post.auteurNaam,
    section: "Blog",
    tags: tags.map(blogTagLabel),
  }}
  extraLinks={[
    { rel: "alternate", type: "text/markdown", href: `/blog/${post.slug}.md`, title: "Artikel (Markdown)" },
    { rel: "alternate", type: "application/rss+xml", href: "/rss.xml", title: "Movenda blog" },
  ]}
>
  <article class="pb-16">
    <header class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 lg:grid-cols-2 lg:py-16">
      {post.cover && (
        <div
          class:list={[
            "overflow-hidden rounded-3xl shadow-xl",
            contain ? "bg-white" : "bg-brand-header/10",
          ]}
        >
          <img
            src={blogPhotoSrc(post.cover, "hero")}
            alt={post.titel}
            width="1400"
            height="880"
            class:list={[
              "aspect-[16/10] w-full",
              contain ? "object-contain p-6 sm:p-10" : "object-cover object-top",
            ]}
          />
        </div>
      )}
      <div>
        <a href="/blog" class="text-sm font-semibold text-brand-primary hover:underline">
          ← Blog
        </a>
        <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-brand-muted">
          {formatBlogDate(post.publicatiedatum)}
          {post.auteurNaam ? ` · Geschreven door ${post.auteurNaam}` : ""}
        </p>
        <h1 class="mt-3 text-pretty text-4xl font-bold tracking-tight sm:text-5xl">{post.titel}</h1>
        {post.excerpt && <p class="mt-5 text-lg leading-relaxed text-brand-muted">{post.excerpt}</p>}
        {tags.length > 0 && (
          <p class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-full bg-brand-header/8 px-3 py-1 text-xs font-semibold text-brand-muted">
                {blogTagLabel(tag)}
              </span>
            ))}
          </p>
        )}
      </div>
    </header>

    <div class="article-body mx-auto max-w-2xl px-4" set:html={articleHtml} />

    <div class="mx-auto mt-12 max-w-2xl px-4">
      <a href="/blog" class="inline-block font-semibold text-brand-primary hover:underline">
        ← Terug naar de blog
      </a>
    </div>

    {related.length > 0 && (
      <aside class="mx-auto mt-16 max-w-6xl px-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">Meer lezen</h2>
        <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <BlogPostCard post={item} />
          ))}
        </div>
      </aside>
    )}
  </article>
</Layout>

<style>
  .article-body {
    color: var(--brand-text);
    line-height: 1.75;
  }
  .article-body > :global(p) {
    margin-top: 1.25em;
  }
  .article-body > :global(h2) {
    margin-top: 2em;
    font-size: 1.375rem;
    font-weight: 700;
  }
  .article-body > :global(h3),
  .article-body > :global(h4) {
    margin-top: 1.5em;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin-top: 1em;
    padding-left: 1.5em;
  }
  .article-body :global(li) {
    margin-top: 0.4em;
    list-style-type: disc;
  }
  .article-body :global(a) {
    color: var(--brand-primary);
    font-weight: 600;
    text-decoration: underline;
  }
  .article-body :global(.article-photo),
  .article-body :global(img) {
    margin-top: 2em;
    margin-bottom: 0.5em;
  }
  .article-body :global(img) {
    width: 100%;
    border-radius: 1.25rem;
    object-fit: cover;
    box-shadow: 0 20px 40px -24px rgb(20 36 51 / 0.45);
  }
</style>
