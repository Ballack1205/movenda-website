---
import Layout from "../../layouts/Layout.astro";
import BlogPostFeature from "../../components/BlogPostFeature.astro";
import BlogPostCard from "../../components/BlogPostCard.astro";
import { getBlogPosts, getPagina, paginaAlineas } from "../../lib/content";
import { blogListSchema, breadcrumbSchema } from "../../lib/schema";
import SectionKicker from "../../components/SectionKicker.astro";
import LinkedText from "../../components/LinkedText.astro";

const posts = await getBlogPosts();
const pagina = await getPagina("blog");
const featured = posts[0];
const rest = posts.slice(1);

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog" },
  ]),
  blogListSchema(posts),
];
---

<Layout
  title={pagina.seoTitle || "Blog | Movenda"}
  description={pagina.seoDescription || ""}
  path="/blog"
  altPath="/en/blog"
  jsonLd={jsonLd}
  extraLinks={[
    { rel: "alternate", type: "application/rss+xml", href: "/rss.xml", title: "Movenda blog" },
    { rel: "alternate", type: "text/markdown", href: "/blog.md", title: "Blog (Markdown)" },
  ]}
>
  <section class="mx-auto max-w-6xl px-4 py-12 lg:py-16">
    <SectionKicker n={1} />
    {pagina.ondertitel && <p class="text-sm font-semibold uppercase tracking-wide text-brand-primary">{pagina.ondertitel}</p>}
    <h1 class="mt-2 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
      {pagina.titel}
    </h1>
    <form action="/zoeken" method="get" role="search" class="mt-6 max-w-md">
      <label class="sr-only" for="blog-search">Zoeken</label>
      <input id="blog-search" name="q" type="search" placeholder="Zoeken" class="w-full border-b border-brand-border bg-transparent px-1 py-2 text-lg outline-none" />
    </form>
    {paginaAlineas(pagina).map((tekst) => (
      <p class="mt-4 max-w-2xl text-lg text-brand-muted"><LinkedText text={tekst} /></p>
    ))}

    {posts.length === 0 ? (
      <p class="mt-10 text-brand-muted">{pagina.legeTekst}</p>
    ) : (
      <>
        {featured && (
          <div class="mt-10">
            <BlogPostFeature post={featured} />
          </div>
        )}
        {rest.length > 0 && (
          <div class="mt-10 grid gap-6 sm:grid-cols-2">
            {rest.map((post) => (
              <BlogPostCard post={post} />
            ))}
          </div>
        )}
      </>
    )}
  </section>
</Layout>
