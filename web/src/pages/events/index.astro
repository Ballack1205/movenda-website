---
import Layout from "../../layouts/Layout.astro";
import { getEvents, getPagina, paginaAlineas } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/schema";
import SectionKicker from "../../components/SectionKicker.astro";
import LinkedText from "../../components/LinkedText.astro";
import EventVideo from "../../components/EventVideo.astro";

const events = await getEvents();
const pagina = await getPagina("events");
const today = new Date().toISOString().slice(0, 10);
const eventWhen = (datum: string) => {
  const date = new Date(`${datum}T12:00:00`);
  if (Number.isNaN(date.getTime())) return datum;
  return new Intl.DateTimeFormat("nl-BE", { day: "numeric", month: "long", year: "numeric" }).format(date);
};
const upcoming = events.filter((event) => event.datum >= today);
const past = events.filter((event) => event.datum < today);

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Events", path: "/events" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "Events | Movenda"}
  description={pagina.seoDescription || ""}
  path="/events"
  altPath="/en/events"
  jsonLd={jsonLd}
>
  <section class="page-ink mx-auto max-w-3xl px-4 py-12">
    <SectionKicker n={1} />
    <h1 class="text-3xl font-bold">{pagina.titel}</h1>
    {paginaAlineas(pagina).map((tekst) => (
      <p class="mt-3 text-brand-muted"><LinkedText text={tekst} /></p>
    ))}

    {events.length === 0 && (
      <p class="mt-8 text-brand-muted">{pagina.legeTekst}</p>
    )}

    {upcoming.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Komend</h2>
        <ul class="mt-4 space-y-6">
          {upcoming.map((event) => (
            <li>
              <p class="text-sm text-brand-muted">{eventWhen(event.datum)}{event.locatie ? ` · ${event.locatie}` : ""}</p>
              <h3 class="text-lg font-semibold">{event.titel}</h3>
              {event.tekst && <p class="mt-1 text-brand-muted">{event.tekst}</p>}
              <EventVideo video={event.video} foto={event.foto} titel={event.titel} />
            </li>
          ))}
        </ul>
      </div>
    )}

    {past.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold">Afgelopen</h2>
        <ul class="mt-4 space-y-6">
          {past.map((event) => (
            <li>
              <p class="text-sm text-brand-muted">{eventWhen(event.datum)}{event.locatie ? ` · ${event.locatie}` : ""}</p>
              <h3 class="text-lg font-semibold">{event.titel}</h3>
              {event.tekst && <p class="mt-1 text-brand-muted">{event.tekst}</p>}
              <EventVideo video={event.video} foto={event.foto} titel={event.titel} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Layout>
