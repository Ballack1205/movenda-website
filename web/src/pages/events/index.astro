---
import Layout from "../../layouts/Layout.astro";
import { getEvents, getPagina, paginaAlineas } from "../../lib/content";
import { breadcrumbSchema } from "../../lib/schema";
import SectionKicker from "../../components/SectionKicker.astro";
import LinkedText from "../../components/LinkedText.astro";
import EventKaart from "../../components/EventKaart.astro";

const events = await getEvents();
const pagina = await getPagina("events");
const today = new Date().toISOString().slice(0, 10);
// Furthest in the future on top; past events below, most recent first.
const nieuwsteEerst = (a: { datum: string }, b: { datum: string }) => b.datum.localeCompare(a.datum);
const upcoming = events.filter((event) => event.datum >= today).sort(nieuwsteEerst);
const past = events.filter((event) => event.datum < today).sort(nieuwsteEerst);

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Events", path: "/events" },
  ]),
];
---

<Layout
  title={pagina.seoTitle || "Events | Movenda"}
  description={pagina.seoDescription || ""}
  path="/events"
  altPath="/en/events"
  jsonLd={jsonLd}
>
  <section class="page-ink">
    <div class="mx-auto max-w-5xl px-4 py-12 md:py-16">
      <SectionKicker n={1} />
      <h1 class="font-heading text-4xl font-bold md:text-5xl">{pagina.titel}</h1>
      {paginaAlineas(pagina).map((tekst) => (
        <p class="mt-3 max-w-2xl text-brand-muted"><LinkedText text={tekst} /></p>
      ))}

      {events.length === 0 && (
        <p class="mt-8 text-brand-muted">{pagina.legeTekst}</p>
      )}

      {upcoming.length > 0 && (
        <div class="mt-12">
          <h2 class="events-kop">Komend</h2>
          <ul class="mt-5 space-y-4">
            {upcoming.map((event) => (
              <li><EventKaart event={event} /></li>
            ))}
          </ul>
        </div>
      )}

      {past.length > 0 && (
        <div class="mt-14">
          <h2 class="events-kop">Afgelopen</h2>
          <ul class="mt-5 space-y-3">
            {past.map((event) => (
              <li><EventKaart event={event} afgelopen /></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .events-kop {
    font-size: 0.8rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
