---
// Google review line — sources score/count from siteSettings.googleReviews
// (edited by Julie, not a paid reviews API). No AggregateRating JSON-LD is
// emitted for this: Google no longer shows self-reported rich results for
// LocalBusiness aggregate ratings; the real signal is the Google Business
// Profile itself, which this line links to. See DECISIONS.md.
//
// Design: a quiet trust line (Google "G" mark + SVG stars + score) rather
// than a pill with unicode ★ — unicode stars + "5.0" read as a template.
import type { LocatieSlug } from "../lib/content";
import { getSiteSettings } from "../lib/content";

export interface Props {
  locatie: LocatieSlug;
  lang?: "nl" | "en";
  class?: string;
}

const { locatie, lang = "nl", class: className = "" } = Astro.props;
const settings = await getSiteSettings();
const reviews = settings.googleReviews[locatie];

// Render nothing when there is no real review data for this location. Each
// location has its own Google Business Profile (Olympia and MPC), so the
// line is always scoped to one `locatie` — never show both on one page.
const hasReviews = Boolean(reviews && reviews.rating > 0 && reviews.count && reviews.reviewUrl);

const ratingText = lang === "en" ? reviews.rating.toFixed(1) : reviews.rating.toFixed(1).replace(".", ",");
const filledStars = Math.round(reviews.rating);
const label =
  lang === "en"
    ? `${ratingText} on Google · ${reviews.count} reviews`
    : `${ratingText} op Google · ${reviews.count} reviews`;
const cta = lang === "en" ? "Read them" : "Lees ze";
---

{hasReviews && (
  <a
    href={reviews.reviewUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`group inline-flex items-center gap-2.5 text-sm text-brand-text ${className}`}
    aria-label={`${label} — ${cta}`}
  >
    <!-- Google "G" mark -->
    <svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
      <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.5l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.2l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z" />
      <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 2.9-2.2 5.4-4.7 7.1l7.6 5.9c4.4-4.1 6.9-10.1 6.9-17.5z" />
      <path fill="#FBBC05" d="M10.5 28.7A14.6 14.6 0 0 1 9.7 24c0-1.6.3-3.2.8-4.7l-7.9-6.1A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.8l7.9-6.1z" />
      <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.6-5.9c-2.1 1.4-4.9 2.3-8.3 2.3-6.3 0-11.6-4.1-13.5-9.9l-7.9 6.1C6.5 42.6 14.6 48 24 48z" />
    </svg>
    <span class="flex items-center gap-0.5" aria-hidden="true">
      {Array.from({ length: 5 }, (_, i) => (
        <svg
          class={`h-3.5 w-3.5 ${i < filledStars ? "text-brand-accent" : "text-brand-border"}`}
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8z" />
        </svg>
      ))}
    </span>
    <span class="font-medium">{label}</span>
    <span class="text-brand-muted underline decoration-brand-border underline-offset-4 transition group-hover:text-brand-primary group-hover:decoration-brand-primary">
      {cta}
    </span>
  </a>
)}
