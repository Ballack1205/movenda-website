---
// Google review badge — sources score/count from siteSettings.googleReviews
// (edited by Julie, not a paid reviews API). No AggregateRating JSON-LD is
// emitted for this: Google no longer shows self-reported rich results for
// LocalBusiness aggregate ratings; the real signal is the Google Business
// Profile itself, which this badge links to. See DECISIONS.md.
import type { LocatieSlug } from "../lib/content";
import { getSiteSettings } from "../lib/content";

export interface Props {
  locatie: LocatieSlug;
  lang?: "nl" | "en";
  class?: string;
}

const { locatie, lang = "nl", class: className = "" } = Astro.props;
const settings = await getSiteSettings();
const reviews = settings.googleReviews[locatie];

// Render nothing when there is no real review data for this location. Each
// location has its own Google Business Profile (Olympia and MPC), so the
// badge is always scoped to one `locatie` — never show both on one page.
const hasReviews = Boolean(reviews && reviews.rating > 0 && reviews.count && reviews.reviewUrl);
---

{hasReviews && (
  <a
    href={reviews.reviewUrl}
    target="_blank"
    rel="noopener noreferrer"
    class={`inline-flex items-center gap-2 rounded-full border border-brand-border bg-brand-surface px-4 py-2 text-sm font-medium text-brand-text transition hover:border-brand-primary ${className}`}
  >
    <span aria-hidden="true" class="text-brand-accent">★★★★★</span>
    <span>{reviews.rating.toFixed(1)} · {reviews.count} {lang === "en" ? "Google reviews" : "Google-reviews"}</span>
  </a>
)}
