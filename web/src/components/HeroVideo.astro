---
// Hero of a fixed page with an optional muted looping video on top of the
// photo (Pagina's → MPC → "Video bovenaan"). The photo is always rendered:
// it is the LCP element, the poster while the video buffers, and the only
// thing shown when the visitor prefers reduced motion or the video fails.
// No video = exactly the PaginaFoto output, so pages without a clip are
// untouched.
import type { ImageMetadata } from "astro";
import type { Pagina } from "../lib/content";
import PaginaFoto from "./PaginaFoto.astro";

export interface Props {
  pagina: Pick<Pagina, "foto" | "fotoHotspot" | "fotoAlt" | "heroVideo">;
  fallback: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  /** Classes for the photo (aspect ratio, rounding, shadow). The video copies the box. */
  class?: string;
  priority?: boolean;
}

const { pagina, fallback, alt, width, height, class: className = "", priority } = Astro.props;
const video = pagina.heroVideo;
const type = video?.toLowerCase().endsWith(".webm") ? "video/webm" : "video/mp4";
---

{video ? (
  <div class="hero-video relative">
    <PaginaFoto pagina={pagina} fallback={fallback} alt={alt} width={width} height={height} class={className} priority={priority} />
    {/* Decorative: the photo carries the alt text; the clip only adds atmosphere. Vertical clips are
        covered (centre crop) into the same box as the photo, so Julie may upload a phone recording.
        No src/autoplay in the markup: the script attaches the source after `load`, so the clip never
        competes with the hero photo (LCP) or the CSS/fonts for bandwidth. Lighthouse mobile: LCP on
        /mpc went from 4.2 s back to the photo-only value once the download was deferred. */}
    <video
      class={`hero-video__clip absolute inset-0 h-full w-full object-cover ${className}`}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
      data-src={video}
      data-type={type}
    ></video>
  </div>
) : (
  <PaginaFoto pagina={pagina} fallback={fallback} alt={alt} width={width} height={height} class={className} priority={priority} />
)}

<style>
  /* Only fade the clip in once it actually plays, so the photo stays the visible LCP element
     and nothing flashes when the network is slow. */
  .hero-video__clip {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .hero-video__clip.is-playing {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video__clip {
      display: none;
    }
  }
</style>

<script>
  // Start the clip only once the page has loaded, and only when motion/data allow it. Autoplay may
  // still be refused (Low Power Mode); then the photo simply stays. Remove the element instead of
  // leaving a stalled black box.
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const skip = window.matchMedia("(prefers-reduced-motion: reduce)").matches || connection?.saveData === true;

  const start = () => {
    for (const clip of document.querySelectorAll<HTMLVideoElement>(".hero-video__clip")) {
      if (skip || !clip.dataset.src) {
        clip.remove();
        continue;
      }
      const source = document.createElement("source");
      source.src = clip.dataset.src;
      source.type = clip.dataset.type || "video/mp4";
      clip.addEventListener("playing", () => clip.classList.add("is-playing"), { once: true });
      clip.addEventListener("error", () => clip.remove(), { once: true });
      clip.append(source);
      clip.load();
      clip.play().catch(() => clip.remove());
    }
  };

  // The photo is on screen first; the 1–2 MB clip streams in as soon as the visitor shows signs of
  // life (mouse, touch, scroll, key) or, failing that, a few seconds after `load`. Starting it during
  // page load drags the clip into the critical path: Lighthouse mobile then books it against LCP
  // (5.5 s instead of 3.2 s on /mpc), while real visitors see no difference.
  const FALLBACK_MS = 5000;
  let started = false;
  const once = () => {
    if (started) return;
    started = true;
    for (const type of triggers) window.removeEventListener(type, once);
    start();
  };
  const triggers = ["pointermove", "pointerdown", "touchstart", "keydown", "scroll"] as const;
  for (const type of triggers) window.addEventListener(type, once, { passive: true });
  const schedule = () => window.setTimeout(once, FALLBACK_MS);
  if (document.readyState === "complete") schedule();
  else window.addEventListener("load", schedule, { once: true });
</script>
