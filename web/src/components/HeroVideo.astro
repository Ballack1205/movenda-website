---
// Hero of a fixed page with an optional muted looping video on top of the
// still (Pagina's → MPC → "Video bovenaan"). The still is always rendered:
// it is the LCP element, the poster while the video buffers, and the only
// thing shown when the visitor prefers reduced motion or the video fails.
//
// When a clip is set the still is drawn with the same CSS crop as the video
// (object-cover + object-top of the full image). A pre-cropped 4:3 Sanity URL
// is what made the clip jump onto a different part of the frame.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Pagina } from "../lib/content";
import PaginaFoto from "./PaginaFoto.astro";

export interface Props {
  pagina: Pick<Pagina, "foto" | "fotoHotspot" | "fotoAlt" | "heroVideo">;
  fallback: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  /** Classes for the box (aspect ratio, rounding, shadow). Photo and clip share them. */
  class?: string;
  priority?: boolean;
  /** Lab magazine covers: no card radius or drop shadow on the video wrapper. */
  flush?: boolean;
}

const { pagina, fallback, alt, width, height, class: className = "", priority, flush } = Astro.props;
const video = pagina.heroVideo;
const type = video?.toLowerCase().endsWith(".webm") ? "video/webm" : "video/mp4";
const posterSrc = pagina.foto ? `${pagina.foto}?w=1080&fit=max&auto=format` : undefined;
const posterAlt = pagina.fotoAlt || alt;
// The page passes object-top (right for the old gym still). A portrait clip in a
// landscape box then shows only the ceiling. Same crop on still + video, aimed
// at the subject, is what makes the photo appear to start moving.
const cropClass = className.replace(/\bobject-top\b/g, "object-[center_32%]");
---

{video ? (
  <div class:list={["hero-video relative overflow-hidden", flush ? "absolute inset-0 h-full w-full" : "md:rounded-3xl md:shadow-xl"]}>
    {posterSrc ? (
      <img
        src={posterSrc}
        alt={posterAlt}
        width={width}
        height={height}
        class={cropClass}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
      />
    ) : (
      <Image src={fallback} alt={posterAlt} width={width} height={height} class={cropClass} priority={priority} />
    )}
    <video
      class={`hero-video__clip absolute inset-0 h-full w-full object-cover object-[center_32%] ${cropClass}`}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      disablepictureinpicture
      data-src={video}
      data-type={type}
    ></video>
  </div>
) : (
  <PaginaFoto pagina={pagina} fallback={fallback} alt={alt} width={width} height={height} class={className} priority={priority} />
)}

<style>
  .hero-video__clip {
    opacity: 0;
    transition: opacity 1.4s ease-in-out;
    pointer-events: none;
  }
  .hero-video__clip.is-playing {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video__clip {
      display: none;
    }
  }
</style>

<script>
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const skip = window.matchMedia("(prefers-reduced-motion: reduce)").matches || connection?.saveData === true;

  function revealWhenPainted(clip: HTMLVideoElement) {
    const show = () => clip.classList.add("is-playing");
    const rvfc = (
      clip as HTMLVideoElement & {
        requestVideoFrameCallback?: (cb: () => void) => void;
      }
    ).requestVideoFrameCallback;
    if (typeof rvfc === "function") {
      rvfc.call(clip, show);
      return;
    }
    clip.addEventListener("playing", show, { once: true });
  }

  const start = () => {
    for (const clip of document.querySelectorAll<HTMLVideoElement>(".hero-video__clip")) {
      if (skip || !clip.dataset.src) {
        clip.remove();
        continue;
      }
      const source = document.createElement("source");
      source.src = clip.dataset.src;
      source.type = clip.dataset.type || "video/mp4";
      clip.addEventListener("error", () => clip.remove(), { once: true });
      revealWhenPainted(clip);
      clip.append(source);
      clip.load();
      clip.play().catch(() => clip.remove());
    }
  };

  const FALLBACK_MS = 5000;
  let started = false;
  const triggers = ["pointermove", "pointerdown", "touchstart", "keydown", "scroll"] as const;
  const once = () => {
    if (started) return;
    started = true;
    for (const type of triggers) window.removeEventListener(type, once);
    start();
  };
  for (const type of triggers) window.addEventListener(type, once, { passive: true });
  const schedule = () => window.setTimeout(once, FALLBACK_MS);
  if (document.readyState === "complete") schedule();
  else window.addEventListener("load", schedule, { once: true });
</script>
