---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../lib/schema";
import { withLang, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const path = `${prefix}/bookappointment`;
---

<Layout
  title={en ? "Appointment | Movenda" : "Afspraak | Movenda"}
  description={en ? "Book an appointment at Movenda or the Performance Centre." : "Plan een afspraak bij Movenda of het Performance Centre."}
  path={path}
  altPath={en ? "/bookappointment" : "/en/bookappointment"}
  lang={lang}
  jsonLd={[breadcrumbSchema([{ name: "Home", path: prefix || "/" }, { name: en ? "Appointment" : "Afspraak", path }])]}
>
  <section class="page-ink mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-3xl font-bold">{en ? "Appointment" : "Afspraak"}</h1>
    <p class="mt-4 text-brand-muted">
      {en
        ? "Answer a few short questions in our referral compass and book online straight away. In the booking calendar you pick your location and the right colleague."
        : "Beantwoord een paar korte vragen in ons verwijskompas en boek meteen online. In de agenda kies je je locatie en de juiste collega."}
    </p>
    <p class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
      <a class="font-semibold underline" href={`${withLang("/team", lang)}#keuzehulp`}>{en ? "Open the referral compass" : "Open het verwijskompas"}</a>
      <a class="text-brand-muted underline" href={withLang("/contact", lang)}>{en ? "Questions? Contact us" : "Vragen? Contacteer ons"}</a>
    </p>
  </section>
</Layout>
