---
import { getSiteSettings } from "../lib/content";
import BookingButton from "./BookingButton.astro";

export interface Props {
  brand?: "movenda" | "mpc";
  lang?: "nl" | "en";
  altPath?: string;
}

const { brand = "movenda", lang = "nl", altPath } = Astro.props;
const settings = await getSiteSettings();

const navMovendaNl = [
  { href: "/", label: "Home" },
  { href: "/over", label: "Over ons" },
  { href: "/kinesitherapie", label: "Kinesitherapie" },
  { href: "/training", label: "Training" },
  { href: "/team", label: "Team" },
  { href: "/prijzen", label: "Prijzen" },
  { href: "/blog", label: "Blog" },
  { href: "/faq", label: "FAQ" },
  { href: "/mpc", label: "MPC" },
  { href: "/contact", label: "Contact" },
];

const navMovendaEn = [
  { href: "/en", label: "Home" },
  { href: "/en/team", label: "Team" },
  { href: "/en/mpc", label: "MPC" },
  { href: "/en/contact", label: "Contact" },
];

const navMpc = [
  { href: "/mpc", label: "MPC Home" },
  { href: "/mpc/performance-training", label: "Performance" },
  { href: "/mpc/sportrevalidatie", label: "Sportrevalidatie" },
  { href: "/team", label: "Team" },
  { href: "/", label: "Movenda" },
  { href: "/contact", label: "Contact" },
];

const nav = brand === "mpc" ? navMpc : lang === "en" ? navMovendaEn : navMovendaNl;
const phone = brand === "mpc" ? settings.telefoonMpc : settings.telefoonOlympia;

// Language switcher target: use the explicit counterpart if the page
// declares one, otherwise fall back to each language's homepage — never a
// dead link (see DECISIONS.md: missing EN pages fall back gracefully).
const langSwitchHref = lang === "en" ? altPath || "/" : altPath || "/en";
---

<header class="bg-brand-header">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="flex items-center gap-2" aria-label="Movenda">
      {brand === "mpc" ? (
        <>
          <img src="/brand/logo-mpc.png" alt="" width="28" height="28" class="h-7 w-7" />
          <span class="font-heading text-lg font-bold tracking-tight text-white">
            Movenda Performance Centre
          </span>
        </>
      ) : (
        <img src="/brand/logo-wordmark.png" alt="Movenda" width="140" height="30" class="h-7 w-auto" />
      )}
    </a>
    <nav class="hidden gap-6 text-sm font-medium md:flex">
      {nav.map((item) => (
        <a href={item.href} class="text-white/80 transition hover:text-white">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a
        href={`tel:${phone.replace(/\s+/g, "")}`}
        class="hidden text-sm font-semibold text-white sm:inline"
      >
        {phone}
      </a>
      <a
        href={langSwitchHref}
        class="rounded-full border border-white/30 px-3 py-1.5 text-xs font-semibold text-white/80 transition hover:border-white hover:text-white"
        aria-label={lang === "en" ? "Bekijk in het Nederlands" : "View in English"}
      >
        {lang === "en" ? "NL" : "EN"}
      </a>
      <BookingButton size="sm" />
    </div>
  </div>
</header>
