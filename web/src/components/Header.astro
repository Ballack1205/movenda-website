---
import BookingButton from "./BookingButton.astro";

export interface Props {
  brand?: "movenda" | "mpc";
  lang?: "nl" | "en";
  altPath?: string;
}

const { brand = "movenda", lang = "nl", altPath } = Astro.props;

type NavItem = { href: string; label: string; emphasize?: boolean };

const navMovendaNl: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/over", label: "Over ons" },
  { href: "/kinesitherapie", label: "Kinesitherapie" },
  { href: "/training", label: "Training" },
  { href: "/team", label: "Team" },
  { href: "/prijzen", label: "Prijzen" },
  { href: "/blog", label: "Blog" },
  { href: "/faq", label: "FAQ" },
  { href: "/mpc", label: "MPC", emphasize: true },
  { href: "/contact", label: "Contact" },
];

const navMovendaEn: NavItem[] = [
  { href: "/en", label: "Home" },
  { href: "/en/team", label: "Team" },
  { href: "/en/mpc", label: "MPC", emphasize: true },
  { href: "/en/contact", label: "Contact" },
];

const navMpc: NavItem[] = [
  { href: "/mpc", label: "MPC Home" },
  { href: "/mpc/performance-training", label: "Performance" },
  { href: "/mpc/sportrevalidatie", label: "Sportrevalidatie" },
  { href: "/team", label: "Team" },
  { href: "/", label: "Movenda" },
  { href: "/contact", label: "Contact" },
];

const nav = brand === "mpc" ? navMpc : lang === "en" ? navMovendaEn : navMovendaNl;

// Language switcher target: use the explicit counterpart if the page
// declares one, otherwise fall back to each language's homepage — never a
// dead link (see DECISIONS.md: missing EN pages fall back gracefully).
const langSwitchHref = lang === "en" ? altPath || "/" : altPath || "/en";

const linkClass = (emphasize?: boolean) =>
  emphasize
    ? "font-bold text-white transition hover:text-white"
    : "text-white/80 transition hover:text-white";
---

<header class="bg-brand-header" data-header>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a
      href={brand === "mpc" ? "/mpc" : "/"}
      class="flex items-center gap-2"
      aria-label={brand === "mpc" ? "Movenda Performance Centre" : "Movenda"}
    >
      {brand === "mpc" ? (
        <>
          <img src="/brand/logo-mpc.png" alt="" width="28" height="28" class="h-7 w-7" />
          <span class="font-heading text-lg font-bold tracking-tight text-white">MPC</span>
        </>
      ) : (
        <img src="/brand/logo-wordmark.png" alt="Movenda" width="140" height="30" class="h-7 w-auto" />
      )}
    </a>
    <nav class:list={["hidden gap-6 text-sm md:flex", brand === "mpc" ? "font-semibold" : "font-medium"]}>
      {nav.map((item) => (
        <a href={item.href} class={linkClass(item.emphasize)}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a
        href={langSwitchHref}
        class="rounded-full border border-white/30 px-3 py-1.5 text-xs font-semibold text-white/80 transition hover:border-white hover:text-white"
        aria-label={lang === "en" ? "Bekijk in het Nederlands" : "View in English"}
      >
        {lang === "en" ? "NL" : "EN"}
      </a>
      <BookingButton size="sm" />
      <button
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 text-white md:hidden"
        aria-label={lang === "en" ? "Open menu" : "Menu openen"}
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-icon-open>
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden" data-icon-close>
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav: hidden until toggled; desktop uses the inline nav above. -->
  <nav id="mobile-nav" class="hidden border-t border-white/10 md:hidden" data-mobile-nav>
    <div class="mx-auto flex max-w-6xl flex-col px-4 py-3">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "py-2.5 text-base transition hover:text-white",
            item.emphasize ? "font-bold text-white" : "font-medium text-white/90",
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = header?.querySelector<HTMLElement>("[data-mobile-nav]");
  const iconOpen = toggle?.querySelector("[data-icon-open]");
  const iconClose = toggle?.querySelector("[data-icon-close]");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    panel?.classList.toggle("hidden", open);
    iconOpen?.classList.toggle("hidden", !open);
    iconClose?.classList.toggle("hidden", open);
  });
</script>
