---
import BookingButton from "./BookingButton.astro";
import { getSportaanbod } from "../lib/content";

export interface Props {
  brand?: "movenda" | "mpc";
  lang?: "nl" | "en";
  altPath?: string;
}

const { brand = "movenda", lang = "nl", altPath } = Astro.props;
const sportaanbod = await getSportaanbod();

type NavItem = { href: string; label: string; emphasize?: boolean; external?: boolean };

const navMovendaNl: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/over", label: "Over ons" },
  { href: "/kinesitherapie", label: "Kinesitherapie" },
  { href: "/training", label: "Training" },
  { href: "/team", label: "Team" },
  { href: "/prijzen", label: "Prijzen" },
  { href: "/faq", label: "FAQ" },
  { href: "/blog", label: "Blog" },
  { href: "/mpc", label: "MPC", emphasize: true },
  { href: "/contact", label: "Contact" },
];

const navMovendaEn: NavItem[] = [
  { href: "/en", label: "Home" },
  { href: "/en/team", label: "Team" },
  { href: "/en/mpc", label: "MPC", emphasize: true },
  { href: "/en/contact", label: "Contact" },
];

const navMpc: NavItem[] = [
  { href: "/mpc", label: "Training" },
  { href: "/mpc/sportrevalidatie", label: "Sportrevalidatie" },
  { href: "/mpc/groepslessen", label: "Groepslessen" },
  { href: "/mpc/visie", label: "Visie" },
  { href: "/team", label: "Team" },
  { href: "/mpc#faq", label: "FAQ" },
  { href: "/mpc/prijzen", label: "Prijzen" },
  { href: "/", label: "Movenda", emphasize: true },
  { href: "/contact", label: "Contact" },
];

const nav = brand === "mpc" ? navMpc : lang === "en" ? navMovendaEn : navMovendaNl;
const langSwitchHref = lang === "en" ? altPath || "/" : altPath || "/en";

const linkClass = (emphasize?: boolean) =>
  emphasize
    ? "font-bold text-white transition hover:text-white"
    : "text-white/80 transition hover:text-white";
---

<header class="bg-brand-header" data-header>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-4">
    <a
      href={brand === "mpc" ? "/mpc" : "/"}
      class="flex shrink-0 items-center gap-2"
      aria-label={brand === "mpc" ? "Movenda Performance Centre" : "Movenda"}
    >
      {brand === "mpc" ? (
        <img src="/brand/logo-mpc.png" alt="MPC" width="40" height="40" class="h-10 w-10" />
      ) : (
        <img src="/brand/logo-wordmark.png" alt="Movenda" width="140" height="30" class="h-7 w-auto" />
      )}
    </a>
    <nav
      class:list={[
        "hidden min-w-0 items-center text-sm",
        brand === "mpc" ? "xl:flex xl:gap-3.5 font-semibold" : "lg:flex lg:gap-5 font-medium",
      ]}
    >
      {nav.map((item) => (
        <a href={item.href} class:list={[linkClass(item.emphasize), "whitespace-nowrap"]}>
          {item.label}
        </a>
      ))}
      {brand === "movenda" && lang === "nl" && sportaanbod.length > 0 && (
        <details class="relative">
          <summary class="cursor-pointer list-none text-white/80 hover:text-white [&::-webkit-details-marker]:hidden">
            Sportaanbod Olympia
          </summary>
          <div class="absolute right-0 z-20 mt-2 min-w-56 rounded-xl border border-white/10 bg-brand-header p-2 shadow-xl">
            {sportaanbod.map((item) => (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="block rounded-lg px-3 py-2 text-sm text-white/80 hover:bg-white/10 hover:text-white"
              >
                {item.naam}
              </a>
            ))}
          </div>
        </details>
      )}
    </nav>
    <div class="flex shrink-0 items-center gap-3">
      <a
        href={langSwitchHref}
        class="rounded-full border border-white/30 px-3 py-1.5 text-xs font-semibold text-white/80 transition hover:border-white hover:text-white"
        aria-label={lang === "en" ? "Bekijk in het Nederlands" : "View in English"}
      >
        {lang === "en" ? "NL" : "EN"}
      </a>
      <BookingButton size="sm" />
      <button
        type="button"
        class:list={[
          "inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 text-white",
          brand === "mpc" ? "xl:hidden" : "lg:hidden",
        ]}
        aria-label={lang === "en" ? "Open menu" : "Menu openen"}
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-icon-open>
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden" data-icon-close>
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class:list={["hidden border-t border-white/10", brand === "mpc" ? "xl:hidden" : "lg:hidden"]}
    data-mobile-nav
  >
    <div class="mx-auto flex max-w-6xl flex-col px-4 py-3">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "py-2.5 text-base transition hover:text-white",
            item.emphasize ? "font-bold text-white" : "font-medium text-white/90",
          ]}
        >
          {item.label}
        </a>
      ))}
      {brand === "movenda" && lang === "nl" && sportaanbod.map((item) => (
        <a href={item.link} target="_blank" rel="noopener noreferrer" class="py-2.5 text-base font-medium text-white/90">
          {item.naam}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = header?.querySelector<HTMLElement>("[data-mobile-nav]");
  const iconOpen = toggle?.querySelector("[data-icon-open]");
  const iconClose = toggle?.querySelector("[data-icon-close]");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    panel?.classList.toggle("hidden", open);
    iconOpen?.classList.toggle("hidden", !open);
    iconClose?.classList.toggle("hidden", open);
  });
</script>
