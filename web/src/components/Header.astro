---
// Site header: logo · primary nav (with dropdowns) · language switch · CTA · menu button.
//
// Breakpoints (measured, see chat 2026-09-10 "header review"):
//   Movenda: 6 items + CTA ≈ 730px → desktop nav from `md` (768). Hamburger on phones only.
//   MPC:     7 items with long Dutch labels (Sportrevalidatie, Groepslessen) ≈ 800px
//            → desktop nav from `lg` (1024). iPad portrait gets the grouped panel.
// Nav structure lives in src/lib/nav.ts; dropdown contents come from the CMS.
import { getNavModel, isActiveItem, isCurrentPath } from "../lib/nav";
import NavCluster from "./NavCluster.astro";
import { mpcHomePath, movendaHomeHref, THEME } from "../lib/site";

export interface Props {
  brand?: "movenda" | "mpc";
  lang?: "nl" | "en";
  /** Current page path, used for aria-current / active state. */
  path?: string;
  altPath?: string;
}

const { brand = "movenda", lang = "nl", path = "/", altPath } = Astro.props;
const { items, cta, phone, contact } = await getNavModel(brand, lang);
const lab = THEME === "lab";
const brief = lab;
const leftItems = items.filter((item) => item.side === "start");
const rightItems = items.filter((item) => item.side !== "start");
const logoHref = brief ? movendaHomeHref(lang) : brand === "mpc" ? mpcHomePath(lang) : movendaHomeHref(lang);
const logoExternal = /^https?:/.test(logoHref);

const langSwitchHref = lang === "en" ? altPath || "/" : altPath || "/en";
// `md:` for Movenda, `lg:` for MPC. The brief bar (centered wordmark plus
// Aanbod and Over ons / Contact / Afspraak / EN) only fits from 960px;
// narrower widths keep the hamburger.
const desktop = brief ? "brief" : brand === "mpc" ? "lg" : "md";
const showDesktop =
  desktop === "lg" ? "lg:flex" : desktop === "brief" ? "min-[960px]:flex" : "md:flex";
const hideDesktop =
  desktop === "lg" ? "lg:hidden" : desktop === "brief" ? "min-[960px]:hidden" : "md:hidden";
const hideBarExtra =
  desktop === "lg" ? "max-lg:hidden" : desktop === "brief" ? "max-[959px]:hidden" : "max-md:hidden";
// Sticky only while the hamburger is in use, so the overlay panel is always
// anchored to a visible bar. Desktop keeps the static header.
const stickyMobile =
  desktop === "lg"
    ? "sticky top-0 lg:static"
    : desktop === "brief"
      ? "sticky top-0 min-[960px]:static"
      : "sticky top-0 md:static";
const desktopMinWidth = desktop === "lg" ? "64rem" : desktop === "brief" ? "60rem" : "48rem";

const t = {
  openMenu: lang === "en" ? "Open menu" : "Menu openen",
  closeMenu: lang === "en" ? "Close menu" : "Menu sluiten",
  submenu: lang === "en" ? "Open submenu" : "Submenu openen",
  call: lang === "en" ? "Call" : "Bel",
  langSwitch: lang === "en" ? "Bekijk in het Nederlands" : "View in English",
  external: lang === "en" ? "(opens in a new tab)" : "(opent in een nieuw tabblad)",
  brandName: brand === "mpc" ? "Movenda Performance Centre" : "Movenda",
};

const slug = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const telHref = (nr: string) => `tel:${nr.replace(/\s+/g, "")}`;

// Groups (items with children) drive the panel columns; plain links are pooled in one list.
const groups = items.filter((i) => i.children && i.children.length > 0);
const plain = items.filter((i) => !i.children || i.children.length === 0);
---

<header
  class:list={[
    "relative z-40",
    lab ? "border-b border-brand-border bg-brand-bg text-brand-text" : "bg-brand-header text-white",
    stickyMobile,
  ]}
  data-header
  data-desktop-min={desktopMinWidth}
>
  <div
    class:list={[
      "relative z-50 mx-auto items-center gap-3 px-4 py-4",
      brief
        ? "grid w-full grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]"
        : "flex max-w-6xl justify-between xl:gap-6",
    ]}
  >
    {brief && (
      <div class:list={["hidden min-w-0 items-center gap-4", showDesktop]}>
        <nav
          class="min-w-0 text-[13px] font-medium xl:text-sm"
          aria-label={lang === "en" ? "Offer" : "Aanbod"}
        >
          <NavCluster items={leftItems} path={path} lab={lab} externalLabel={t.external} />
        </nav>
        <form action={lang === "en" ? "/en/zoeken" : "/zoeken"} method="get" role="search" class="shrink-0">
          <label class="sr-only" for="site-search">{lang === "en" ? "Search" : "Zoeken"}</label>
          <input id="site-search" name="q" type="search" placeholder={lang === "en" ? "Search" : "Zoeken"} class="w-28 border-b border-current bg-transparent px-1 py-1 text-sm outline-none placeholder:text-current/60" />
        </form>
      </div>
    )}
    <a
      href={logoHref}
      data-logo
      class:list={["flex shrink-0 items-center gap-2", brief && "justify-self-center"]}
      aria-label={t.brandName}
      target={logoExternal ? "_blank" : undefined}
      rel={logoExternal ? "noopener noreferrer" : undefined}
    >
      {brand === "mpc" && !brief ? (
        <img src="/brand/logo-mpc.png" alt="MPC" width="40" height="40" class="h-10 w-10" />
      ) : lab ? (
        <>
          <img
            src="/brand/logo-wordmark-on-light.png"
            alt="Movenda"
            width="140"
            height="30"
            class="logo-on-light h-6 w-auto xl:h-7"
          />
          <img
            src="/brand/logo-wordmark-on-dark.png"
            alt=""
            width="140"
            height="30"
            class="logo-on-dark hidden h-6 w-auto xl:h-7"
          />
        </>
      ) : (
        <img src="/brand/logo-wordmark.png" alt="Movenda" width="140" height="30" class="h-6 w-auto xl:h-7" />
      )}
    </a>

    {!brief && (
    <nav
      class:list={["hidden min-w-0 flex-1 items-center justify-center text-[13px] font-medium xl:text-sm", showDesktop]}
      aria-label={lang === "en" ? "Main navigation" : "Hoofdnavigatie"}
    >
      <ul class="flex items-center gap-0.5 xl:gap-2">
        {items.map((item) => {
          const active = isActiveItem(item, path);
          const base = [
            "inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2 py-1.5 transition xl:px-3",
            lab
              ? item.emphasize
                ? "font-bold text-brand-text"
                : "text-brand-text/80 hover:text-brand-text"
              : item.emphasize
                ? "font-bold text-white"
                : "text-white/80 hover:text-white",
            lab
              ? active
                ? "bg-black/5 text-brand-text"
                : "hover:bg-black/5"
              : active
                ? "bg-white/10 text-white"
                : "hover:bg-white/10",
          ];
          if (!item.children || item.children.length === 0) {
            return (
              <li>
                <a
                  href={item.href}
                  class:list={base}
                  aria-current={isCurrentPath(item.href, path) ? "page" : undefined}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          }
          const id = `nav-${slug(item.label)}`;
          const wide = item.children.length > 7;
          return (
            <li class="relative" data-nav-group>
              <button
                type="button"
                class:list={[...base, "group"]}
                aria-expanded="false"
                aria-controls={id}
                aria-current={active ? "true" : undefined}
                data-nav-trigger
              >
                {item.label}
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="transition-transform duration-200 group-aria-expanded:rotate-180"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
              <div
                id={id}
                class:list={[
                  "absolute left-0 top-full z-20 hidden max-w-[calc(100vw-1rem)] pt-3",
                  wide ? "w-[34rem]" : "w-64",
                ]}
                data-nav-panel
              >
                <ul
                  class:list={[
                    "rounded-xl border border-white/10 bg-brand-header p-2 shadow-xl",
                    wide ? "grid grid-cols-2 gap-x-2" : "",
                  ]}
                >
                  {item.children.map((child, index) => (
                    <li class:list={[index === 0 ? "col-span-full mb-1 border-b border-white/10 pb-1" : ""]}>
                      <a
                        href={child.href}
                        target={child.external ? "_blank" : undefined}
                        rel={child.external ? "noopener noreferrer" : undefined}
                        aria-current={isCurrentPath(child.href, path) ? "page" : undefined}
                        class:list={[
                          "flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm transition hover:bg-white/10 hover:text-white",
                          index === 0 ? "font-semibold text-white" : "text-white/80",
                          isCurrentPath(child.href, path) ? "bg-white/10 text-white" : "",
                        ]}
                      >
                        <span>{child.label}</span>
                        {index === 0 && !child.external && <span aria-hidden="true">→</span>}
                        {child.external && (
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-70">
                            <path d="M7 17 17 7M8 7h9v9" />
                          </svg>
                        )}
                        {child.external && <span class="sr-only">{t.external}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })}
      </ul>
    </nav>
    )}

    <div class:list={["flex shrink-0 items-center gap-2 sm:gap-3", brief && "justify-self-end"]}>
      {brief && (
        <nav
          class:list={["hidden text-[13px] font-medium xl:text-sm", showDesktop]}
          aria-label={lang === "en" ? "Main navigation" : "Hoofdnavigatie"}
        >
          <NavCluster items={rightItems} path={path} lab={lab} externalLabel={t.external} align="end" />
        </nav>
      )}
      <a
        href={langSwitchHref}
        class:list={[
          "inline-flex items-center rounded-full border border-white/30 px-3 py-1.5 text-xs font-semibold text-white/80 transition hover:border-white hover:text-white",
          lab && "min-h-11",
          lab && hideBarExtra,
        ]}
        aria-label={t.langSwitch}
        data-lab-bar-extra
      >
        {lang === "en" ? "NL" : "EN"}
      </a>
      {!brief && (
      <a
        href={cta.href}
        target={cta.external ? "_blank" : undefined}
        rel={cta.external ? "noopener noreferrer" : undefined}
        class:list={[
          "hidden whitespace-nowrap rounded-full bg-white px-3 py-1.5 text-[13px] font-semibold text-brand-header transition hover:bg-white/90 min-[360px]:inline-flex xl:px-3.5 xl:text-sm",
          lab && "min-h-11 items-center",
          lab && (desktop === "lg" ? "max-lg:!hidden lg:!inline-flex" : "max-md:!hidden md:!inline-flex"),
        ]}
        data-cta={cta === contact ? "contact" : "booking"}
        data-lab-bar-extra
      >
        {cta.label}
      </a>
      )}
      <button
        type="button"
        class:list={[
          "inline-flex items-center justify-center rounded-full border border-white/30 text-white transition hover:border-white",
          lab ? "h-11 w-11" : "h-9 w-9",
          hideDesktop,
        ]}
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-icon-open>
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="hidden" data-icon-close>
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  {lab ? (
  <nav
    id="mobile-nav"
    class:list={[
      "lab-menu fixed inset-0 top-0 z-30 hidden overflow-y-auto pt-[5.5rem]",
      hideDesktop,
    ]}
    aria-label={lang === "en" ? "Menu" : "Menu"}
    data-mobile-nav
  >
    <div class="mx-auto flex min-h-[calc(100dvh-5.5rem)] max-w-lg flex-col px-5 pb-[max(2rem,env(safe-area-inset-bottom))]">
      <form action={lang === "en" ? "/en/zoeken" : "/zoeken"} method="get" role="search" class="mb-6">
        <label class="sr-only" for="site-search-mobile">{lang === "en" ? "Search" : "Zoeken"}</label>
        <input id="site-search-mobile" name="q" type="search" placeholder={lang === "en" ? "Search" : "Zoeken"} class="w-full border-b border-current bg-transparent px-1 py-2 text-lg outline-none" />
      </form>
      <ol class="flex flex-col gap-1">
        {items.map((item, i) => {
          const nested = (item.groups && item.groups.length > 0) || (item.children && item.children.length > 0);
          const index = String(i + 1).padStart(2, "0");
          return (
            <li>
              {nested ? (
                <details>
                  <summary class="lab-menu__item">
                    <span class="lab-menu__index" aria-hidden="true">{index}</span>
                    <span class="lab-menu__label">{item.label}</span>
                  </summary>
                  <div class="lab-menu__sub">
                    {item.groups?.map((group) => (
                      <div>
                        <a href={group.href}>{group.label}</a>
                        {group.children.map((child) =>
                          child.heading ? (
                            <p class="lab-menu__heading">{child.label}</p>
                          ) : (
                            <a href={child.href}>{child.label}</a>
                          ),
                        )}
                      </div>
                    ))}
                    {item.children?.map((child) => (
                      <a href={child.href}>{child.label}</a>
                    ))}
                  </div>
                </details>
              ) : (
                <a
                  href={item.href}
                  aria-current={isCurrentPath(item.href, path) ? "page" : undefined}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class:list={["lab-menu__item", item.button && "lab-menu__item--cta"]}
                >
                  <span class="lab-menu__index" aria-hidden="true">{index}</span>
                  <span class="lab-menu__label">{item.label}</span>
                </a>
              )}
            </li>
          );
        })}
      </ol>
      <div class="mt-auto flex flex-col gap-3 border-t border-brand-border pt-8">
        {!brief && (
        <a href={cta.href} class="lab-menu__cta" data-cta={cta === contact ? "contact" : "booking"}>
          {cta.label}
        </a>
        )}
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <a href={langSwitchHref}>{lang === "en" ? "Nederlands" : "English"}</a>
          {phone && <a href={telHref(phone)}>{phone}</a>}
        </div>
      </div>
    </div>
  </nav>
  ) : (
  <nav
    id="mobile-nav"
    class:list={[
      "absolute inset-x-0 top-full hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-white/10 bg-brand-header shadow-2xl",
      hideDesktop,
    ]}
    aria-label={lang === "en" ? "Menu" : "Menu"}
    data-mobile-nav
  >
    <div class="mx-auto max-w-6xl px-4 py-5">
      <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {/* Phones: collapsed accordions (open the active one). Tablets (sm+): always expanded columns, summary is a plain heading. Script below keeps `open` in sync. */}
        {groups.map((group) => (
          <details class="group/acc" open data-mnav-group data-active={isActiveItem(group, path) ? "true" : undefined}>
            <summary
              class:list={[
                "flex cursor-pointer list-none items-center justify-between rounded-lg px-2 py-2 font-heading text-base font-semibold text-white [&::-webkit-details-marker]:hidden sm:pointer-events-none sm:cursor-default",
                isActiveItem(group, path) ? "bg-white/10" : "",
              ]}
            >
              {group.label}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-white/60 transition-transform duration-200 group-open/acc:rotate-180 sm:hidden">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <ul class="mt-1 border-l border-white/15 pl-1">
              <li>
                <a
                  href={group.children![0].href}
                  aria-current={isCurrentPath(group.children![0].href, path) ? "page" : undefined}
                  class:list={[
                    "flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-white transition hover:bg-white/10",
                    isCurrentPath(group.children![0].href, path) ? "bg-white/10" : "",
                  ]}
                >
                  <span>{group.children![0].label}</span>
                  <span aria-hidden="true" class="text-white/60">→</span>
                </a>
              </li>
              {group.children!.slice(1).map((child) => (
                <li>
                  <a
                    href={child.href}
                    target={child.external ? "_blank" : undefined}
                    rel={child.external ? "noopener noreferrer" : undefined}
                    aria-current={isCurrentPath(child.href, path) ? "page" : undefined}
                    class:list={[
                      "flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-white/80 transition hover:bg-white/10 hover:text-white",
                      isCurrentPath(child.href, path) ? "bg-white/10 text-white" : "",
                    ]}
                  >
                    <span>{child.label}</span>
                    {child.external && (
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-70">
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                    )}
                    {child.external && <span class="sr-only">{t.external}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}

        {plain.length > 0 && (
          <ul class="flex flex-col">
            {plain.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrentPath(item.href, path) ? "page" : undefined}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class:list={[
                    "flex items-center justify-between rounded-lg px-2 py-2 font-heading text-base text-white transition hover:bg-white/10",
                    item.emphasize ? "font-bold" : "font-semibold",
                    isCurrentPath(item.href, path) ? "bg-white/10" : "",
                  ]}
                >
                  {item.label}
                  <span aria-hidden="true" class="text-white/60">→</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-white/10 pt-5">
        <a
          href={cta.href}
          target={cta.external ? "_blank" : undefined}
          rel={cta.external ? "noopener noreferrer" : undefined}
          class="inline-flex items-center rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-brand-header transition hover:bg-white/90"
        >
          {cta.label}
        </a>
        {cta !== contact && (
          <a href={contact.href} class="inline-flex items-center rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-white transition hover:border-white">
            {contact.label}
          </a>
        )}
        {phone && (
          <a href={telHref(phone)} class="inline-flex items-center gap-2 px-2 py-2 text-sm font-medium text-white/90 hover:text-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
            </svg>
            <span class="sr-only">{t.call} </span>{phone}
          </a>
        )}
      </div>
    </div>
  </nav>
  )}
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  // --- Desktop dropdowns -------------------------------------------------
  // Click/tap toggles (works on touch); mouse hover opens with a short delay
  // and closes with a grace period. Esc, outside click and focus leaving the
  // group all close it. Wide panels (Training, Kinesitherapie, Groepslessen)
  // are shifted so they stay inside the viewport — flipping to right-0 used
  // to push a 34rem menu off the left edge on tablets.
  const groups = Array.from(header?.querySelectorAll<HTMLElement>("[data-nav-group]") ?? []);
  const HOVER_OPEN_MS = 80;
  const HOVER_CLOSE_MS = 180;
  const GUTTER = 8;

  const placePanel = (panel: HTMLElement) => {
    panel.style.left = "0px";
    panel.style.right = "auto";
    const rect = panel.getBoundingClientRect();
    const min = GUTTER;
    const max = window.innerWidth - GUTTER;
    let left = rect.left;
    if (rect.right > max) left -= rect.right - max;
    if (left < min) left = min;
    const parentLeft = (panel.offsetParent as HTMLElement | null)?.getBoundingClientRect().left ?? 0;
    panel.style.left = `${Math.round(left - parentLeft)}px`;
  };

  const setOpen = (group: HTMLElement, open: boolean) => {
    const trigger = group.querySelector<HTMLButtonElement>("[data-nav-trigger]");
    const panel = group.querySelector<HTMLElement>("[data-nav-panel]");
    if (!trigger || !panel) return;
    trigger.setAttribute("aria-expanded", String(open));
    panel.classList.toggle("hidden", !open);
    if (open) placePanel(panel);
    else {
      panel.style.left = "";
      panel.style.right = "";
    }
  };
  const closeAll = (except?: HTMLElement) => groups.forEach((g) => g !== except && setOpen(g, false));
  const isOpen = (group: HTMLElement) =>
    group.querySelector("[data-nav-trigger]")?.getAttribute("aria-expanded") === "true";

  groups.forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>("[data-nav-trigger]");
    let timer: number | undefined;
    const clear = () => window.clearTimeout(timer);

    trigger?.addEventListener("click", () => {
      const open = isOpen(group);
      closeAll(group);
      setOpen(group, !open);
    });

    group.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      clear();
      timer = window.setTimeout(() => {
        closeAll(group);
        setOpen(group, true);
      }, HOVER_OPEN_MS);
    });
    group.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "mouse") return;
      clear();
      timer = window.setTimeout(() => setOpen(group, false), HOVER_CLOSE_MS);
    });

    group.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !group.contains(next)) setOpen(group, false);
    });
  });

  window.addEventListener("resize", () => {
    groups.forEach((g) => {
      if (!isOpen(g)) return;
      const panel = g.querySelector<HTMLElement>("[data-nav-panel]");
      if (panel) placePanel(panel);
    });
  });

  // --- Mobile / tablet panel ---------------------------------------------
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = header?.querySelector<HTMLElement>("[data-mobile-nav]");
  const iconOpen = toggle?.querySelector("[data-icon-open]");
  const iconClose = toggle?.querySelector("[data-icon-close]");

  const setMenu = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "");
    panel.classList.toggle("hidden", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    document.body.classList.toggle("overflow-hidden", open);
  };
  const menuOpen = () => toggle?.getAttribute("aria-expanded") === "true";

  toggle?.addEventListener("click", () => setMenu(!menuOpen()));

  // Panel groups: accordions on phones (only the active group open), always
  // expanded from `sm` up where there is room for columns.
  const accordions = Array.from(panel?.querySelectorAll<HTMLDetailsElement>("[data-mnav-group]") ?? []);
  const columnsQuery = window.matchMedia("(min-width: 40rem)");
  const syncAccordions = () =>
    accordions.forEach((d) => {
      d.open = columnsQuery.matches || d.dataset.active === "true";
    });
  syncAccordions();
  columnsQuery.addEventListener("change", syncAccordions);

  // If the viewport grows past the breakpoint while the panel is open, the
  // panel is hidden by CSS but the body scroll lock would linger. Reset.
  const desktopQuery = window.matchMedia(`(min-width: ${header?.dataset.desktopMin ?? "48rem"})`);
  desktopQuery.addEventListener("change", (e) => {
    if (e.matches && menuOpen()) setMenu(false);
  });

  // --- Shared: Esc + outside click ----------------------------------------
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const openGroup = groups.find(isOpen);
    if (openGroup) {
      setOpen(openGroup, false);
      openGroup.querySelector<HTMLButtonElement>("[data-nav-trigger]")?.focus();
    }
    if (menuOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });
  document.addEventListener("pointerdown", (event) => {
    const target = event.target as Node | null;
    if (!header || !target) return;
    if (!header.contains(target)) {
      closeAll();
      if (menuOpen()) setMenu(false);
      return;
    }
    // Inside the header but outside every open group: close dropdowns.
    groups.forEach((g) => {
      if (isOpen(g) && !g.contains(target)) setOpen(g, false);
    });
  });
</script>
