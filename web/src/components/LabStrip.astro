---
// Three-up magazine strip (LAB 01–03 / Brick club cards). Photos from Sanity.
import type { ImageMetadata } from "astro";
import CmsFoto from "./CmsFoto.astro";
import type { CmsFoto as CmsFotoType } from "../lib/content";

interface Item {
  n: number;
  href: string;
  title: string;
  line?: string;
  body?: string;
  /** Wider at rest. Kinesitherapie and Performance on the brief homepage. */
  lead?: boolean;
  foto?: CmsFotoType;
  fallback: ImageMetadata;
  alt: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="lab-strip" data-reveal>
  <div class="lab-strip__grid" style={`--doors: ${items.length}`}>
    {items.map((item) => (
      <a href={item.href} class:list={["lab-strip__card", item.body && "lab-strip__card--copy", item.lead && "lab-strip__card--lead"]}>
        <CmsFoto
          foto={item.foto}
          fallback={item.fallback}
          alt={item.alt}
          width={900}
          height={1200}
          class="lab-strip__photo"
        />
        {item.body && <span class="lab-strip__body">{item.body}</span>}
        <span class="lab-strip__copy">
          <span class="lab-strip__meta">
            <span class="lab-shout lab-strip__title">{item.title}</span>
            {item.line && <span class="lab-strip__line">{item.line}</span>}
          </span>
          <span class="lab-strip__arrow" aria-hidden="true">↗</span>
        </span>
      </a>
    ))}
    </div>
</section>

<script>
  // Phones have no hover. After a swipe settles, the door in the middle grows
  // and the others give up width — the same shift as a desktop hover.
  const desktop = window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 768px)");

  document.querySelectorAll<HTMLElement>(".lab-strip__grid").forEach((grid) => {
    const cards = [...grid.querySelectorAll<HTMLElement>(".lab-strip__card")];
    if (cards.length === 0) return;
    let current = -1;
    let timer = 0;

    const mark = () => {
      if (desktop.matches) {
        if (current !== -1) {
          current = -1;
          cards.forEach((card) => card.classList.remove("is-open"));
        }
        return;
      }
      const mid = grid.getBoundingClientRect().left + grid.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      cards.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - mid);
        if (dist < bestDist) {
          best = i;
          bestDist = dist;
        }
      });
      if (best === current) return;
      current = best;
      cards.forEach((card, i) => card.classList.toggle("is-open", i === best));
    };

    const schedule = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(mark, 140);
    };

    grid.addEventListener("scroll", schedule, { passive: true });
    grid.addEventListener("scrollend", () => {
      window.clearTimeout(timer);
      mark();
    });
    desktop.addEventListener("change", mark);
    mark();
  });
</script>
