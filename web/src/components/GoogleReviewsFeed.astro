---
/**
 * Homepage Google Reviews block — same Elfsight widget as movenda.be
 * ("Untitled Google Reviews"). Placed below the curated getuigenissen
 * carousel: that carousel is hand-picked photo quotes Julie edits in
 * Sanity, this block is the live, unfiltered feed straight from Google
 * (real names, real dates, real star ratings — Elfsight pulls it from
 * the Google Business Profile, same Elfsight plan as the Instagram feed,
 * no new SaaS). Julie can hide it or swap the widget ID in
 * Site-instellingen.
 */
import type { SiteSettings } from "../lib/content";

interface Props {
  settings: SiteSettings;
  lang?: "nl" | "en";
}

const { settings, lang = "nl" } = Astro.props;
const feed = settings.googleReviewsFeed;
const widgetId = feed.widgetId?.trim();
const show = feed.enabled && !!widgetId;
const olympiaReviews = settings.googleReviews.olympia;

const heading = feed.titel || "Google Reviews";
const fallbackLabel = lang === "en" ? "Read our Google reviews" : "Lees onze Google reviews";
---

{
  show && (
    <section class="google-reviews-feed scroll-mt-24 px-4 pb-0" aria-labelledby="google-reviews-heading">
      <div class="mx-auto max-w-6xl">
        <h2 id="google-reviews-heading" class="brief-kicker">
          {heading}
        </h2>

        <div class="google-reviews-widget mt-6">
          <div class={`elfsight-app-${widgetId}`} data-elfsight-app-lazy></div>
        </div>
        <script is:inline>
          // Elfsight resizes the card to each review as the slide starts, so the
          // box pops and the page below shifts. Pin the track to the tallest
          // review and only animate the horizontal move.
          (function () {
            var root = document.currentScript && document.currentScript.previousElementSibling;
            if (!root) return;
            var styleEl = null;
            var locked = 0;

            function contentHeight(slide) {
              var card = slide.querySelector(".es-review-background-container");
              var inner = slide.querySelector(".es-review-align-container");
              if (!card || !inner) return slide.scrollHeight;
              var cs = getComputedStyle(card);
              var pad = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
              var border = parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
              return Math.ceil(inner.offsetHeight + pad + border);
            }

            function settle() {
              var host = root.querySelector(".es-embed-root");
              var shadow = host && host.shadowRoot;
              var swiperEl = shadow && shadow.querySelector(".swiper");
              var swiper = swiperEl && swiperEl.swiper;
              if (!swiper) return false;
              var slides = shadow.querySelectorAll(".swiper-slide");
              if (!slides.length) return false;
              var max = 0;
              for (var i = 0; i < slides.length; i++) max = Math.max(max, contentHeight(slides[i]));
              if (max < 80) return false;
              swiper.params.autoHeight = false;
              swiper.params.speed = 640;
              if (max <= locked + 1 && styleEl && styleEl.parentNode === shadow) return true;
              locked = max;
              if (!styleEl || styleEl.parentNode !== shadow) {
                styleEl = document.createElement("style");
                shadow.appendChild(styleEl);
              }
              styleEl.textContent =
                ".swiper,.swiper-wrapper,.swiper-slide{height:" + max + "px !important;min-height:" + max + "px !important;}" +
                ".swiper-wrapper{transition-property:transform !important;transition-timing-function:cubic-bezier(0.22,1,0.36,1) !important;}" +
                ".es-carousel-item,.es-review-container,.es-review-background-container{height:100% !important;box-sizing:border-box;}";
              return true;
            }

            var tries = 0;
            var boot = function () {
              if (!settle() && tries++ < 40) setTimeout(boot, 250);
            };
            boot();
            var n = 0;
            var keep = setInterval(function () {
              settle();
              if (++n > 24) clearInterval(keep);
            }, 500);
          })();
        </script>

        <noscript>
          {olympiaReviews?.reviewUrl && (
            <p class="mt-4 text-center text-sm text-brand-muted">
              <a href={olympiaReviews.reviewUrl} class="font-semibold text-brand-primary hover:underline" target="_blank" rel="noopener">
                {fallbackLabel} →
              </a>
            </p>
          )}
        </noscript>
      </div>

      <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
    </section>
  )
}
