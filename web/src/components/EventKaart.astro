---
// Short card on /events, same shape as Dwars door Hasselt: date, title, the
// first paragraph, and a button. The rest (full text, Instagram, video) lives
// on /events/[slug], which exists for every event. A separate actiepagina is
// only needed when the button should open a campaign page (Studio → Link).
import { eventInfoHref, type SiteEvent } from "../lib/content";
import { withLang } from "../lib/i18n";

interface Props {
  event: SiteEvent;
  lang?: "nl" | "en";
}

const { event, lang = "nl" } = Astro.props;
const en = lang === "en";
const titel = (en && event.titelEn) || event.titel;
const tekst = (en && event.tekstEn) || event.tekst || "";
const locale = en ? "en-GB" : "nl-BE";
const date = new Date(`${event.datum}T12:00:00`);
const geldig = !Number.isNaN(date.getTime());
const dag = geldig ? String(date.getDate()) : "";
const maand = geldig ? new Intl.DateTimeFormat(locale, { month: "short" }).format(date).replace(".", "") : "";
const jaar = geldig ? String(date.getFullYear()) : "";
const weekdag = geldig ? new Intl.DateTimeFormat(locale, { weekday: "long" }).format(date) : "";
const volledig = geldig
  ? new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" }).format(date)
  : event.datum;
const instagram = event.instagram?.trim() || "";
const alinea = tekst.split(/\n\s*\n/).map((deel) => deel.trim()).filter(Boolean);
const teaser = alinea[0] || "";
const meerTekst = alinea.length > 1;
const heeftEigenLink = Boolean(event.link?.trim());
const paginaHref = withLang(`/events/${event.slug}`, lang);
const infoHref = eventInfoHref(event, lang);
const infoExtern = /^https?:/i.test(infoHref);
const infoAttrs = infoExtern ? { target: "_blank", rel: "noopener" } : {};
const knopHref = heeftEigenLink ? infoHref : paginaHref;
const knopExtern = /^https?:/i.test(knopHref);
const knopAttrs = knopExtern ? { target: "_blank", rel: "noopener" } : {};
const toonKnop = heeftEigenLink || meerTekst || Boolean(instagram || event.video);
const knop = (heeftEigenLink && event.linkLabel) || (en ? "More info" : "Meer info");
// Full frame; the card crops it into the right column. A landscape pre-crop cut the title off portrait posters.
const foto = event.foto ? `${event.foto}?w=900&fit=max&auto=format` : undefined;
const fotoPos = event.fotoHotspot
  ? `${(event.fotoHotspot.x * 100).toFixed(1)}% ${(event.fotoHotspot.y * 100).toFixed(1)}%`
  : "center";
---

<article class:list={["event-kaart", foto && "event-kaart--foto"]}>
  <a class="event-kaart__datum" href={infoHref} aria-label={volledig} {...infoAttrs}>
    <time datetime={event.datum} style="display: contents">
      <span class="event-kaart__dag">{dag}</span>
      <span class="event-kaart__maand">{maand}</span>
      <span class="event-kaart__jaar">{jaar}</span>
    </time>
  </a>

  <div class="event-kaart__body">
    <p class="event-kaart__meta">
      {weekdag}{event.locatie && ` · ${event.locatie}`}
    </p>
    <h3 class="event-kaart__titel"><a href={infoHref} {...infoAttrs}>{titel}</a></h3>
    {teaser && <p class:list={["event-kaart__tekst", (meerTekst || instagram || event.video) && "event-kaart__tekst--kort"]}>{teaser}</p>}
    {toonKnop && (
      <a href={knopHref} class="event-kaart__knop" {...knopAttrs}>
        {knop}
      </a>
    )}
  </div>

  {foto && (
    <div class="event-kaart__foto">
      <img src={foto} alt="" style={`object-position: ${fotoPos}`} loading="lazy" />
    </div>
  )}
</article>

<style>
  .event-kaart {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid rgb(244 247 251 / 0.16);
    border-radius: 1.25rem;
    background: rgb(244 247 251 / 0.05);
  }

  .event-kaart--foto {
    grid-template-columns: minmax(0, 1fr) 6.5rem;
    grid-template-areas: "datum foto" "body foto";
  }

  .event-kaart--foto .event-kaart__datum {
    grid-area: datum;
  }

  .event-kaart--foto .event-kaart__body {
    grid-area: body;
  }

  @media (max-width: 767px) {
    .event-kaart:not(.event-kaart--foto) {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .event-kaart--foto {
      gap: 1rem;
    }

    .event-kaart .event-kaart__datum {
      flex-direction: row;
      align-items: baseline;
      justify-self: start;
      gap: 0.45rem;
      min-width: 0;
      padding: 0.55rem 0.9rem;
    }

    .event-kaart .event-kaart__datum .event-kaart__dag {
      font-size: 1.6rem;
    }

    .event-kaart .event-kaart__datum :is(.event-kaart__maand, .event-kaart__jaar) {
      margin-top: 0;
    }
  }

  @media (min-width: 768px) {
    .event-kaart {
      gap: 2rem;
      padding: 1.75rem;
    }

    .event-kaart--foto {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 16rem);
      grid-template-areas: "datum body foto";
    }
  }

  a.event-kaart__datum {
    color: inherit;
    text-decoration: none;
  }

  a.event-kaart__datum:hover {
    background: #fffdf8;
  }

  .event-kaart__titel a {
    color: inherit;
    text-decoration: none;
  }

  .event-kaart__titel a:hover {
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .event-kaart__datum {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: start;
    min-width: 5.25rem;
    padding: 0.85rem 0.75rem 0.7rem;
    border-radius: 0.9rem;
    background: #f3eee4;
    line-height: 1;
    text-align: center;
  }

  /* The lab .page-ink rules paint every span light; the date chip is cream. */
  .event-kaart__datum span {
    color: #161513 !important;
  }

  .event-kaart__dag {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .event-kaart__maand {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .event-kaart__jaar {
    margin-top: 0.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.6;
  }

  .event-kaart__meta {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .event-kaart__titel {
    margin-top: 0.45rem;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .event-kaart__tekst {
    margin-top: 0.75rem;
    max-width: 38rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .event-kaart__tekst--kort {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  .event-kaart__knop {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0 1.35rem;
    border-radius: 9999px;
    font-weight: 650;
    background: #f3eee4;
    color: #161513 !important;
    transition: background-color 0.2s;
  }

  .event-kaart__knop::after {
    content: "→";
  }

  .event-kaart__knop:hover {
    background: #fffdf8;
  }

  .event-kaart__foto {
    position: relative;
    grid-area: foto;
    min-height: 8rem;
    overflow: hidden;
    border-radius: 0.9rem;
  }

  .event-kaart__foto img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
