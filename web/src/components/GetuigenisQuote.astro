---
import type { Getuigenis } from "../lib/content";

interface Props {
  item: Getuigenis;
}

const { item } = Astro.props;
---

<figure class="mx-auto max-w-3xl px-4 py-12 text-center">
  <blockquote class="text-xl font-medium leading-relaxed text-brand-text sm:text-2xl">
    “{item.tekst}”
  </blockquote>
  <figcaption class="mt-4 text-sm font-semibold text-brand-muted">
    — {item.naam}
    {item.locatie && <span> · {item.locatie}</span>}
  </figcaption>
</figure>
