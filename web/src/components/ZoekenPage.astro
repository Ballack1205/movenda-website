---
import Layout from "../layouts/Layout.astro";
import { withLang, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
---

<Layout
  title={en ? "Search | Movenda" : "Zoeken | Movenda"}
  description={en ? "Search the Movenda website." : "Zoek op de website van Movenda."}
  path={`${prefix}/zoeken`}
  altPath={en ? "/zoeken" : "/en/zoeken"}
  lang={lang}
  noindex
>
  <section class="page-ink mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">{en ? "Search" : "Zoeken"}</h1>
    <form action={withLang("/zoeken", lang)} method="get" role="search" class="mt-6">
      <label class="sr-only" for="q">{en ? "Search" : "Zoeken"}</label>
      <input id="q" name="q" type="search" autocomplete="off" placeholder={en ? "Search" : "Zoeken"} class="w-full border-b border-brand-border bg-transparent px-1 py-2 text-lg outline-none" />
    </form>
    <ul id="zoek-results" class="mt-6"></ul>
  </section>
</Layout>
