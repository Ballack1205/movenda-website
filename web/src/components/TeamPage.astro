---
import Layout from "../layouts/Layout.astro";
import {
  getTeamleden,
  getSiteSettings,
  getKeuzehulp,
  getLocaties,
  KEUZEHULP_CATEGORIEEN,
  isKinesist,
  isTrainer,
  keuzehulpTagLabel,
  locatieKorteNamen,
  specialisatieNaam,
} from "../lib/content";
import TeamGroupPhoto from "./TeamGroupPhoto.astro";
import { teamPhotoSrc } from "../lib/images";
import { breadcrumbNode, teamListNode } from "../lib/schema";
import { KEUZEHULP_EN, withLang, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const team = await getTeamleden();
const settings = await getSiteSettings();
const keuzehulp = await getKeuzehulp();
const locaties = await getLocaties();
const path = withLang("/team", lang);
const homePath = withLang("/", lang);

const jsonLd = [
  teamListNode(team, path, lang),
  breadcrumbNode([
    { name: "Home", path: homePath },
    { name: "Team", path: path },
  ]),
];

const vragen = KEUZEHULP_CATEGORIEEN.filter((cat) => keuzehulp.opties[cat].length > 0);
const toonKeuzehulp = keuzehulp.actief && vragen.length > 0;

const locatieLabel = (slugs: typeof team[number]["locaties"]) => locatieKorteNamen(slugs, locaties).join(" · ");

const tagLabels: Record<string, string> = {};
for (const cat of vragen) for (const t of keuzehulp.opties[cat]) tagLabels[t.id] = keuzehulpTagLabel(t, lang);

const khTitel = lang === "en" ? KEUZEHULP_EN.titel : keuzehulp.titel;
const khIntro = lang === "en"
  ? KEUZEHULP_EN.intro
  : (keuzehulp.intro || "").replace(
      /één keuze per vraag is genoeg/i,
      "je mag per vraag meerdere opties aanklikken",
    ) || keuzehulp.intro;
const khVragen = lang === "en" ? KEUZEHULP_EN.vragen : keuzehulp.vragen;
const khGeenMatch = lang === "en" ? KEUZEHULP_EN.geenMatchTekst : keuzehulp.geenMatchTekst;

const payload = {
  tagLabels,
  geenMatchTekst: khGeenMatch,
  teamPrefix: withLang("/team", lang),
  lang,
  team: team.map((lid, i) => ({
    slug: lid.slug,
    order: i,
    naam: `${lid.voornaam} ${lid.naam}`,
    rol: lang === "en" ? lid.rolEn || lid.rol : lid.rol,
    locatie: locatieLabel(lid.locaties),
    face: lid.foto ? teamPhotoSrc(lid.foto, "face") : null,
    initialen: `${lid.voornaam[0]}${lid.naam[0]}`,
    tags: lid.keuzehulpTags.map((t) => t.id),
    kine: isKinesist(lid),
    pt: isTrainer(lid),
    olympia: lid.locaties.includes("olympia"),
    mpc: lid.locaties.includes("mpc"),
  })),
};

const t = {
  title: lang === "en" ? "Our team | Physiotherapists & trainers Hasselt | Movenda" : "Ons team | Kinesisten & personal trainers Hasselt | Movenda",
  description:
    lang === "en"
      ? "Meet the Movenda team: physiotherapists, personal trainers and performance coaches in Hasselt and Kuringen."
      : "Maak kennis met het team van Movenda: kinesisten, personal trainers en performance coaches in Hasselt en Kuringen.",
  h1: lang === "en" ? "Our team, your health" : "Ons team, jouw gezondheid",
  intro:
    lang === "en"
      ? `${team.length} therapists and coaches, across Movenda Olympia and the Movenda Performance Centre. Each team member has their own specialisation — pick whoever best matches your complaint or goal.`
      : `${team.length} therapeuten en coaches, verdeeld over Movenda Olympia en het Movenda Performance Centre. Elk teamlid heeft een eigen specialisatie — kies zelf wie het best aansluit bij jouw klacht of doel.`,
  filter: lang === "en" ? "Filter by role or location" : "Filter op rol of vestiging",
  colleagues: lang === "en" ? "colleagues" : "collega's",
  empty: lang === "en" ? "No colleagues in this selection." : "Geen collega's in deze selectie.",
  close: lang === "en" ? "Close" : "Sluiten",
  profile: lang === "en" ? "View profile" : "Bekijk profiel",
  about: lang === "en" ? "Show bio of {name}" : "Toon bio van {name}",
  hideBio: lang === "en" ? "Hide bio of {name}" : "Verberg bio van {name}",
  showMatches: lang === "en" ? "Show my matches ↓" : "Toon mijn matches ↓",
  yourMatches: lang === "en" ? "Your matches" : "Jouw matches",
  reset: lang === "en" ? "Clear my choices" : "Wis mijn keuzes",
  choose: lang === "en" ? "Make one or more choices above — your matches appear here." : "Maak hierboven één of meer keuzes — je matches verschijnen hier.",
};

const filters = [
  { key: "all", label: lang === "en" ? "Everyone" : "Iedereen" },
  { key: "kine", label: lang === "en" ? "Physiotherapists" : "Kinesisten" },
  { key: "pt", label: lang === "en" ? "Trainers & coaches" : "Trainers & coaches" },
  { key: "olympia", label: "Olympia" },
  { key: "mpc", label: "Performance Centre" },
];
---

<Layout
  title={t.title}
  description={t.description}
  path={path}
  altPath={lang === "en" ? "/team" : "/en/team"}
  lang={lang}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-semibold sm:text-4xl">{t.h1}</h1>
    <p class="mt-3 max-w-2xl text-lg text-brand-muted">
      {t.intro}
    </p>

    <TeamGroupPhoto foto={settings.teamfoto} class="mt-8" />

    <div id="keuzehulp" class="mt-8 flex flex-col gap-3 scroll-mt-24 sm:mt-10 sm:flex-row sm:items-center sm:justify-between">
      <div
        class="flex flex-wrap gap-1.5 sm:inline-flex sm:max-w-full sm:gap-1 sm:rounded-full sm:border sm:border-brand-border sm:bg-brand-surface sm:p-1"
        role="group"
        aria-label={t.filter}
        data-team-filters
      >
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? "true" : "false"}
            class="whitespace-nowrap rounded-full border border-brand-border bg-brand-surface px-3 py-1.5 text-[13px] font-medium sm:px-3.5 sm:text-sm text-brand-muted transition hover:text-brand-text aria-pressed:border-brand-header aria-pressed:bg-brand-header aria-pressed:text-white sm:border-0 sm:bg-transparent"
          >
            {f.label}
          </button>
        ))}
      </div>
      {toonKeuzehulp && (
        <button
          type="button"
          data-open-keuzehulp
          class="order-first inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-primary-dark sm:order-none sm:w-auto sm:py-2.5"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
          </svg>
          {khTitel}
        </button>
      )}
    </div>

    <p class="mt-3 text-sm text-brand-muted" data-count-line>
      <span data-count>{team.length}</span> {t.colleagues}
    </p>

    <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3" data-grid>
      {team.map((lid) => {
        const bio = lang === "en" ? lid.bioEn || lid.bio : lid.bio;
        return (
        <article
          class="group relative overflow-hidden rounded-xl border border-brand-border bg-brand-surface transition hover:border-brand-primary sm:rounded-2xl"
          data-card
          data-slug={lid.slug}
        >
          <a href={withLang(`/team/${lid.slug}`, lang)} class="block">
            <div class="relative aspect-[3/4] w-full overflow-hidden bg-brand-header">
              {lid.foto ? (
                <img
                  src={teamPhotoSrc(lid.foto, "card")}
                  alt={`${lid.voornaam} ${lid.naam}`}
                  width="600"
                  height="900"
                  loading="lazy"
                  class="h-full w-full object-cover object-top transition duration-300 group-hover:scale-[1.03]"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-2xl font-semibold text-white/80 sm:text-3xl">
                  {lid.voornaam[0]}{lid.naam[0]}
                </div>
              )}
              {/* Bio overlay: desktop hover/focus; on touch the i-button toggles it. */}
              {bio && (
                <div
                  class="team-card-reveal pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-header via-brand-header/95 to-brand-header/0 px-3 pb-3 pt-12 text-white sm:px-5 sm:pb-5 sm:pt-16"
                  aria-hidden="true"
                >
                  <p class="team-card-reveal-text line-clamp-3 text-[13px] leading-relaxed text-white/90 sm:line-clamp-4 lg:line-clamp-6 lg:text-sm">{bio}</p>
                  <p class="mt-2 text-sm font-semibold sm:mt-3">{t.profile} →</p>
                </div>
              )}
            </div>
            <div class="p-3 sm:p-5">
              <h2 class="text-[15px] font-semibold leading-snug sm:text-lg">{lid.voornaam} {lid.naam}</h2>
              <p class="mt-0.5 line-clamp-2 text-xs font-medium text-brand-primary sm:text-sm">{lang === "en" ? lid.rolEn || lid.rol : lid.rol}</p>
              <p class="mt-1 text-[11px] text-brand-muted sm:text-xs">{locatieLabel(lid.locaties)}</p>
              {lid.specialisaties.length > 0 && (
                <p class="mt-3 hidden line-clamp-2 text-sm text-brand-muted sm:block">
                  {lid.specialisaties.slice(0, 4).map((s) => specialisatieNaam(s, lang)).join(" · ")}
                </p>
              )}
            </div>
          </a>
          {bio && (
            <button
              type="button"
              data-card-info
              data-label-show={t.about.replace("{name}", `${lid.voornaam} ${lid.naam}`)}
              data-label-hide={t.hideBio.replace("{name}", `${lid.voornaam} ${lid.naam}`)}
              aria-expanded="false"
              aria-label={t.about.replace("{name}", `${lid.voornaam} ${lid.naam}`)}
              class="team-card-info absolute right-2 top-2 z-20 inline-flex h-9 w-9 items-center justify-center rounded-full bg-black/55 text-white shadow-sm backdrop-blur-sm lg:hidden"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v5" />
                <circle cx="12" cy="8" r="0.75" fill="currentColor" stroke="none" />
              </svg>
            </button>
          )}
        </article>
        );
      })}
    </div>

    <p data-empty hidden class="mt-6 rounded-2xl border border-dashed border-brand-border p-6 text-center text-brand-muted">
      {t.empty}
    </p>
  </section>

  {toonKeuzehulp && (
    <dialog
      data-keuzehulp
      aria-labelledby="keuzehulp-titel"
      class="m-auto w-[min(100vw-2rem,64rem)] max-h-[min(100dvh-2rem,52rem)] rounded-2xl bg-brand-surface p-0 text-brand-text shadow-2xl backdrop:bg-brand-header/60 backdrop:backdrop-blur-sm max-sm:mb-0 max-sm:mt-auto max-sm:max-h-[92dvh] max-sm:w-screen max-sm:max-w-none max-sm:rounded-b-none"
    >
      <form method="dialog" class="flex max-h-[inherit] flex-col">
        <header class="flex items-start justify-between gap-3 border-b border-brand-border px-4 py-4 sm:px-8 sm:py-5">
          <div class="min-w-0">
            <h2 id="keuzehulp-titel" class="text-xl font-semibold sm:text-2xl">{khTitel}</h2>
            <p class="mt-1 max-w-xl text-[13px] leading-snug text-brand-muted sm:text-sm">{khIntro}</p>
          </div>
          <button
            type="submit"
            class="-mr-2 -mt-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-brand-muted transition hover:bg-brand-bg hover:text-brand-text"
            aria-label={t.close}
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </header>

        <div class="grid min-h-0 flex-1 overflow-y-auto lg:grid-cols-[1fr_22rem] lg:overflow-hidden">
          <div class="px-4 py-4 sm:px-8 sm:py-5 lg:overflow-y-auto">
          <div class="grid gap-5 sm:grid-cols-2">
            {vragen.map((cat) => (
              <fieldset class={cat === "klacht" ? "sm:col-span-2" : ""}>
                <legend class="text-sm font-semibold">{khVragen[cat]}</legend>
                <div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-multiselectable="true" data-vraag={cat}>
                  {keuzehulp.opties[cat].map((tag) => (
                    <button
                      type="button"
                      data-tag={tag.id}
                      aria-pressed="false"
                      class="rounded-full border border-brand-border bg-brand-bg px-3 py-1.5 text-left text-[13px] leading-tight text-brand-text transition hover:border-brand-primary hover:text-brand-primary aria-pressed:border-brand-primary aria-pressed:bg-brand-primary aria-pressed:text-white sm:py-1 sm:text-sm"
                    >
                      {keuzehulpTagLabel(tag, lang)}
                    </button>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>

          <div class="sticky -bottom-px -mx-4 mt-4 border-t border-brand-border bg-brand-surface/95 px-4 py-3 backdrop-blur sm:-mx-8 sm:px-8 lg:hidden" data-jump-wrap hidden>
            <button type="button" data-jump class="w-full rounded-full bg-brand-primary px-4 py-2.5 text-sm font-semibold text-white">
              {t.showMatches}
            </button>
          </div>
          </div>
          <section
            class="border-t border-brand-border bg-brand-bg/60 px-4 py-5 sm:px-8 lg:overflow-y-auto lg:border-l lg:border-t-0 lg:px-6"
            aria-live="polite"
            data-results
          >
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-base font-semibold" data-results-title>{t.yourMatches}</h3>
              <button type="button" data-reset hidden class="text-sm font-medium text-brand-primary underline decoration-brand-border underline-offset-4 hover:decoration-brand-primary">
                {t.reset}
              </button>
            </div>
            <p class="mt-1 text-sm text-brand-muted" data-keuze-status>
              {t.choose}
            </p>
            <ul class="mt-3 divide-y divide-brand-border" data-result-list></ul>
          </section>
        </div>
      </form>
    </dialog>
  )}
</Layout>

<style>
  /* Bio panel sits under the photo. Desktop (lg+) reveals it on hover/focus.
     Below lg the i-button toggles [data-bio-open] instead — hover would steal
     the first tap on tablets that report hover. */
  .team-card-reveal {
    transform: translateY(100%);
    opacity: 0;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.25s ease;
  }
  [data-card][data-bio-open] .team-card-reveal {
    transform: none;
    opacity: 1;
    height: 75%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: calc(1.25rem + 1em);
    background: linear-gradient(
      to top,
      var(--brand-header) 0%,
      color-mix(in srgb, var(--brand-header) 92%, transparent) 70%,
      color-mix(in srgb, var(--brand-header) 35%, transparent) 100%
    );
  }
  [data-card][data-bio-open] .team-card-reveal-text {
    -webkit-line-clamp: 8;
    line-clamp: 8;
  }
  [data-card][data-bio-open] .team-card-reveal > :last-child {
    margin-top: auto;
  }
  @media (min-width: 1024px) {
    [data-card]:focus-within .team-card-reveal {
      transform: none;
      opacity: 1;
    }
  }
  @media (hover: hover) and (min-width: 1024px) {
    [data-card]:hover .team-card-reveal {
      transform: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .team-card-reveal {
      transition: none;
    }
  }
</style>

<script define:vars={{ payload }} is:inline>
  // Team grid: always shows everyone; only the role/location filter narrows it.
  const cards = [...document.querySelectorAll("[data-card]")];
  const bySlug = new Map(payload.team.map((t) => [t.slug, t]));
  const countEl = document.querySelector("[data-count]");
  const emptyEl = document.querySelector("[data-empty]");
  const filterBtns = [...document.querySelectorAll("[data-team-filters] [data-filter]")];
  let roleFilter = "all";

  function renderGrid() {
    let visible = 0;
    for (const card of cards) {
      const t = bySlug.get(card.dataset.slug);
      const show = roleFilter === "all" || t[roleFilter];
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    }
    if (countEl) countEl.textContent = String(visible);
    if (emptyEl) emptyEl.hidden = visible > 0;
    filterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === roleFilter)));
  }
  filterBtns.forEach((btn) =>
    btn.addEventListener("click", () => {
      roleFilter = btn.dataset.filter;
      renderGrid();
    }),
  );
  renderGrid();

  // Mobile/tablet: tap the i-button to slide the bio up; tap it again or
  // anywhere outside the card to close. The rest of the card stays a link.
  function setBioOpen(card, open) {
    const btn = card.querySelector("[data-card-info]");
    card.toggleAttribute("data-bio-open", open);
    if (!btn) return;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? btn.dataset.labelHide : btn.dataset.labelShow);
  }
  function closeBios(except) {
    for (const card of cards) {
      if (card !== except && card.hasAttribute("data-bio-open")) setBioOpen(card, false);
    }
  }
  for (const card of cards) {
    const btn = card.querySelector("[data-card-info]");
    if (!btn) continue;
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      const next = !card.hasAttribute("data-bio-open");
      closeBios(card);
      setBioOpen(card, next);
    });
  }
  document.addEventListener("click", (e) => {
    if (e.target.closest("[data-card-info]")) return;
    const openCard = e.target.closest("[data-card][data-bio-open]");
    if (openCard) return;
    closeBios();
  });

  // "Wie past bij mij?" — scoring recommender inside a <dialog>.
  // Multi-select on every question. 1 point per matching tag, ranked by
  // score then editorial order. Nobody with 0 points is listed; if nobody
  // matches every answer we still show the best partial matches.
  const dialog = document.querySelector("[data-keuzehulp]");
  if (dialog) {
    const openBtns = document.querySelectorAll("[data-open-keuzehulp]");
    const vraagGroups = [...dialog.querySelectorAll("[data-vraag]")];
    const status = dialog.querySelector("[data-keuze-status]");
    const list = dialog.querySelector("[data-result-list]");
    const resetBtn = dialog.querySelector("[data-reset]");
    const resultsTitle = dialog.querySelector("[data-results-title]");
    const jumpWrap = dialog.querySelector("[data-jump-wrap]");
    const jumpBtn = dialog.querySelector("[data-jump]");
    const MAX_RESULTS = 6;
    const selected = new Set(); // tag ids, any question

    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

    function syncUrl() {
      const p = new URLSearchParams(location.search);
      if (selected.size) p.set("k", [...selected].join(","));
      else p.delete("k");
      const qs = p.toString();
      history.replaceState(null, "", (qs ? `?${qs}` : location.pathname) + (dialog.open ? "#keuzehulp" : ""));
    }

    function renderResults() {
      const chosen = [...selected];
      for (const group of vraagGroups) {
        group.querySelectorAll("[data-tag]").forEach((b) => b.setAttribute("aria-pressed", String(selected.has(b.dataset.tag))));
      }
      resetBtn.hidden = chosen.length === 0;
      jumpWrap.hidden = chosen.length === 0;

      if (!chosen.length) {
        resultsTitle.textContent = payload.lang === "en" ? "Your matches" : "Jouw matches";
        status.textContent =
          payload.lang === "en"
            ? "Make one or more choices above — your matches appear here."
            : "Maak hierboven één of meer keuzes — je matches verschijnen hier.";
        list.innerHTML = "";
        syncUrl();
        return;
      }

      const ranked = payload.team
        .map((t) => ({ t, matched: chosen.filter((id) => t.tags.includes(id)) }))
        .filter((r) => r.matched.length > 0)
        .sort((a, b) => b.matched.length - a.matched.length || a.t.order - b.t.order);
      const full = ranked.some((r) => r.matched.length === chosen.length);
      const shown = ranked.slice(0, MAX_RESULTS);

      resultsTitle.textContent = payload.lang === "en" ? `Your matches (${ranked.length})` : `Jouw matches (${ranked.length})`;
      jumpBtn.textContent =
        payload.lang === "en" ? `Show my matches (${ranked.length}) ↓` : `Toon mijn matches (${ranked.length}) ↓`;
      status.textContent = !ranked.length
        ? payload.lang === "en"
          ? "Nobody on the team is tagged for this. Call us — we'll point you to the right person."
          : "Niemand in het team is hierop getagd. Bel ons — we verwijzen je door naar de juiste persoon."
        : full
          ? payload.lang === "en"
            ? "The strongest matches are listed first."
            : "De sterkste matches staan bovenaan."
          : payload.geenMatchTekst;

      list.innerHTML = shown
        .map(({ t, matched }) => {
          const strong = matched.length === chosen.length;
          const avatar = t.face
            ? `<img src="${esc(t.face)}" alt="" width="56" height="56" loading="lazy" class="h-12 w-12 shrink-0 rounded-full object-cover" />`
            : `<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-header text-sm font-semibold text-white">${esc(t.initialen)}</span>`;
          const tags = matched.map((id) => `<li class="rounded-full bg-brand-bg px-2 py-0.5 text-xs text-brand-primary">${esc(payload.tagLabels[id] || "")}</li>`).join("");
          const matchBadge = strong
            ? payload.lang === "en"
              ? "Strong match"
              : "Sterke match"
            : payload.lang === "en"
              ? `${matched.length} of ${chosen.length}`
              : `${matched.length} van ${chosen.length}`;
          return `<li>
            <a href="${esc(payload.teamPrefix)}/${esc(t.slug)}" class="group flex items-center gap-3 py-3">
              ${avatar}
              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-center gap-x-2">
                  <span class="font-semibold group-hover:underline">${esc(t.naam)}</span>
                  <span class="rounded-full ${strong ? "bg-brand-primary text-white" : "bg-brand-bg text-brand-muted"} px-2 py-0.5 text-xs font-medium">${matchBadge}</span>
                </span>
                <span class="block text-sm text-brand-muted">${esc(t.rol)} · ${esc(t.locatie)}</span>
                <ul class="mt-1.5 flex flex-wrap gap-1">${tags}</ul>
              </span>
              <svg class="h-5 w-5 shrink-0 text-brand-muted transition group-hover:text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
            </a>
          </li>`;
        })
        .join("");
      syncUrl();
    }

    for (const group of vraagGroups) {
      group.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-tag]");
        if (!btn) return;
        const id = btn.dataset.tag;
        if (selected.has(id)) selected.delete(id);
        else selected.add(id);
        renderResults();
      });
    }
    jumpBtn.addEventListener("click", () => dialog.querySelector("[data-results]").scrollIntoView({ behavior: "smooth", block: "start" }));
    resetBtn.addEventListener("click", () => {
      selected.clear();
      renderResults();
    });

    function open() {
      if (!dialog.open) dialog.showModal();
      syncUrl();
    }
    openBtns.forEach((b) => b.addEventListener("click", open));
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close(); // backdrop click
    });
    dialog.addEventListener("close", syncUrl);

    // Deep links: ?k=tag,tag prefills (a therapist can send a patient a link); #keuzehulp opens it.
    const params = new URLSearchParams(location.search);
    const known = new Set([...dialog.querySelectorAll("[data-tag]")].map((b) => b.dataset.tag));
    const initialTags = (params.get("k") || "").split(",").filter((id) => known.has(id));
    for (const id of initialTags) selected.add(id);
    renderResults();
    if (initialTags.length || location.hash === "#keuzehulp") open();
  }
</script>
