---
import Layout from "../layouts/Layout.astro";
import CmsFoto from "./CmsFoto.astro";
import GoogleReviewBadge from "./GoogleReviewBadge.astro";
import Routebeschrijving from "./Routebeschrijving.astro";
import SectionKicker from "./SectionKicker.astro";
import olympiaHero from "../assets/marketing/home-olympia.jpg";
import {
  getLocatieBySlug,
  getSiteSettings,
  getTeamledenByLocatie,
  olympiaTekst,
  olympiaZin,
  uiTekst,
  type LocatieSlug,
  type OlympiaPagina,
} from "../lib/content";
import { breadcrumbNode } from "../lib/schema";
import { byAppointment, floorNote, legalCourt, locatieType, weekday, withLang, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
  slug: string;
}

const { lang = "nl", slug } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const locatie = (await getLocatieBySlug(slug as LocatieSlug))!;
const settings = await getSiteSettings();
const kop = (key: string) => uiTekst(settings, "locatie", key, lang);
const team = await getTeamledenByLocatie(slug as LocatieSlug);
const brand = locatie.brand === "mpc" ? "mpc" : "movenda";
const path = `${prefix}/locaties/${locatie.slug}`;
const typeLabel = en ? locatie.typeEn || locatieType(locatie.type, "en") : locatie.type;
const urenNote = en ? locatie.urenNoteEn || byAppointment(locatie.urenNote, "en") : locatie.urenNote;
const route = en ? locatie.routebeschrijvingEn || locatie.routebeschrijving : locatie.routebeschrijving;
const locatieForRoute = route === locatie.routebeschrijving ? locatie : { ...locatie, routebeschrijving: route };
const olympia = locatie.slug === "olympia";
const pagina = locatie.olympiaPagina;
const zin = (field: keyof OlympiaPagina) => (pagina ? olympiaTekst(pagina, field, lang) : "");
const localHref = (href: string) => (/^https?:/i.test(href) ? href : withLang(href, lang));
---

<Layout
  title={olympia
    ? zin("seoTitel")
    : en
      ? `${locatie.naam} | Address & opening hours`
      : `${locatie.naam} | Adres & openingsuren`}
  description={olympia
    ? zin("seoBeschrijving").replaceAll("{adres}", locatie.adres)
    : en
      ? `${locatie.naam} — ${typeLabel}, ${locatie.adres}. Opening hours, phone, directions and the team at this location.`
      : `${locatie.naam} — ${locatie.type}, ${locatie.adres}. Openingsuren, telefoon, route en het team op deze locatie.`}
  path={path}
  altPath={en ? `/locaties/${locatie.slug}` : `/en/locaties/${locatie.slug}`}
  brand={brand}
  lang={lang}
  jsonLd={[breadcrumbNode([{ name: "Home", path: prefix || "/" }, { name: locatie.naam, path }])]}
>
  <div class="locatie-page">
  <section class:list={["mx-auto px-4 py-12", olympia ? "max-w-6xl" : "max-w-4xl"]}>
    {olympia && pagina ? (
      <>
        <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
          <div>
            <p class="brief-kicker">{zin("kicker")}</p>
            <h1 class="mt-3">{zin("titel")}</h1>
            <p class="mt-4 text-brand-muted">{zin("intro")}</p>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white" href={localHref(zin("ctaHref"))}>
                {zin("cta")}
              </a>
              <a class="brief-textlink mt-0" href="#aanbod">{zin("aanbodLink")}</a>
            </div>
          </div>
          <CmsFoto
            foto={pagina.hoofdfoto
              ? { url: pagina.hoofdfoto, hotspot: pagina.hoofdfotoHotspot, alt: pagina.hoofdfotoAlt }
              : undefined}
            fallback={olympiaHero}
            alt={pagina.hoofdfotoAlt || (en ? "Movenda at Sportcentrum Olympia" : "Movenda in Sportcentrum Olympia")}
            width={640}
            height={720}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 42vw, 100vw"
            class="aspect-[4/4.5] w-full object-cover"
            priority
          />
        </div>

        <div class="mt-16 max-w-3xl">
          <h2>{zin("aboKicker")}</h2>
          <p class="mt-2 text-xl italic text-brand-muted">{zin("aboTitel")}</p>
          <p class="brief-lead">{zin("aboTekst")}</p>
          <ul class="mt-4 list-disc space-y-1 pl-5">
            {pagina.aboPunten.map((punt) => (
              <li>
                {punt.href ? (
                  <a href={punt.href} target="_blank" rel="noopener noreferrer">{olympiaZin(punt, lang)}</a>
                ) : (
                  olympiaZin(punt, lang)
                )}
              </li>
            ))}
          </ul>
          <p class="brief-lead">
            {zin("aboMeer").trim()}{" "}
            <a href={`mailto:${locatie.email}`}>{locatie.email}</a>
            {zin("aboMeerNa")}
          </p>
          <a class="brief-textlink" href={localHref(zin("aboCtaHref"))}>{zin("aboCta")}</a>
        </div>

        <div id="aanbod" class="mt-16 scroll-mt-24">
          <h2 class="text-xl font-bold">{zin("aanbodTitel")}</h2>
          <ul class="mt-4 divide-y divide-white/15 border-y border-white/15">
            {pagina.aanbod.map((item) => (
              <li>
                <a class="grid gap-1 py-4 sm:grid-cols-[16rem_1fr_auto] sm:items-baseline sm:gap-6" href={localHref(item.href)}>
                  <span class="font-semibold">{lang === "en" ? item.titelEn || item.titel : item.titel}</span>
                  <span class="text-sm opacity-80">{lang === "en" ? item.tekstEn || item.tekst : item.tekst}</span>
                  <span class="text-sm font-semibold" aria-hidden="true">{zin("aanbodMeer")}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="brief-textlink" href={zin("olympiaUrl")} target="_blank" rel="noopener noreferrer">{zin("olympiaLink")}</a>
        </div>

        <div class="mt-16 max-w-3xl">
          <h2 class="text-xl font-bold">{zin("waaromTitel")}</h2>
          <ul class="mt-4 list-disc space-y-1 pl-5">
            {pagina.waarom.map((punt) => <li>{olympiaZin(punt, lang)}</li>)}
          </ul>
        </div>
      </>
    ) : (
      <>
        <SectionKicker n={1} />
        <h1 class="text-3xl font-bold">{locatie.naam}</h1>
        <p class="mt-1 text-brand-muted">{typeLabel}</p>
      </>
    )}

    {!olympia && (
    <div class="mt-6">
      <GoogleReviewBadge lang={lang} />
    </div>
    )}

    {!olympia && (
    <div class="mt-8 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">{kop("adres")}</h2>
        <p class="mt-2">{olympia ? `Olympia · ${locatie.adres}` : locatie.adres}</p>
        <a href={locatie.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-sm font-semibold text-brand-primary hover:underline">
          {kop("maps")}
        </a>

        <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-brand-muted">{kop("contact")}</h2>
        <p class="mt-2">
          <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="text-brand-primary hover:underline">{locatie.telefoon}</a>
        </p>
        <p>
          <a href={`mailto:${locatie.email}`} class="text-brand-primary hover:underline">{locatie.email}</a>
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">{kop("openingsuren")}</h2>
        {urenNote && <p class="mt-2 text-sm text-brand-muted">{urenNote}</p>}
        <ul class="mt-2 space-y-1 text-sm">
          {locatie.uren.map((u) => (
            <li class="flex justify-between gap-4">
              <span>{weekday(u.dag, lang)}</span>
              <span>{u.van} – {u.tot}</span>
            </li>
          ))}
        </ul>
        {locatie.verdiepingNote && <p class="mt-2 text-xs text-brand-muted">{floorNote(locatie.verdiepingNote, lang)}</p>}
      </div>
    </div>
    )}

    {!olympia && <Routebeschrijving locatie={locatieForRoute} lang={lang} title={kop("route")} class="mt-8" />}

    {!olympia && (
    <p class="mt-8 text-xs text-brand-muted">
      {kop("btw")} {locatie.btw}
      {locatie.iban && <> · IBAN {locatie.iban}</>}
      {locatie.bic && <> · BIC {locatie.bic}</>}
      {legalCourt(locatie.rpr, lang) && <> · {legalCourt(locatie.rpr, lang)}</>}
    </p>
    )}

    {team.length > 0 && (
      <div class="mt-12">
        <h2 class="text-xl font-bold">{kop("team")}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {team.map((lid) => (
            <a href={withLang(`/team/${lid.slug}`, lang)} class="rounded-xl border border-brand-border p-4 transition hover:border-brand-primary">
              <p class="font-semibold">{lid.voornaam} {lid.naam}</p>
              <p class="text-sm text-brand-muted">{en ? lid.rolEn || lid.rol : lid.rol}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
  </div>
</Layout>
