---
import Layout from "../layouts/Layout.astro";
import CmsFoto from "./CmsFoto.astro";
import GoogleReviewBadge from "./GoogleReviewBadge.astro";
import SocialLinks from "./SocialLinks.astro";
import DienstCard from "./DienstCard.astro";
import PartnerBand from "./PartnerBand.astro";
import GetuigenisCarousel from "./GetuigenisCarousel.astro";
import HeroVideo from "./HeroVideo.astro";
import LabCover from "./LabCover.astro";
import LabStrip from "./LabStrip.astro";
import { THEME } from "../lib/site";
import {
  getDienstenByCategorie,
  getLocatieBySlug,
  getPartners,
  getFaqs,
  getSiteSettings,
  getGetuigenissen,
  getPagina,
  paginaAlineas,
  paginaBlokKop,
  paginaBlokTekst,
  paginaTekst,
} from "../lib/content";
import { localBusinessSchema, breadcrumbSchema, faqPageSchema } from "../lib/schema";
import { faqCopy, partnerBandTitle } from "../lib/i18n";
import mpcHero from "../assets/marketing/mpc-hero.jpg";
import mpcSecondary from "../assets/marketing/mpc-secondary.jpg";

interface Props {
  lang?: "nl" | "en";
  /** Canonical path for this render (`/` on the MPC host, `/mpc` on the full site). */
  path: string;
  altPath: string;
}

const { lang = "nl", path, altPath } = Astro.props;
const en = lang === "en";

const training = await getDienstenByCategorie("mpc-training");
const rehab = await getDienstenByCategorie("mpc-rehab");
const groep = await getDienstenByCategorie("mpc-groep");
const locatie = (await getLocatieBySlug("mpc"))!;
const partners = await getPartners("mpc");
const faqs = await getFaqs("mpc");
const settings = await getSiteSettings();
const getuigenissen = await getGetuigenissen("mpc", lang);
const pagina = await getPagina("mpc");

const groepHref = en ? "/en/mpc/groepslessen" : "/mpc/groepslessen";
const contactHref = en ? "/en/contact" : "/contact";
const pillarTargets = [
  { href: "#training", foto: training.find((d) => d.afbeelding)?.afbeelding },
  { href: "#sportrevalidatie", foto: rehab.find((d) => d.afbeelding)?.afbeelding },
  { href: groepHref, foto: groep.find((d) => d.afbeelding)?.afbeelding },
];
const pillars = pillarTargets
  .map((t, i) => {
    const blok = pagina.pijlers[i];
    return {
      ...t,
      titel: blok ? (en ? paginaBlokKop(blok, "en") : blok.kop || "") : "",
      tekst: blok ? (en ? paginaBlokTekst(blok, "en") : blok.tekst || "") : "",
    };
  })
  .filter((p) => p.titel);

const jsonLd = [
  localBusinessSchema(locatie),
  breadcrumbSchema([
    { name: "Home", path: en ? "/en" : "/" },
    { name: "Movenda Performance Centre", path: en ? "/en/mpc" : "/mpc" },
  ]),
  ...(faqs.length > 0
    ? [faqPageSchema(en ? faqs.map((f) => ({ ...f, ...faqCopy(f, "en") })) : faqs, en ? "/en/mpc" : "/mpc")]
    : []),
];

const title =
  (en ? paginaTekst(pagina, "seoTitle", "en") : pagina.seoTitle) ||
  (en
    ? "Movenda Performance Centre | Sports performance Hasselt"
    : "Movenda Performance Centre | Performance training Hasselt");
const description = en ? paginaTekst(pagina, "seoDescription", "en") : pagina.seoDescription || "";
const h1 = en ? paginaTekst(pagina, "titel", "en") : pagina.titel;
const partnerTitle = en
  ? partnerBandTitle(settings.partnerband.titelMpc, "en")
  : settings.partnerband.titelMpc;
const lab = THEME === "lab";
const heroAlt = en ? "Movenda Performance Centre training space" : "Movenda Performance Centre trainingsruimte";
---

<Layout
  title={title}
  description={description}
  path={path}
  altPath={altPath}
  brand="mpc"
  lang={lang}
  jsonLd={jsonLd}
>
  {lab && (
      <LabCover
        pagina={pagina}
        fallback={mpcHero}
        alt={heroAlt}
        shout="Performance"
        line={en ? "Your highest level." : "Jouw hoogste niveau."}
        nextLabel={en ? "Continue" : "Verder"}
      />
  )}
  <div class:list={[lab && "lab-sheet lab-sheet--ink"]}>
  {lab ? (
    <>
      <section id="lab-next" class="lab-intro" data-reveal>
        <h2 class="lab-shout lab-intro__title">{en ? "One centre, three doors" : "Eén centre, drie wegen"}</h2>
        <p>{paginaAlineas(pagina, lang).join(" ")}</p>
        <a href={contactHref} class="lab-intro__cta">{en ? "Contact us" : "Contacteer ons"}</a>
      </section>
      <LabStrip
        items={pillars.map((p, i) => ({
          n: i + 1,
          href: p.href,
          title: p.titel,
          body: p.tekst,
          foto: p.foto ? { url: p.foto } : undefined,
          fallback: i === 1 ? mpcSecondary : mpcHero,
          alt: p.titel,
        }))}
      />
    </>
  ) : (
  <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 pb-10 pt-0 md:grid-cols-2 md:gap-10 md:py-16">
    <div class="order-last min-w-0 md:order-none">
      <p class="hidden text-sm font-semibold uppercase tracking-wide text-brand-primary md:block">
        Movenda Performance Centre
      </p>
      <h1 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl md:mt-3 xl:text-5xl">
        {h1}
      </h1>
      {settings.slogans.mpc && (
        <p class="mt-2 text-pretty text-lg font-medium text-brand-primary">{settings.slogans.mpc}</p>
      )}
      {paginaAlineas(pagina, lang).map((tekst) => (
        <p class="mt-4 max-w-xl text-pretty text-brand-muted">{tekst}</p>
      ))}
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`}
          class="rounded-full bg-brand-primary px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-primary-dark sm:px-6 sm:text-base"
        >
          {en ? "Call" : "Bel"} {locatie.telefoon}
        </a>
        <a
          href={contactHref}
          class="rounded-full border border-brand-border px-5 py-3 text-sm font-semibold text-brand-text transition hover:border-brand-primary sm:px-6 sm:text-base"
        >
          {en ? "Contact us" : "Contacteer ons"}
        </a>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
        <GoogleReviewBadge locatie="mpc" lang={lang} class="w-full justify-center sm:w-auto sm:justify-start" />
        <SocialLinks brand="mpc" lang={lang} class="w-full justify-center sm:w-auto sm:justify-start" />
      </div>
    </div>
    <div class="relative -mx-4 md:mx-0">
      <HeroVideo
        pagina={pagina}
        fallback={mpcHero}
        alt={heroAlt}
        width={800}
        height={600}
        class="aspect-[4/3] w-full object-cover object-top sm:aspect-[16/10] md:aspect-[4/3] md:rounded-3xl md:shadow-xl xl:aspect-[5/4]"
        priority
      />
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-center bg-gradient-to-t from-black/55 via-black/20 to-transparent px-4 pb-4 pt-20 md:hidden"
      >
        <p
          class="inline-flex max-w-full items-center gap-2 whitespace-nowrap rounded-full bg-black/60 px-3.5 py-2 text-[0.8125rem] font-bold leading-tight tracking-tight text-white ring-1 ring-white/25 sm:text-sm"
        >
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-white shadow-[0_0_0_3px_rgba(255,255,255,0.25)]" aria-hidden="true"></span>
          Movenda Performance Centre
        </p>
      </div>
    </div>
  </section>
  )}

  {!lab && <section class="mx-auto max-w-6xl px-4 pb-8">
    <h2 class="text-2xl font-bold">{en ? "Three pillars" : "Drie pijlers"}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {pillars.map((p) => (
        <a href={p.href} class:list={["flex min-w-0 flex-col overflow-hidden border border-brand-border bg-brand-surface transition", lab ? "lab-card rounded-[2px] hover:border-brand-text" : "rounded-2xl hover:border-brand-primary"]}>
          {p.foto && (
            <img
              src={`${p.foto}?w=800&h=500&fit=crop&auto=format`}
              alt=""
              width="800"
              height="500"
              class="aspect-[16/10] w-full object-cover"
            />
          )}
          <div class="p-5">
            <h3 class="text-lg font-semibold">{p.titel}</h3>
            <p class="mt-1 text-sm text-brand-muted">{p.tekst}</p>
          </div>
        </a>
      ))}
    </div>
  </section>}
  </div>

  <div class:list={[lab && "lab-sheet"]} data-lab-light={lab ? true : undefined}>
  <section id="training" class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="text-2xl font-bold">Training</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {training.map((dienst) => (
        <DienstCard dienst={dienst} lang={lang} />
      ))}
    </div>
  </section>
  </div>

  <div class:list={[lab && "lab-sheet lab-sheet--ink"]}>
  <section id="sportrevalidatie" class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid items-start gap-6 xl:grid-cols-3">
      <div class="min-w-0 xl:col-span-2">
        <h2 class="text-2xl font-bold">{en ? "Sports rehabilitation" : "Sportrevalidatie"}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {rehab.map((dienst) => (
            <DienstCard dienst={dienst} lang={lang} />
          ))}
        </div>
      </div>
      <CmsFoto
        foto={pagina.fotoSecundair}
        fallback={mpcSecondary}
        alt={en ? "Training space at the Movenda Performance Centre" : "Trainingsruimte bij het Movenda Performance Centre"}
        width={640}
        height={480}
        class="aspect-[16/10] w-full rounded-2xl object-cover xl:mt-14 xl:aspect-[3/4]"
      />
    </div>
  </section>
  </div>

  <div class:list={[lab && "lab-sheet"]}>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="text-2xl font-bold">{en ? "Group classes" : "Groepslessen"}</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {groep.map((dienst) => (
        <DienstCard dienst={dienst} lang={lang} />
      ))}
    </div>
    <a href={groepHref} class="mt-6 inline-block font-semibold text-brand-primary hover:underline">
      {en ? "See the timetable →" : "Bekijk het lesrooster →"}
    </a>
  </section>

  </div>

  <div class:list={[lab && "lab-sheet lab-sheet--ink"]}>
  <GetuigenisCarousel
    items={getuigenissen}
    title={en ? "What our athletes say" : "Wat onze atleten zeggen"}
    lang={lang}
  />
  </div>

  <div class:list={[lab && "lab-sheet"]}>

  {!lab && partners.length > 0 && (
    <PartnerBand
      partners={partners}
      title={partnerTitle}
      snelheid={settings.partnerband.snelheid}
      animatie={settings.partnerband.animatie}
    />
  )}

  {faqs.length > 0 && (
    <section id="faq" class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="text-2xl font-bold">{en ? "FAQ" : "Veelgestelde vragen"}</h2>
      <div class="mt-6 divide-y divide-brand-border rounded-2xl border border-brand-border bg-brand-surface">
        {faqs.map((faq) => {
          const copy = en ? faqCopy(faq, "en") : faq;
          return (
            <details class="group px-6 py-4">
              <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
                <span class="flex items-center justify-between gap-4">
                  {copy.vraag}
                  <span class="text-brand-primary transition group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-3 text-sm text-brand-muted">{copy.antwoord}</p>
            </details>
          );
        })}
      </div>
    </section>
  )}
  </div>
</Layout>
