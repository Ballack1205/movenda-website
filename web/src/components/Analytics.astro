---
// GA4 with Consent Mode v2: nothing is sent until the visitor explicitly
// accepts. `settings.analytics.enabled` is Julie's master switch in the
// Studio (siteSettings -> Analytics) — leave it off entirely to disable
// analytics site-wide regardless of consent.
import { getSiteSettings } from "../lib/content";

export interface Props {
  lang?: "nl" | "en";
}

const { lang = "nl" } = Astro.props;
const settings = await getSiteSettings();
const { enabled, ga4Id } = settings.analytics;
---

{enabled && ga4Id && (
  <>
    <script define:vars={{ ga4Id }} is:inline>
      // Consent Mode v2: default to denied for anything non-essential,
      // *before* gtag.js loads, so nothing is measured pre-consent.
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });
      gtag("js", new Date());
      gtag("config", ga4Id, { anonymize_ip: true });

      // Restore a previous decision instead of asking again every visit.
      try {
        const stored = localStorage.getItem("movenda-consent");
        if (stored === "granted") {
          gtag("consent", "update", { ad_storage: "denied", analytics_storage: "granted" });
        }
      } catch {}
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} is:inline></script>

    <div
      data-consent-banner
      class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl rounded-2xl border border-brand-border bg-brand-bg p-5 shadow-lg"
      hidden
    >
      <p class="text-sm text-brand-muted">
        {lang === "en"
          ? "We use cookies to understand how visitors use this site. No data is collected until you accept."
          : "We gebruiken cookies om te begrijpen hoe bezoekers deze site gebruiken. Er wordt niets verzameld tot je akkoord gaat."}
      </p>
      <div class="mt-3 flex gap-2">
        <button
          type="button"
          data-consent-accept
          class="rounded-full bg-brand-primary px-4 py-2 text-sm font-semibold text-white"
        >
          {lang === "en" ? "Accept" : "Accepteren"}
        </button>
        <button
          type="button"
          data-consent-reject
          class="rounded-full border border-brand-border px-4 py-2 text-sm font-semibold text-brand-text"
        >
          {lang === "en" ? "Reject" : "Weigeren"}
        </button>
      </div>
    </div>

    <script is:inline>
      (function () {
        var banner = document.querySelector("[data-consent-banner]");
        if (!banner) return;
        var stored;
        try {
          stored = localStorage.getItem("movenda-consent");
        } catch {
          stored = null;
        }
        if (!stored) banner.hidden = false;

        banner.querySelector("[data-consent-accept]")?.addEventListener("click", function () {
          try {
            localStorage.setItem("movenda-consent", "granted");
          } catch {}
          window.gtag?.("consent", "update", { analytics_storage: "granted" });
          banner.hidden = true;
        });
        banner.querySelector("[data-consent-reject]")?.addEventListener("click", function () {
          try {
            localStorage.setItem("movenda-consent", "denied");
          } catch {}
          banner.hidden = true;
        });
      })();

      // Conversion events: bel-klik, mail-klik, route-klik, boekknop-klik.
      // Form-submit success already fires its own event from contact.astro.
      // Fires only if gtag exists (i.e. analytics enabled) — a no-op cost
      // otherwise, so this is safe to always attach.
      document.addEventListener("click", function (e) {
        var target = e.target.closest && e.target.closest("a");
        if (!target || !window.gtag) return;
        var href = target.getAttribute("href") || "";
        if (href.startsWith("tel:")) {
          window.gtag("event", "contact_click", { method: "phone" });
        } else if (href.startsWith("mailto:")) {
          window.gtag("event", "contact_click", { method: "email" });
        } else if (href.includes("google.com/maps")) {
          window.gtag("event", "contact_click", { method: "route" });
        } else if (target.getAttribute("data-cta") === "booking") {
          window.gtag("event", "booking_click");
        }
      });
    </script>
  </>
)}
