---
/**
 * Homepage Instagram block — same Elfsight widget as movenda.be
 * ("Untitled Instagram Feed 2"), placed above the newsletter.
 * Julie can hide it or swap the widget ID in Site-instellingen.
 */
import type { SiteSettings } from "../lib/content";
import SocialLinks from "./SocialLinks.astro";

interface Props {
  settings: SiteSettings;
  lang?: "nl" | "en";
  title?: string;
}

const { settings, lang = "nl", title } = Astro.props;
const feed = settings.instagramFeed;
const widgetId = feed.widgetId?.trim();
const show = feed.enabled && !!widgetId;
const heading = title || (lang === "en" ? "Follow us" : feed.titel || "Volg ons");
const fallbackLabel = lang === "en" ? "Open our Instagram" : "Open onze Instagram";
---

{
  // pt-6 (not the old pt-10/pt-14) so "Volg ons" sits closer under the
  // Google reviews block above — combined with that block's own bottom
  // padding, the gap here matches the gap above the Google reviews block
  // (see the comment in GoogleReviewsFeed.astro).
  show && (
    <section class="instagram-feed scroll-mt-24 px-4 pb-4 pt-6" aria-labelledby="instagram-heading">
      <div class="mx-auto max-w-6xl">
        <div class="flex flex-col items-center text-center">
          <h2 id="instagram-heading" class="text-2xl font-bold sm:text-3xl">
            {heading}
          </h2>
          <SocialLinks lang={lang} class="mt-3 justify-center" />
        </div>

        <div class="instagram-feed-widget mt-6 min-h-[22rem] sm:mt-8 sm:min-h-[28rem]">
          <div class={`elfsight-app-${widgetId}`} data-elfsight-app-lazy></div>
        </div>

        <noscript>
          <p class="mt-4 text-center text-sm text-brand-muted">
            <a
              href={settings.socials.instagram}
              class="font-semibold text-brand-primary hover:underline"
              target="_blank"
              rel="noopener"
            >
              {fallbackLabel} →
            </a>
          </p>
        </noscript>
      </div>

      <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
    </section>
  )
}
