---
import Layout from "../layouts/Layout.astro";
import LinkedText from "./LinkedText.astro";
import { getPagina, getSiteSettings, paginaTekst, tekstChunks } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import type { Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const pagina = await getPagina("kine-abonnement");
const settings = await getSiteSettings();
const intro = tekstChunks(paginaTekst(pagina, "intro", lang));
const path = `${prefix}/kine-abonnement`;
const crumb = en ? "Physio membership" : "Kiné-abonnement";
---

<Layout
  title={paginaTekst(pagina, "seoTitle", lang) || (en ? "Physio fitness membership | Movenda Hasselt" : "Kiné-fitnessabonnement | Movenda Hasselt")}
  description={paginaTekst(pagina, "seoDescription", lang)}
  path={path}
  altPath={en ? "/kine-abonnement" : "/en/kine-abonnement"}
  lang={lang}
  jsonLd={[breadcrumbSchema([{ name: "Home", path: prefix || "/" }, { name: crumb, path }])]}
>
  <section class="page-ink mx-auto grid max-w-6xl items-start gap-10 px-4 py-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(16rem,26rem)]">
    <div>
    {paginaTekst(pagina, "ondertitel", lang) && <p class="brief-kicker">{paginaTekst(pagina, "ondertitel", lang)}</p>}
    <h1 class="brief-title brief-title--wide">{paginaTekst(pagina, "titel", lang)}</h1>
    {intro.map((chunk) =>
      chunk.kind === "ul" ? (
        <ul class="brief-lead list-disc space-y-1 pl-5">
          {chunk.lines.map((line) => (
            <li>
              <LinkedText text={line} />
            </li>
          ))}
        </ul>
      ) : (
        chunk.lines.map((line) => (
          <p class="brief-lead">
            <LinkedText text={line} />
          </p>
        ))
      ),
    )}
    <p class="brief-kicker mt-10">{en ? "More information?" : "Meer info?"}</p>
    <a class="brief-textlink" href={`mailto:${settings.email}`}>{settings.email}</a>
    </div>
    <img
      src="/marketing/kine-fitness-abo.jpg"
      alt={en ? "Olympia and Movenda physio fitness membership, 40 euro a month" : "Kine-fitnessabonnement van Olympia en Movenda, 40 euro per maand"}
      width="987"
      height="1400"
      class="mx-auto h-auto w-full max-w-md"
    />
  </section>
</Layout>
