---
import { getBlogPostsVoorDienst, type Dienst, type Locatie, type Teamlid } from "../lib/content";
import { dienstPhotoSrc, teamPhotoSrc } from "../lib/images";
import { localizeHref, withLang } from "../lib/i18n";
import BlogPostCard from "./BlogPostCard.astro";

interface Props {
  dienst: Dienst;
  team: Teamlid[];
  locatie: Locatie;
  backHref: string;
  backLabel: string;
  lang?: "nl" | "en";
}

const { dienst, team, locatie, backHref, backLabel, lang = "nl" } = Astro.props;
const rawTitel = lang === "en" ? dienst.titelEn || dienst.titel : dienst.titel;
const titel = rawTitel.replace(/\s+(in\s+)?Hasselt$/i, "");
function zinCase(text: string): string {
  const trimmed = text.trim();
  if (!trimmed || trimmed !== trimmed.toLocaleUpperCase("nl")) return trimmed;
  const lower = trimmed.toLocaleLowerCase("nl");
  return lower.replace(/(^|[.!?]\s+)(\p{L})/gu, (_lead, lead: string, letter: string) => lead + letter.toLocaleUpperCase("nl"));
}
const slogan = zinCase((lang === "en" ? dienst.sloganEn || dienst.slogan : dienst.slogan) || "");
const body = lang === "en" ? dienst.bodyEn || dienst.body : dienst.body;
const manueel = dienst.slug === "manuele-therapie";
const listLabel = /^(Voor wie|Zo werken we|Who it's for|How we work)\s*:?\s*/i;
const expectLabel = /^(Wat je mag verwachten|What to expect)\s*:?\s*/i;
const duurStart = /^(elke behandeling duurt|each (treatment|session) lasts)/i;
const duurLabel = /^(Duur|Duration)\s*:?\s*/i;
const locLabel = /^(Locatie|Location)\s*:?\s*/i;
const relatedLabel = /^(Gerelateerd|Related)\s*:?\s*/i;
const intro: string[] = [];
const lists: { title: string; items: string[] }[] = [];
let verwacht: { title: string; text: string } | undefined;
let duurTekst = "";
let locatieTekst = "";
const related: { label: string; href: string }[] = [];
const listItems = (rest: string) => {
  const parts = rest.includes("\n") ? rest.split(/\n+/) : rest.split(/(?<!-),\s+/);
  return parts.map((item) => item.replace(/^en\s+/i, "").replace(/\.$/, "").trim()).filter(Boolean);
};
for (const raw of (body || "").split(/\n\n+/).map((p) => p.trim()).filter(Boolean)) {
  if (duurStart.test(raw)) {
    duurTekst = raw.replace(/\s*Locatie:[\s\S]*$/i, "").trim();
    const loc = raw.match(/\bLocatie:\s*([\s\S]*)$/i);
    if (loc) locatieTekst = loc[1].trim();
    continue;
  }
  if (duurLabel.test(raw)) {
    duurTekst = raw.replace(duurLabel, "").trim();
    continue;
  }
  if (locLabel.test(raw)) {
    locatieTekst = raw.replace(locLabel, "").trim();
    continue;
  }
  const expected = raw.match(expectLabel);
  if (expected) {
    verwacht = { title: expected[1], text: raw.slice(expected[0].length).trim() };
    continue;
  }
  if (relatedLabel.test(raw)) {
    for (const line of raw.replace(relatedLabel, "").split(/\n+/)) {
      const [label, href] = line.split("|").map((part) => part.trim());
      if (label && href) related.push({ label, href: localizeHref(href, lang) });
    }
    continue;
  }
  const match = raw.match(listLabel);
  if (!match) {
    intro.push(raw);
    continue;
  }
  lists.push({ title: match[1], items: listItems(raw.slice(match[0].length)) });
}
if (manueel) {
  duurTekst = lang === "en"
    ? "Each treatment lasts about 30 minutes, including administration and changing. Extra independent practice time is possible when it fits the programme."
    : "Elke behandeling duurt +/- 30 minuten, inclusief administratie en omkleden. Aanvullende zelfstandige oefentijd is mogelijk wanneer dit binnen je traject past.";
}
const knownLocaties = [
  { href: withLang("/locaties/olympia", lang), label: "Sportpraktijk Movenda Hasselt", test: /hasselt/i },
  { href: withLang("/locaties/mpc", lang), label: "Performance Centre Kuringen", test: /kuringen|performance\s*cent(?:re|er)/i },
];
const locatieLinks = manueel && !locatieTekst
  ? knownLocaties
  : knownLocaties.filter((link) => link.test.test(locatieTekst));
const showPraktisch = manueel || Boolean(duurTekst) || locatieLinks.length > 0;
const dutchCta = /afspraak|contacteer|boek/i.test(dienst.ctaLabel || "");
const ctaLabel = manueel
  ? lang === "en"
    ? "Book an appointment for manual therapy"
    : "Plan je afspraak voor manuele therapie"
  : lang === "en"
    ? dienst.ctaLabelEn || (dienst.ctaLabel && !dutchCta ? dienst.ctaLabel : "Contact us")
    : dienst.ctaLabel || "Maak een afspraak";
const ctaUrl = localizeHref(dienst.ctaUrl, lang);
// "Lees ook": articles Julie linked to this dienst (Blogpost → "Gaat over deze behandelingen"),
// topped up with posts that mention it. Internal links dienst ↔ blog are what make the blog
// count for the ranking of the treatment pages.
const posts = await getBlogPostsVoorDienst(dienst, 3);
const heroSrc = manueel
  ? "/marketing/manuele-therapie.jpg"
  : dienst.afbeelding
    ? dienstPhotoSrc(dienst.afbeelding, "hero")
    : "";

---

<article class="pb-16">
  <header class="dienst-hero">
    {heroSrc && (
      <img
        src={heroSrc}
        alt={manueel ? (lang === "en" ? "A therapist treats a back with manual therapy" : "Therapeut behandelt een rug met manuele therapie") : ""}
        width={manueel ? 2200 : 1600}
        height={manueel ? 1467 : 900}
        class:list={[manueel && "dienst-hero__bw"]}
      />
    )}
    <div class="dienst-hero__copy">
      <a href={backHref} class="text-sm font-medium">{backLabel}</a>
      <h1 class="mt-4">{titel}</h1>
      {slogan && <p>{slogan}</p>}
    </div>
  </header>

  <div class="dienst-copy mx-auto max-w-3xl px-4">
    {intro.map((p) => (
      <p>{p}</p>
    ))}
    {lists.map((list) => (
      <section>
        <h2>{list.title}</h2>
        <ul>
          {list.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    ))}
    {verwacht && (
      <section>
        <h2>{verwacht.title}</h2>
        <p>{verwacht.text}</p>
      </section>
    )}
    {showPraktisch && (
      <section>
        <h2>{lang === "en" ? "Practical" : "Praktisch"}</h2>
        {duurTekst && (
          <>
            <h3>{lang === "en" ? "Duration" : "Duur"}</h3>
            <p>{duurTekst}</p>
          </>
        )}
        {locatieLinks.length > 0 && (
          <>
            <h3>{lang === "en" ? "Location" : "Locatie"}</h3>
            <ul>
              {locatieLinks.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </>
        )}
        {related.length > 0 && (
          <>
            <h3>{lang === "en" ? "Related" : "Gerelateerd"}</h3>
            <ul>
              {related.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}
  </div>

  {dienst.galerij.length > 0 && (
    <div class="photo-band mt-10" aria-hidden="true">
      <div class="photo-band__track">
        {[...dienst.galerij, ...dienst.galerij].map((src) => (
          <img src={dienstPhotoSrc(src, "gallery")} alt="" width="640" height="420" loading="lazy" class="h-56 w-auto max-w-none object-cover" />
        ))}
      </div>
    </div>
  )}

  <div class="mx-auto max-w-3xl px-4">
  {team.length > 0 && (
    <div class="mt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">
        {lang === "en" ? "Our specialists" : "Onze specialisten"}
      </h2>
      <div class="mt-3 flex flex-wrap gap-3">
        {team.map((lid) => (
          <a
            href={withLang(`/team/${lid.slug}`, lang)}
            class="flex items-center gap-2 rounded-full border border-brand-border px-3 py-1.5 text-sm transition hover:border-brand-primary"
          >
            <span class="h-7 w-7 overflow-hidden rounded-full bg-brand-header">
              {lid.foto ? (
                <img src={teamPhotoSrc(lid.foto, "face")} alt="" width="28" height="28" class="h-full w-full object-cover" />
              ) : (
                <span class="flex h-full w-full items-center justify-center text-[10px] font-bold text-white/80">
                  {lid.voornaam[0]}{lid.naam[0]}
                </span>
              )}
            </span>
            {lid.voornaam} {lid.naam}
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="mt-10 flex flex-wrap items-center gap-3">
    <a href={ctaUrl} class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark">
      {ctaLabel}
    </a>
    <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="text-sm font-semibold text-brand-primary hover:underline">
      {locatie.telefoon}
    </a>
  </div>

  {posts.length > 0 && (
    <aside class="mt-14 border-t border-brand-border pt-10">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">
        {lang === "en" ? "Read more about this" : "Lees ook"}
      </h2>
      <div class={`mt-4 grid gap-6 ${posts.length > 1 ? "sm:grid-cols-2" : ""}`}>
        {posts.map((post) => (
          <BlogPostCard post={post} lang={lang} />
        ))}
      </div>
    </aside>
  )}
  </div>
</article>

<style>
  .dienst-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 72vh;
    color: #f4f7fb;
    background: #161513;
  }

  .dienst-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dienst-hero__bw {
    object-position: center 62%;
  }

  .dienst-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(14 16 18 / 0.78), rgb(14 16 18 / 0.12) 58%);
  }

  .dienst-hero__copy {
    position: relative;
    z-index: 1;
    width: min(72rem, 100%);
    margin-inline: auto;
    padding: 7.5rem 1.25rem 2.75rem;
  }

  .dienst-hero a {
    color: inherit;
  }

  .dienst-hero h1 {
    max-width: 16ch;
    font-size: clamp(2.6rem, 1.5rem + 3.4vw, 4.75rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .dienst-hero p {
    max-width: 28rem;
    margin-top: 0.85rem;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .dienst-copy {
    padding-top: 2.5rem;
  }

  .dienst-copy > p,
  .dienst-copy li {
    margin-top: 0.85rem;
    line-height: 1.65;
    color: var(--brand-muted);
  }

  .dienst-copy h2 {
    margin-top: 2.25rem;
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--brand-text);
  }

  .dienst-copy h3 {
    margin-top: 1.15rem;
    font-size: 1rem;
    font-weight: 650;
    color: var(--brand-text);
  }

  .dienst-copy ul {
    margin-top: 0.35rem;
    padding-left: 1.15rem;
    list-style: disc;
  }

  .dienst-copy a {
    color: var(--brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
