---
import Layout from "../layouts/Layout.astro";
import BlogPostCard from "./BlogPostCard.astro";
import SectionKicker from "./SectionKicker.astro";
import { getBlogPosts } from "../lib/content";
import { blogListSchema, breadcrumbSchema } from "../lib/schema";
import { BLOG_TAGS, TAG_INDEX_MIN_POSTS, blogTagLabel } from "../lib/blog";
import { withLang, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
  tag: string;
}

const { lang = "nl", tag } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const allPosts = await getBlogPosts();
const posts = allPosts.filter((post) => post.tags?.includes(tag));
const label = blogTagLabel(tag, lang);
const others = BLOG_TAGS.filter((item) => item.value !== tag && allPosts.some((post) => post.tags?.includes(item.value)));
const path = `${prefix}/blog/tag/${tag}`;
---

<Layout
  title={`${label} | Blog | Movenda Hasselt`}
  description={en
    ? `Articles on ${label.toLowerCase()} by the physiotherapists and trainers of Movenda in Hasselt: causes, exercises, prevention and recovery.`
    : `Artikels over ${label.toLowerCase()} van de kinesisten en trainers van Movenda in Hasselt: oorzaken, oefeningen, preventie en herstel.`}
  path={path}
  altPath={en ? `/blog/tag/${tag}` : `/en/blog/tag/${tag}`}
  lang={lang}
  noindex={posts.length < TAG_INDEX_MIN_POSTS}
  jsonLd={[
    breadcrumbSchema([
      { name: "Home", path: prefix || "/" },
      { name: "Blog", path: `${prefix}/blog` },
      { name: label, path },
    ]),
    blogListSchema(posts, lang),
  ]}
>
  <section class="page-ink mx-auto max-w-6xl px-4 py-12 lg:py-16">
    <a href={withLang("/blog", lang)} class="text-sm font-semibold text-brand-primary hover:underline">← Blog</a>
    <p class="mt-5 text-sm font-semibold uppercase tracking-wide text-brand-primary">{en ? "Topic" : "Onderwerp"}</p>
    <SectionKicker n={1} />
    <h1 class="mt-2 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">{label}</h1>
    <p class="mt-4 max-w-2xl text-lg text-brand-muted">
      {en
        ? `${posts.length === 1 ? "One article" : `${posts.length} articles`} on ${label.toLowerCase()}, written by the Movenda team in Hasselt.`
        : `${posts.length === 1 ? "Eén artikel" : `${posts.length} artikels`} over ${label.toLowerCase()}, geschreven door het team van Movenda in Hasselt.`}
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <BlogPostCard post={post} lang={lang} />
      ))}
    </div>

    {others.length > 0 && (
      <nav class="mt-14" aria-label={en ? "Other topics" : "Andere onderwerpen"}>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">{en ? "Other topics" : "Andere onderwerpen"}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {others.map((item) => (
            <li>
              <a
                href={withLang(`/blog/tag/${item.value}`, lang)}
                class="inline-block rounded-full border border-brand-border px-3 py-1.5 text-sm font-semibold text-brand-text transition hover:border-brand-primary hover:text-brand-primary"
              >
                {blogTagLabel(item.value, lang)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </section>
</Layout>
