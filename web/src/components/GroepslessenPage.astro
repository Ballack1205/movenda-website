---
import Layout from "../layouts/Layout.astro";
import {
  getLesrooster,
  getLocatieBySlug,
  getPrijzenByCategorie,
  formatPrijs,
  getDiensten,
  formulierTekst,
  getPagina,
  getSiteSettings,
  lesHref,
  paginaAlineas,
  paginaBlokKop,
  paginaBlokTekst,
  paginaParagrafen,
  paginaTekst,
  uiTekst,
  prijsNaam,
  tekstChunks,
} from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import { floorNote, weekday, WEEKDAYS_NL, withLang, type Lang } from "../lib/i18n";
import LinkedText from "./LinkedText.astro";
import PaginaFoto from "./PaginaFoto.astro";
import gxHero from "../assets/marketing/home-gx.jpg";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";

const pagina = await getPagina("groepslessen");
const settings = await getSiteSettings();
const f = (key: string) => formulierTekst(pagina, key, lang);
const gedeeld = (key: string) => uiTekst(settings, "formulier", key, lang);
const locatie = (await getLocatieBySlug("mpc"))!;
const rooster = await getLesrooster();
const diensten = await getDiensten();
const memberships = await getPrijzenByCategorie("mpc-groep");
const extra = paginaParagrafen(pagina, "extraTekst", lang);
const floor = floorNote(locatie.verdiepingNote, lang);

const copy = {
  seoTitle: paginaTekst(pagina, "seoTitle", lang),
  crumbHome: "Home",
  crumbMpc: "Movenda Performance Centre",
  crumb: uiTekst(settings, "menu", "groepslessen", lang),
  trial: f("proefles"),
  timetable: f("rooster"),
  none: f("geenLes"),
  memberships: f("abonnementen"),
  allFees: f("alleTarieven"),
  signup: f("inschrijven"),
  name: gedeeld("naam"),
  email: gedeeld("email"),
  phone: gedeeld("telefoon"),
  className: f("les"),
  message: f("gxBericht"),
  send: f("gxVerstuur"),
  busy: f("gxBezig"),
  ok: f("gxGelukt"),
  fail: f("gxMislukt"),
};

const jsonLd = [
  breadcrumbSchema([
    { name: copy.crumbHome, path: prefix || "/" },
    { name: copy.crumbMpc, path: `${prefix}/performance` },
    { name: copy.crumb, path: `${prefix}/groepslessen` },
  ]),
];
---

<Layout
  title={paginaTekst(pagina, "seoTitle", lang) || copy.seoTitle}
  description={paginaTekst(pagina, "seoDescription", lang)}
  path={`${prefix}/groepslessen`}
  altPath={en ? "/groepslessen" : "/en/groepslessen"}
  lang={lang}
  jsonLd={jsonLd}
>
  <section class="page-ink mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h1>{paginaTekst(pagina, "titel", lang)}</h1>
        {paginaTekst(pagina, "slogan", lang) && (
          <p class="mt-4 text-brand-muted">{paginaTekst(pagina, "slogan", lang)}</p>
        )}
        {paginaAlineas(pagina, lang).map((tekst) => (
          <p class="mt-4 text-brand-muted"><LinkedText text={tekst} /></p>
        ))}
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="#inschrijven" class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white">{copy.trial}</a>
        </div>
      </div>
      <PaginaFoto
        pagina={pagina}
        fallback={gxHero}
        alt={pagina.fotoAlt || (en ? "A small group training at Movenda" : "Een kleine groep traint bij Movenda")}
        width={640}
        height={720}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 42vw, 100vw"
        class="aspect-[4/4.5] w-full object-cover"
        priority
      />
    </div>
    {pagina.blokken.map((blok) => (
      <>
        <h2 class="mt-8 text-xl font-bold">{paginaBlokKop(blok, lang)}</h2>
        {tekstChunks(paginaBlokTekst(blok, lang)).map((chunk) =>
          chunk.kind === "ul" ? (
            <ul class="mt-3 max-w-3xl list-disc space-y-1 pl-5 text-brand-muted">
              {chunk.lines.map((line) => <li>{line}</li>)}
            </ul>
          ) : (
            <p class="mt-3 max-w-3xl text-brand-muted"><LinkedText text={chunk.lines[0]} /></p>
          ),
        )}
      </>
    ))}
    {extra.map((tekst, i, all) => (
      <p class="mt-6 max-w-3xl text-brand-muted">
        <LinkedText text={tekst} />{i === all.length - 1 && floor ? ` ${floor}` : ""}
      </p>
    ))}
    <h2 class="mt-16 text-xl font-bold">{copy.timetable}</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {WEEKDAYS_NL.map((dag) => {
        const lessen = rooster.filter((r) => r.dag === dag);
        return (
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-5">
            <h3 class="font-semibold text-brand-primary">{weekday(dag, lang)}</h3>
            {lessen.length === 0 ? (
              <p class="mt-2 text-sm text-brand-muted">{copy.none}</p>
            ) : (
              <ul class="mt-3 space-y-2 text-sm">
                {lessen.map((les) => (
                  <li>
                    <a href={lesHref(les, diensten, lang)} class="flex min-h-11 items-center gap-1 py-1 hover:underline">
                      <span class="font-medium">{les.van}–{les.tot}</span>
                      <span>· {en ? les.lesEn || les.les : les.les}</span>
                      {les.coachNaam && <span class="text-brand-muted"> — {les.coachNaam}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>

    {memberships.length > 0 && (
      <div class="mt-12">
        <h2 class="text-xl font-bold">{copy.memberships}</h2>
        <p class="mt-2 text-sm text-brand-muted">
          {paginaTekst(pagina, "prijsNotitie", lang)}
          {" "}
          <a href={withLang("/performance/prijzen", lang)} class="font-medium text-brand-primary hover:underline">{copy.allFees}</a>
        </p>
        <div class="mt-4 overflow-x-auto rounded-2xl border border-brand-border">
          <table class="w-full min-w-[28rem] text-left text-sm">
            <tbody>
              {memberships.map((item, i) => (
                <tr class={i % 2 === 0 ? "bg-brand-surface" : ""}>
                  <td class="px-4 py-3">{prijsNaam(item, lang)}</td>
                  <td class="px-4 py-3 text-right font-semibold text-brand-primary">{formatPrijs(item, lang)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <form
      id="inschrijven"
      class="mt-12 max-w-xl space-y-3"
      data-groep-form
      data-busy={copy.busy}
      data-ok={copy.ok}
      data-fail={copy.fail}
    >
      <h2 class="text-xl font-bold">{copy.signup}</h2>
      {paginaTekst(pagina, "formulierIntro", lang) && (
        <p class="text-sm text-brand-muted">{paginaTekst(pagina, "formulierIntro", lang)}</p>
      )}
      <input class="w-full rounded-lg border border-brand-border px-4 py-3" name="naam" placeholder={copy.name} required />
      <input class="w-full rounded-lg border border-brand-border px-4 py-3" type="email" name="email" placeholder={copy.email} required />
      <input class="w-full rounded-lg border border-brand-border px-4 py-3" type="tel" name="telefoon" placeholder={copy.phone} />
      <input class="w-full rounded-lg border border-brand-border px-4 py-3" name="les" placeholder={copy.className} required />
      <textarea class="w-full rounded-lg border border-brand-border px-4 py-3" name="bericht" rows="3" placeholder={copy.message}></textarea>
      <input class="hidden" name="website" tabindex="-1" autocomplete="off" />
      <button class="rounded-full bg-brand-primary px-6 py-3 font-semibold text-white" type="submit">{copy.send}</button>
      <p class="hidden text-sm" data-groep-status></p>
    </form>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-groep-form]");
  const status = document.querySelector<HTMLElement>("[data-groep-status]");
  const api = import.meta.env.PUBLIC_CONTACT_API_URL || "https://movenda-contact-api.onrender.com";
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status) return;
    const data = Object.fromEntries(new FormData(form).entries());
    status.classList.remove("hidden");
    status.textContent = form.dataset.busy || "";
    try {
      const res = await fetch(`${api}/api/groepslessen`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("send");
      form.reset();
      status.textContent = form.dataset.ok || "";
    } catch {
      status.textContent = form.dataset.fail || "";
    }
  });
</script>
