---
import Layout from "../layouts/Layout.astro";
import Routebeschrijving from "./Routebeschrijving.astro";
import ContactVerwijsVraag from "./ContactVerwijsVraag.astro";
import { getLocaties, getPagina, paginaTekst } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import { byAppointment, legalCourt, weekday, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";

const locaties = (await getLocaties()).sort((a, b) =>
  a.slug === "olympia" ? -1 : b.slug === "olympia" ? 1 : 0,
);
const pagina = await getPagina("contact");
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || "https://movenda-contact-api.onrender.com";
const olympia = locaties.find((l) => l.slug === "olympia");
const mapSrc = (adres: string) =>
  `https://maps.google.com/maps?q=${encodeURIComponent(adres)}&z=15&output=embed`;

const copy = en
  ? {
      seoTitle: "Contact & appointments | Movenda Hasselt",
      crumb: "Contact",
      name: "Name",
      email: "Email",
      phone: "Phone",
      which: "Which location?",
      reasonLegend: "What would you like to come in for?",
      physio: "Physiotherapy",
      training: "Personal training",
      other: "Other",
      prescriptionLegend: "Do you have a doctor's prescription?",
      prescriptionHint: "Only needed for physiotherapy",
      yes: "Yes",
      no: "No",
      na: "Not applicable",
      message: "Your question or message",
      send: "Send my question",
      sending: "Sending…",
      thanks: "Thanks for your message! We received your request and will get back to you as soon as possible.",
      fail: "Something went wrong sending this. Please call or email us directly — see the details below.",
      vat: "VAT",
      map: "Map",
      photoMpc: "Entrance of the Performance Centre on Lammerweg",
      photoOlympia: "Entrance of Movenda on Kuringersteenweg",
      route: "First visit to Movenda?",
    }
  : {
      seoTitle: "Contact & afspraak | Movenda Hasselt",
      crumb: "Contact",
      name: "Naam",
      email: "E-mail",
      phone: "Telefoon",
      which: "Voor welke vestiging?",
      reasonLegend: "Waarvoor wil je langskomen?",
      physio: "Kinesitherapie",
      training: "Personal Training",
      other: "Andere",
      prescriptionLegend: "Heb je een voorschrift van je arts?",
      prescriptionHint: "Enkel van toepassing voor kinesitherapie",
      yes: "Ja",
      no: "Nee",
      na: "Niet van toepassing",
      message: "Jouw vraag of bericht",
      send: "Verstuur mijn vraag",
      sending: "Verzenden…",
      thanks: "Bedankt voor je bericht! We hebben je aanvraag goed ontvangen en nemen zo snel mogelijk contact met je op.",
      fail: "Er ging iets mis bij het verzenden. Bel of mail ons gerust rechtstreeks — zie de gegevens hieronder.",
      vat: "BTW",
      map: "Kaart",
      photoMpc: "Ingang van Performance Centre aan de Lammerweg",
      photoOlympia: "Ingang van Movenda aan de Kuringersteenweg",
      route: "Eerste keer bij Movenda?",
    };

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: prefix || "/" },
    { name: copy.crumb, path: `${prefix}/contact` },
  ]),
];
---

<Layout
  title={paginaTekst(pagina, "seoTitle", lang) || copy.seoTitle}
  description={paginaTekst(pagina, "seoDescription", lang)}
  path={`${prefix}/contact`}
  altPath={en ? "/contact" : "/en/contact"}
  lang={lang}
  jsonLd={jsonLd}
>
  <div class="page-ink">
  <section class="px-4 pb-4 pt-8 md:px-12">
    <form class="grid gap-4" data-contact-form>
      <div class="grid gap-4 sm:grid-cols-2">
        <input class="rounded-lg border border-brand-border px-4 py-3" type="text" name="naam" placeholder={copy.name} required />
        <input class="rounded-lg border border-brand-border px-4 py-3" type="email" name="email" placeholder={copy.email} required />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <input class="rounded-lg border border-brand-border px-4 py-3" type="tel" name="telefoon" placeholder={copy.phone} required />
        <select class="rounded-lg border border-brand-border px-4 py-3" name="locatie">
          <option value="">{copy.which}</option>
          <option value="Movenda — Kuringersteenweg">Movenda — Kuringersteenweg</option>
          <option value="Performance Centre — Lammerweg">Performance Centre — Lammerweg</option>
        </select>
      </div>
      <ContactVerwijsVraag opties={pagina.verwijsopties} lang={lang} />
      <fieldset class="rounded-lg border border-brand-border px-4 py-3">
        <legend class="px-1 text-sm font-semibold">{copy.reasonLegend}</legend>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm">
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="waarvoor" value="Kinesitherapie" /> {copy.physio}</label>
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="waarvoor" value="Personal Training" /> {copy.training}</label>
          <label class="inline-flex items-center gap-2"><input type="checkbox" name="waarvoor" value="Andere" /> {copy.other}</label>
        </div>
      </fieldset>
      <fieldset class="rounded-lg border border-brand-border px-4 py-3">
        <legend class="px-1 text-sm font-semibold">{copy.prescriptionLegend}</legend>
        <p class="text-xs text-brand-muted">{copy.prescriptionHint}</p>
        <div class="mt-3 flex flex-wrap gap-x-6 gap-y-3 text-sm">
          <label class="inline-flex items-center gap-2"><input type="radio" name="voorschrift" value="Ja" /> {copy.yes}</label>
          <label class="inline-flex items-center gap-2"><input type="radio" name="voorschrift" value="Nee" /> {copy.no}</label>
          <label class="inline-flex items-center gap-2"><input type="radio" name="voorschrift" value="Niet van toepassing" /> {copy.na}</label>
        </div>
      </fieldset>
      <textarea class="rounded-lg border border-brand-border px-4 py-3" name="bericht" rows="5" placeholder={copy.message} required minlength="5"></textarea>
      <input class="hidden" type="text" name="website" tabindex="-1" autocomplete="off" />
      <button type="submit" class="w-fit rounded-full bg-brand-primary px-6 py-3 font-semibold text-white transition hover:bg-brand-primary-dark">
        {copy.send}
      </button>
      <p class="text-sm" data-contact-status role="status" aria-live="polite"></p>
    </form>
  </section>

  <section class="grid md:grid-cols-2">
    {locaties.map((locatie) => (
        <div class="flex min-h-[24rem] flex-col border-brand-border md:border-r md:last:border-r-0">
          {locatie.foto && (
            <img
              src={locatie.foto}
              alt={locatie.slug === "mpc" ? copy.photoMpc : copy.photoOlympia}
              width="1600"
              height="1067"
              class="aspect-[16/10] w-full object-cover object-[center_30%]"
            />
          )}
          <div class="flex flex-1 flex-col justify-end p-8 md:p-12">
          <h2 class="text-3xl font-semibold">{locatie.slug === "mpc" ? "Performance Centre — Lammerweg" : "Movenda — Kuringersteenweg"}</h2>
          <p class="mt-2 text-sm text-brand-muted">{locatie.adres}</p>
          {locatie.urenNote && <p class="mt-1 text-xs text-brand-muted">{en ? locatie.urenNoteEn || byAppointment(locatie.urenNote, "en") : locatie.urenNote}</p>}
          <ul class="mt-3 space-y-1 text-sm text-brand-muted">
            {locatie.uren.map((u) => (
              <li class="flex justify-between gap-4">
                <span>{weekday(u.dag, lang)}</span>
                <span>{u.van}–{u.tot}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-4">
            <p class="text-sm">
              <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="font-semibold text-brand-primary hover:underline">
                {locatie.telefoon}
              </a>
            </p>
            <p class="text-sm">
              <a href={`mailto:${locatie.email}`} class="font-semibold text-brand-primary hover:underline">
                {locatie.email}
              </a>
            </p>
            <p class="mt-3 min-h-[2.5rem] text-xs text-brand-muted">
              {copy.vat} {locatie.btw}
              {locatie.iban && <> · IBAN {locatie.iban}</>}
              {locatie.bic && <> · BIC {locatie.bic}</>}
              {legalCourt(locatie.rpr, lang) && <> · {legalCourt(locatie.rpr, lang)}</>}
            </p>
            {locatie.instagram && (
              <a href={locatie.instagram} class="mt-2 inline-block text-xs font-semibold text-brand-primary hover:underline" target="_blank" rel="noopener">Instagram</a>
            )}
          </div>
          </div>
          <iframe
            title={`${copy.map} ${locatie.slug === "mpc" ? "Performance Centre" : "Movenda"}`}
            src={mapSrc(locatie.adres)}
            class="h-72 w-full border-0"
            loading="eager"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      ))}
  </section>

  <section class="px-4 pb-12 md:px-12">
    {olympia && (
      <Routebeschrijving
        locatie={olympia}
        title={copy.route}
        lang={lang}
      />
    )}
  </section>
  </div>
</Layout>

<script define:vars={{ apiUrl: contactApiUrl, sending: copy.sending, thanks: copy.thanks, fail: copy.fail }} is:inline>
  const form = document.querySelector("[data-contact-form]");
  const status = document.querySelector("[data-contact-status]");
  const locatie = new URLSearchParams(location.search).get("locatie");
  const locatieVeld = form?.querySelector("select[name=locatie]");
  if (locatie && locatieVeld) locatieVeld.value = locatie;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const waarvoor = fd.getAll("waarvoor");
    const data = Object.fromEntries(fd.entries());
    data.waarvoor = waarvoor.join(", ");
    const button = form.querySelector("button[type=submit]");
    button.disabled = true;
    status.textContent = sending;
    status.className = "text-sm text-brand-muted";

    try {
      const res = await fetch(`${apiUrl}/api/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("send_failed");
      status.textContent = thanks;
      status.className = "text-sm font-semibold text-brand-primary";
      window.mvTrack?.("form_submit", { form: "contact" });
      form.reset();
    } catch {
      status.textContent = fail;
      status.className = "text-sm font-semibold text-red-600";
    } finally {
      button.disabled = false;
    }
  });
</script>
