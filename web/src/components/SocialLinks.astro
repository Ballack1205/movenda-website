---
import { getLocatieBySlug, getSiteSettings } from "../lib/content";

interface Props {
  brand?: "movenda" | "mpc";
  lang?: "nl" | "en";
  class?: string;
}

const { brand = "movenda", lang = "nl", class: className = "" } = Astro.props;
const settings = await getSiteSettings();
const mpc = brand === "mpc" ? await getLocatieBySlug("mpc") : undefined;

const instagram = brand === "mpc" ? mpc?.instagram : settings.socials.instagram;
const facebook = brand === "mpc" ? mpc?.facebook : settings.socials.facebook;
const linkedin = settings.socials.linkedin;
const email = settings.email;

const who = brand === "mpc" ? "Movenda Performance Centre" : "Movenda";
const on = lang === "en" ? "on" : "op";
const links = [
  { kind: "instagram" as const, href: instagram, label: `${who} ${on} Instagram` },
  { kind: "linkedin" as const, href: linkedin, label: `${who} ${on} LinkedIn` },
  { kind: "facebook" as const, href: facebook, label: `${who} ${on} Facebook` },
  { kind: "email" as const, href: email ? `mailto:${email}` : "", label: email || (lang === "en" ? "Email" : "E-mail") },
].filter((l) => l.href);

const iconClass = "h-6 w-6";
---

{
  links.length > 0 && (
    <nav class:list={["flex items-center gap-2", className]} aria-label={lang === "en" ? "Social media" : "Sociale media"}>
      {links.map((l) => (
        <a
          href={l.href}
          class="inline-flex h-11 w-11 items-center justify-center rounded-full text-brand-muted transition hover:bg-white hover:text-brand-primary"
          aria-label={l.label}
          {...(l.kind !== "email" ? { target: "_blank", rel: "noopener" } : {})}
        >
          {l.kind === "instagram" && (
            <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          )}
          {l.kind === "linkedin" && (
            <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.5 8.5H3.5V20h3V8.5zM5 4a1.75 1.75 0 1 0 0 3.5A1.75 1.75 0 0 0 5 4zM20.5 13.2c0-3.2-1.7-4.9-4.1-4.9-1.6 0-2.6.9-3 1.6V8.5h-3V20h3v-6c0-1.6.6-2.7 2-2.7 1.3 0 1.8 1 1.8 2.7v6h3.3v-6.8z" />
            </svg>
          )}
          {l.kind === "facebook" && (
            <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z" />
            </svg>
          )}
          {l.kind === "email" && (
            <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          )}
        </a>
      ))}
    </nav>
  )
}
