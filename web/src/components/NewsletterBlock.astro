---
import type { SiteSettings } from "../lib/content";
import { NEWSLETTER_EN } from "../lib/i18n";

interface Props {
  settings: SiteSettings;
  lang?: "nl" | "en";
}

const { settings, lang = "nl" } = Astro.props;
const nb = settings.nieuwsbrief;
const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || "https://movenda-contact-api.onrender.com";
---

{
  nb.enabled && (
    <section class="relative isolate px-4 pb-16 pt-4 text-white sm:pb-24 sm:pt-8">

      <div class="relative mx-auto max-w-6xl overflow-hidden rounded-[1.75rem] bg-brand-header px-5 py-7 shadow-[0_24px_60px_-32px_rgba(7,75,120,0.8)] ring-1 ring-white/10 sm:rounded-[2rem] sm:px-10 sm:py-12 lg:px-14">
        <div class="pointer-events-none absolute -right-28 -top-36 h-80 w-80 rounded-full bg-white/[0.06] blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-40 -left-24 h-72 w-72 rounded-full bg-brand-primary/30 blur-3xl" aria-hidden="true"></div>

        <div class="relative grid gap-5 sm:gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14">
          <div class="text-center lg:text-left">
            <p class="text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-white/65 sm:text-sm">
              {lang === "en" ? "Movenda newsletter" : "Movenda nieuwsbrief"}
            </p>
            <h2 class="mt-1.5 text-xl font-bold leading-tight sm:mt-2 sm:text-3xl">
              {lang === "en" ? NEWSLETTER_EN.titel : nb.titel || "Blijf op de hoogte"}
            </h2>
            {(lang === "en" ? NEWSLETTER_EN.tekst : nb.tekst) && (
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/75 sm:mt-3 sm:text-base">
                {lang === "en" ? NEWSLETTER_EN.tekst : nb.tekst}
              </p>
            )}
          </div>

          <div>
            <form class="flex flex-col gap-3 sm:flex-row" data-newsletter-form>
              <label class="sr-only" for="newsletter-email">{lang === "en" ? "Email" : "E-mail"}</label>
              <input
                id="newsletter-email"
                class="min-w-0 flex-1 rounded-full border border-white/20 bg-white/10 px-5 py-2.5 text-sm text-white outline-none transition placeholder:text-white/50 focus:border-white/50 focus:ring-4 focus:ring-white/10 sm:py-3 sm:text-base"
                type="email"
                name="email"
                required
                placeholder={lang === "en" ? "Your email" : "Jouw e-mailadres"}
              />
              <input class="hidden" type="text" name="website" tabindex="-1" autocomplete="off" />
              <button type="submit" class="rounded-full bg-white px-6 py-2.5 text-sm font-semibold text-brand-header transition hover:bg-white/90 focus:outline-none focus:ring-4 focus:ring-white/20 sm:py-3 sm:text-base">
                {lang === "en" ? "Subscribe" : "Inschrijven"}
              </button>
            </form>
            {(lang === "en" ? NEWSLETTER_EN.socialProof : nb.socialProof) && (
              <p class="mt-2 text-center text-xs font-semibold text-white/65 sm:mt-3 sm:text-left sm:text-sm">
                {lang === "en" ? NEWSLETTER_EN.socialProof : nb.socialProof}
              </p>
            )}
            <p class="mt-2 text-xs text-white/80 empty:hidden sm:text-sm" data-newsletter-status role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>
    </section>
  )
}

<script define:vars={{ apiUrl, lang }} is:inline>
  const form = document.querySelector("[data-newsletter-form]");
  const status = document.querySelector("[data-newsletter-status]");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    const button = form.querySelector("button[type=submit]");
    button.disabled = true;
    status.textContent = lang === "en" ? "Sending…" : "Verzenden…";
    try {
      const res = await fetch(`${apiUrl}/api/newsletter`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error("failed");
      status.textContent =
        lang === "en"
          ? "Thanks — you're on the list."
          : "Bedankt — je staat op de lijst.";
      form.reset();
      window.mvTrack?.("form_submit", { form: "newsletter" });
    } catch {
      status.textContent =
        lang === "en"
          ? "Something went wrong. Please try again or email us."
          : "Er ging iets mis. Probeer opnieuw of mail ons.";
    } finally {
      button.disabled = false;
    }
  });
</script>
