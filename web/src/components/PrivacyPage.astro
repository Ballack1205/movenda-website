---
import Layout from "../layouts/Layout.astro";
import LinkedText from "./LinkedText.astro";
import SectionKicker from "./SectionKicker.astro";
import {
  getLocaties,
  getPagina,
  getSiteSettings,
  paginaBlokKop,
  paginaBlokTekst,
  paginaTekst,
  tekstChunks,
  uiTekst,
  type CookieRij,
} from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import type { Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";

const locaties = (await getLocaties()).sort((a, b) =>
  a.slug === "olympia" ? -1 : b.slug === "olympia" ? 1 : 0,
);
const settings = await getSiteSettings();
const pagina = await getPagina("privacy");
const { analytics, instagramFeed, googleReviewsFeed } = settings;
const gaActive = analytics.enabled && !!analytics.ga4Id;
const umamiActive = analytics.enabled && analytics.umami.enabled && !!analytics.umami.websiteId;
const instagramActive = instagramFeed.enabled && !!instagramFeed.widgetId;
const googleReviewsActive = googleReviewsFeed.enabled && !!googleReviewsFeed.widgetId;

function cookieZichtbaar(row: CookieRij): boolean {
  if (row.tool === "ga4") return gaActive;
  if (row.tool === "umami") return umamiActive;
  if (row.tool === "instagram") return instagramActive;
  if (row.tool === "googleReviews") return googleReviewsActive;
  return true;
}

const cookies = (pagina.cookies || []).filter(cookieZichtbaar);
const kolom = (field: "cookiesKolomNaam" | "cookiesKolomDoel" | "cookiesKolomTermijn" | "cookiesKolomToestemming") =>
  paginaTekst(pagina, field, lang);
const path = `${prefix}/privacy`;

function veld(_row: CookieRij, nl: string | undefined, enValue: string | undefined): string {
  return lang === "en" ? enValue?.trim() || nl || "" : nl || "";
}
---

<Layout
  title={paginaTekst(pagina, "seoTitle", lang)}
  description={paginaTekst(pagina, "seoDescription", lang)}
  path={path}
  altPath={en ? "/privacy" : "/en/privacy"}
  lang={lang}
  jsonLd={[breadcrumbSchema([{ name: "Home", path: prefix || "/" }, { name: "Privacy", path }])]}
>
  <article class="page-ink mx-auto max-w-3xl px-4 py-12">
    <SectionKicker n={1} />
    <h1 class="text-3xl font-bold">{paginaTekst(pagina, "titel", lang)}</h1>
    {paginaTekst(pagina, "bijgewerkt", lang) && (
      <p class="mt-2 text-sm text-brand-muted">{paginaTekst(pagina, "bijgewerkt", lang)}</p>
    )}
    {paginaTekst(pagina, "intro", lang) && (
      <p class="mt-6 text-brand-muted">{paginaTekst(pagina, "intro", lang)}</p>
    )}

    {pagina.blokken.map((blok) => {
      const kop = paginaBlokKop(blok, lang);
      const tekst = paginaBlokTekst(blok, lang).replaceAll("{email}", settings.email);
      const cookiesHier = tekst.includes("{cookies}");
      const locatiesHier = tekst.includes("{locaties}");
      const dienstenHier = tekst.includes("{diensten}");
      const stukken = tekst.split(/\{(?:cookies|locaties|diensten)\}/);
      return (
        <section>
          <h2 id={cookiesHier ? "cookies" : undefined} class:list={["mt-10 text-xl font-semibold", cookiesHier && "scroll-mt-24"]}>
            {kop}
          </h2>
          {stukken.map((stuk, index) => (
            <>
              {tekstChunks(stuk).map((chunk) =>
                chunk.kind === "ul" ? (
                  <ul class="mt-2 list-disc space-y-1 pl-5 text-brand-muted">
                    {chunk.lines.map((line) => (
                      <li><LinkedText text={line} linkClass="font-semibold text-brand-primary hover:underline" /></li>
                    ))}
                  </ul>
                ) : (
                  chunk.lines.map((line) => (
                    <p class="mt-2 text-brand-muted">
                      {line.split("{cookievoorkeuren}").map((deel, deelIndex) => (
                        <>
                          {deelIndex > 0 && (
                            <button type="button" data-consent-open class="font-semibold text-brand-primary hover:underline">
                              {uiTekst(settings, "footer", "cookies", lang)}
                            </button>
                          )}
                          <LinkedText text={deel} linkClass="font-semibold text-brand-primary hover:underline" />
                        </>
                      ))}
                    </p>
                  ))
                ),
              )}
              {index === 0 && locatiesHier && (
                <ul class="mt-4 grid gap-4 sm:grid-cols-2">
                  {locaties.map((l) => (
                    <li class="rounded-2xl border border-brand-border bg-brand-surface p-5 text-sm">
                      <p class="font-semibold text-brand-primary">{l.naam}</p>
                      <p class="mt-1 text-brand-muted">{l.adres}</p>
                      <p class="mt-1 text-brand-muted">{uiTekst(settings, "locatie", "btw", lang)} {l.btw}</p>
                      <p class="mt-1">
                        <a href={`mailto:${l.email}`} class="font-semibold text-brand-primary hover:underline">{l.email}</a>
                      </p>
                    </li>
                  ))}
                </ul>
              )}
              {index === 0 && cookiesHier && (
                <div class="mt-4 overflow-hidden rounded-2xl border border-brand-border bg-brand-surface">
                  <table class="w-full text-left text-sm">
                    <thead class="bg-brand-bg text-xs uppercase tracking-wide text-brand-muted">
                      <tr>
                        <th class="px-4 py-3 font-semibold">{kolom("cookiesKolomNaam")}</th>
                        <th class="px-4 py-3 font-semibold">{kolom("cookiesKolomDoel")}</th>
                        <th class="px-4 py-3 font-semibold">{kolom("cookiesKolomTermijn")}</th>
                        <th class="px-4 py-3 font-semibold">{kolom("cookiesKolomToestemming")}</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-brand-border text-brand-muted">
                      {cookies.map((row) => (
                        <tr>
                          <td class="px-4 py-3 font-semibold text-brand-text">{row.naam}</td>
                          <td class="px-4 py-3">{veld(row, row.doel, row.doelEn)}</td>
                          <td class="px-4 py-3">{veld(row, row.termijn, row.termijnEn)}</td>
                          <td class="px-4 py-3">{veld(row, row.toestemming, row.toestemmingEn)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {index === 0 && dienstenHier && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-brand-muted">
                  {cookies
                    .map((row) => veld(row, row.dienstverlener, row.dienstverlenerEn))
                    .filter(Boolean)
                    .map((regel) => <li>{regel}</li>)}
                </ul>
              )}
            </>
          ))}
        </section>
      );
    })}
  </article>
</Layout>
