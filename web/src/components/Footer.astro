---
import { getLocaties } from "../lib/content";

export interface Props {
  brand?: "movenda" | "mpc";
}

const { brand = "movenda" } = Astro.props;
const locaties = getLocaties();
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-border bg-brand-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
    {locaties.map((locatie) => (
      <div>
        <h3 class="font-semibold text-brand-primary">{locatie.naam}</h3>
        <p class="mt-2 text-sm text-brand-muted">{locatie.adres}</p>
        <p class="mt-1 text-sm text-brand-muted">
          <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="hover:text-brand-primary">
            {locatie.telefoon}
          </a>
        </p>
        <p class="mt-1 text-sm text-brand-muted">
          <a href={`mailto:${locatie.email}`} class="hover:text-brand-primary">{locatie.email}</a>
        </p>
      </div>
    ))}
    <div>
      <h3 class="font-semibold text-brand-primary">Movenda</h3>
      <p class="mt-2 text-sm text-brand-muted">
        {brand === "mpc"
          ? "Onderdeel van Movenda, kinesitherapie & personal training in Hasselt."
          : "Met het Movenda Performance Centre als tweede vestiging in Kuringen."}
      </p>
      <nav class="mt-3 flex flex-col gap-1 text-sm">
        <a href="/team" class="text-brand-muted hover:text-brand-primary">Team</a>
        <a href="/mpc" class="text-brand-muted hover:text-brand-primary">Movenda Performance Centre</a>
        <a href="/contact" class="text-brand-muted hover:text-brand-primary">Contact</a>
      </nav>
    </div>
  </div>
  <div class="border-t border-brand-border px-4 py-4 text-center text-xs text-brand-muted">
    © {year} Movenda · Preview in ontwikkeling — niet de live site van movenda.be
  </div>
</footer>
