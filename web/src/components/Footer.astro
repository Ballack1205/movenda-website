---
import { getLocaties, getSiteSettings } from "../lib/content";

export interface Props {
  brand?: "movenda" | "mpc";
  lang?: "nl" | "en";
}

const { brand = "movenda", lang = "nl" } = Astro.props;
const locaties = await getLocaties();
const settings = await getSiteSettings();
const year = new Date().getFullYear();
---

<footer class="bg-brand-footer text-white/80">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
    {locaties.map((locatie) => (
      <div>
        <h3 class="font-heading font-semibold text-white">{locatie.naam}</h3>
        <p class="mt-2 text-sm">{locatie.adres}</p>
        <p class="mt-1 text-sm">
          <a href={`tel:${locatie.telefoon.replace(/\s+/g, "")}`} class="hover:text-white">
            {locatie.telefoon}
          </a>
        </p>
        <p class="mt-1 text-sm">
          <a href={`mailto:${locatie.email}`} class="hover:text-white">{locatie.email}</a>
        </p>
      </div>
    ))}
    <div>
      <img src="/brand/logo-wordmark.png" alt="Movenda" width="140" height="30" class="h-7 w-auto" />
      <p class="mt-3 text-sm">
        {lang === "en"
          ? "Physiotherapy, personal training & performance in Hasselt, Belgium."
          : brand === "mpc"
            ? "Onderdeel van Movenda, kinesitherapie & personal training in Hasselt."
            : "Met het Movenda Performance Centre als tweede vestiging in Kuringen."}
      </p>
      {lang === "en" ? (
        <nav class="mt-3 flex flex-col gap-1 text-sm">
          <a href="/en/team" class="hover:text-white">Team</a>
          <a href="/en/mpc" class="hover:text-white">Movenda Performance Centre</a>
          <a href="/en/contact" class="hover:text-white">Contact</a>
        </nav>
      ) : (
        <nav class="mt-3 flex flex-col gap-1 text-sm">
          <a href="/over" class="hover:text-white">Over ons</a>
          <a href="/team" class="hover:text-white">Team</a>
          <a href="/prijzen" class="hover:text-white">Prijzen</a>
          <a href="/blog" class="hover:text-white">Blog</a>
          <a href="/faq" class="hover:text-white">FAQ</a>
          <a href="/jobs" class="hover:text-white">Vacatures</a>
          <a href="/mpc" class="hover:text-white">Movenda Performance Centre</a>
          <a href="/contact" class="hover:text-white">Contact</a>
        </nav>
      )}
      {(settings.socials.instagram || settings.socials.facebook || settings.socials.linkedin) && (
        <div class="mt-4 flex gap-3 text-sm font-medium">
          {settings.socials.instagram && (
            <a href={settings.socials.instagram} target="_blank" rel="noopener" class="hover:text-white">Instagram</a>
          )}
          {settings.socials.facebook && (
            <a href={settings.socials.facebook} target="_blank" rel="noopener" class="hover:text-white">Facebook</a>
          )}
          {settings.socials.linkedin && (
            <a href={settings.socials.linkedin} target="_blank" rel="noopener" class="hover:text-white">LinkedIn</a>
          )}
        </div>
      )}
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-4 text-center text-xs text-white/60">
    © {year} Movenda · Preview in ontwikkeling — niet de live site van movenda.be
  </div>
</footer>
