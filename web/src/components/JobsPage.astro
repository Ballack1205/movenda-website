---
import Layout from "../layouts/Layout.astro";
import SectionKicker from "./SectionKicker.astro";
import RichText from "./RichText.astro";
import { isLeeg } from "../lib/rich-text";
import { getVacatures, getSiteSettings, getPagina, paginaAlineas, paginaTekst } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import type { Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const vacatures = await getVacatures();
const settings = await getSiteSettings();
const pagina = await getPagina("jobs");
const [leegKop, ...leegRest] = paginaTekst(pagina, "legeTekst", lang).split("\n");
const leegTekst = leegRest.join(" ").trim();
const path = `${prefix}/jobs`;
---

<Layout
  title={paginaTekst(pagina, "seoTitle", lang) || (en ? "Jobs | Work at Movenda Hasselt" : "Vacatures | Werken bij Movenda Hasselt")}
  description={paginaTekst(pagina, "seoDescription", lang)}
  path={path}
  altPath={en ? "/jobs" : "/en/jobs"}
  lang={lang}
  jsonLd={[breadcrumbSchema([{ name: "Home", path: prefix || "/" }, { name: en ? "Jobs" : "Vacatures", path }])]}
>
  <section class="page-ink mx-auto max-w-3xl px-4 py-12">
    <SectionKicker n={1} />
    <h1 class="text-3xl font-bold">{paginaTekst(pagina, "titel", lang)}</h1>
    {paginaAlineas(pagina, lang).map((tekst) => (
      <p class="mt-2 text-brand-muted">{tekst}</p>
    ))}

    {vacatures.length === 0 ? (
      <div class="mt-10 rounded-2xl border border-brand-border bg-brand-surface p-8 text-center">
        <p class="font-semibold">{leegKop || (en ? "No open vacancies at the moment." : "Momenteel geen openstaande vacatures.")}</p>
        <p class="mt-2 text-sm text-brand-muted">
          {leegTekst || (en ? "Speculative application? Email" : "Spontaan solliciteren? Mail naar")}{" "}
          <a href={`mailto:${settings.email}`} class="font-semibold text-brand-primary hover:underline">
            {settings.email}
          </a>.
        </p>
      </div>
    ) : (
      <div class="mt-10 grid gap-6">
        {vacatures.map((vacature) => (
          <div class="rounded-2xl border border-brand-border bg-brand-surface p-6">
            <h2 class="text-lg font-semibold">{en ? vacature.titelEn || vacature.titel : vacature.titel}</h2>
            {vacature.locatieNaam && <p class="text-sm font-medium text-brand-primary">{vacature.locatieNaam}</p>}
            <div class="[&>p+p]:mt-5">
              <RichText
                value={en && !isLeeg(vacature.omschrijvingEn) ? vacature.omschrijvingEn : vacature.omschrijving}
                pClass="mt-2 whitespace-pre-line text-sm text-brand-muted"
              />
            </div>
            <a
              href={`mailto:${vacature.contactEmail}`}
              class="mt-4 inline-block font-semibold text-brand-primary hover:underline"
            >
              {en ? "Apply via" : "Solliciteer via"} {vacature.contactEmail} →
            </a>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>
