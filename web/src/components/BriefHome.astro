---
// Brief homepage: Julie's section order on the lab motion (silent cover, sheet, doors).
import type { ImageMetadata } from "astro";
import LabCover from "./LabCover.astro";
import LabStrip from "./LabStrip.astro";
import PartnerBand from "./PartnerBand.astro";
import InstagramFeed from "./InstagramFeed.astro";
import BlogPostCard from "./BlogPostCard.astro";
import GoogleReviewsFeed from "./GoogleReviewsFeed.astro";
import {
  getBlogPosts,
  getEvents,
  getLocaties,
  teamCounts,
  homeDeurNaam,
  homeDeurRegel,
  homeDeurTekst,
  localizeInternalHref,
  type Pagina,
  type Partner,
  type SiteSettings,
  type Teamlid,
} from "../lib/content";
import { teamPhotoSrc } from "../lib/images";
import homeHero from "../assets/marketing/home-hero.jpg";
import mpcHero from "../assets/marketing/mpc-hero.jpg";
import homeSquats from "../assets/marketing/home-squats.jpg";
import kineHero from "../assets/marketing/kine-hero.jpg";
import trainingSecondary from "../assets/marketing/training-secondary.jpg";

interface Props {
  pagina: Pagina;
  settings: SiteSettings;
  partners: Partner[];
  team: Teamlid[];
}

const { pagina, settings, partners, team } = Astro.props;
const brief = settings.homeBrief;
const posts = await getBlogPosts();
const today = new Date().toISOString().slice(0, 10);
const homeEvents = (await getEvents())
  .filter((event) => event.tonenOpHome)
  .sort((a, b) => (a.datum >= today ? (b.datum >= today ? a.datum.localeCompare(b.datum) : -1) : 1))
  .slice(0, 3);
const locaties = await getLocaties();
const hasselt = locaties.find((loc) => loc.slug === "olympia");
const kuringen = locaties.find((loc) => loc.slug === "mpc");
const insightsKicker = brief.insightsKicker === "Insights" ? "Insights/Blog" : brief.insightsKicker;
const deurFallback: Record<string, ImageMetadata> = {
  "/kinesitherapie": kineHero,
  "/mpc": mpcHero,
  "/mpc/groepslessen": homeSquats,
  "/mpc/corporate-coaching": trainingSecondary,
  "/locaties/olympia": homeHero,
};

const deuren = settings.homeAanbod.map((deur, i) => ({
  n: i + 1,
  href: localizeInternalHref(deur.href, "nl"),
  title: deur.href.endsWith("/locaties/olympia") ? "Olympia" : homeDeurNaam(deur, "nl"),
  line: deur.href.endsWith("/locaties/olympia") ? "Ontdek Olympia" : homeDeurRegel(deur, "nl"),
  body: homeDeurTekst(deur, "nl"),
  lead: deur.href === "/kinesitherapie" || deur.href === "/mpc",
  foto: deur.foto,
  fallback: deurFallback[deur.href] ?? homeHero,
  alt: homeDeurNaam(deur, "nl"),
}));

const counts = teamCounts(team);
const proof = [
  { value: String(counts.kinesisten), label: "kinesitherapeuten" },
  { value: String(counts.trainers), label: "personal trainers" },
  { value: String(locaties.length), label: "locaties" },
  { value: brief.bewijs.jaren, label: "jaar ervaring" },
];

const paragraphs = brief.merkTekst.split(/\n\n+/).map((part) => part.trim()).filter(Boolean);
---

<LabCover
  pagina={pagina}
  fallback={homeHero}
  alt="Trainer van Movenda begeleidt een klant tijdens een training"
  nextLabel="Verder"
/>

<div class="lab-sheet lab-sheet--ink">
  <section id="lab-next" class="lab-intro" data-reveal>
    <p class="brief-kicker">{brief.merkKicker}</p>
    <h1 class="lab-shout lab-intro__title">{brief.merkTitel}</h1>
    {paragraphs.map((part) => <p>{part}</p>)}
    <p class="brief-statement">{brief.merkStatement}</p>
    <a href="#aanbod" class="lab-intro__cta">{brief.merkCta}</a>
  </section>
</div>

<div class="lab-sheet" data-lab-light>
  <section class="brief-block" data-reveal>
    <PartnerBand
      partners={partners}
      title={settings.partnerband.titel}
      snelheid={settings.partnerband.snelheid}
      animatie={settings.partnerband.animatie}
    />
    <div class="mx-auto max-w-6xl px-4">
      <a href="/over#partners" class="brief-textlink">{brief.partnersCta}</a>
    </div>
    <ul class="brief-proof">
      {proof.map((item) => (
        <li>
          <span class="brief-proof__value">{item.value}</span>
          <span class="brief-proof__label">{item.label}</span>
        </li>
      ))}
    </ul>
  </section>
</div>

<div class="lab-sheet lab-sheet--ink">
  <section id="aanbod" class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4 pb-6">
      <h2 class="brief-title brief-title--wide">{brief.aanbodKicker.replace(/\.$/, "")}</h2>
      <p class="brief-lead brief-lead--wide">{brief.aanbodTekst}</p>
    </div>
  </section>
</div>

<LabStrip items={deuren} />

<div class="lab-sheet lab-sheet--ink">
  <section class="brief-locs" data-reveal>
    <h2 class="brief-title brief-title--wide brief-locs__title">Eén praktijk, twee locaties!</h2>
    <div class="brief-locs__grid">
      {hasselt && (
        <a class="brief-loc brief-loc--light" href="/locaties/olympia">
          {hasselt.foto && <img src={hasselt.foto} alt="" class="brief-loc__photo" />}
          <span class="brief-loc__copy">
            <span class="brief-loc__name">Movenda Hasselt</span>
            <span class="brief-loc__address">{hasselt.adres}</span>
            <span class="brief-textlink">Ontdek Movenda Hasselt</span>
          </span>
        </a>
      )}
      {kuringen && (
        <a class="brief-loc brief-loc--dark" href="/locaties/mpc">
          <img src={mpcHero.src} alt="" class="brief-loc__photo" />
          <span class="brief-loc__veil" aria-hidden="true"></span>
          <span class="brief-loc__copy">
            <span class="brief-loc__name">Performance Centre Kuringen</span>
            <span class="brief-loc__address">{kuringen.adres}</span>
            <span class="brief-textlink">Ontdek Performance Centre Kuringen</span>
          </span>
        </a>
      )}
    </div>
  </section>

  <section class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <p class="brief-kicker">{brief.teamKicker}</p>
      <h2 class="brief-title brief-title--wide">{brief.teamTitel}</h2>
      <p class="brief-lead brief-lead--wide">{brief.teamTekst}</p>
      <ul class="brief-team">
        {team.map((lid) => (
          <li>
            <a href={`/team/${lid.slug}`}>
              <span class="brief-team__photo">
                {lid.foto ? (
                  <img src={teamPhotoSrc(lid.foto, "card")} alt="" width="240" height="320" loading="lazy" />
                ) : (
                  <span class="brief-team__initials">{lid.voornaam[0]}{lid.naam[0]}</span>
                )}
              </span>
              <span class="brief-team__name">{lid.voornaam} {lid.naam}</span>
              <span class="brief-team__role">{lid.rol}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/team" class="brief-textlink">{brief.teamCta}</a>
    </div>
  </section>

  <section class="brief-block brief-block--flush" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <p class="brief-kicker">Events</p>
      <ul class="brief-insights">
        {homeEvents.map((event) => (
          <li>
            <a href="/events">
              {event.slug === "dwars-door-hasselt" ? "Datum volgt" : event.datum}
              {" — "}
              {event.titel}
            </a>
          </li>
        ))}
      </ul>
      <a href="/events" class="brief-textlink">Alle events</a>
    </div>
  </section>
</div>

<div class="lab-sheet" data-lab-light>
  <GoogleReviewsFeed settings={settings} />

  <section class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <p class="brief-kicker">{insightsKicker}</p>
      <h2 class="brief-title brief-title--wide">{brief.insightsTitel}</h2>
      <p class="brief-lead brief-lead--wide">{brief.insightsTekst}</p>
      {posts.length > 0 && (
        <div class="relative mt-6" data-team-carousel>
          <div class="absolute -top-12 right-0 hidden gap-2 md:flex" data-carousel-controls hidden>
            <button type="button" data-carousel-prev aria-label="Vorige posts" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-brand-border bg-white text-brand-text">‹</button>
            <button type="button" data-carousel-next aria-label="Volgende posts" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-brand-border bg-white text-brand-text">›</button>
          </div>
          <ul class="team-strip -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2" data-carousel-track aria-label="Insights/Blog">
            {posts.map((post) => (
              <li class="flex w-[18rem] shrink-0 snap-start sm:w-[22rem]">
                <BlogPostCard post={post} thumb />
              </li>
            ))}
          </ul>
        </div>
      )}
      <a href="/blog" class="brief-textlink">{brief.insightsCta === "Bekijk alle Insights" ? "Bekijk Insights/Blog" : brief.insightsCta}</a>
    </div>
  </section>
</div>

<div class="lab-sheet lab-sheet--ink">
  <InstagramFeed settings={settings} title="Follow us" />

  <section class="brief-slot" data-reveal>
    <h2 class="brief-title">{brief.slotTitel}</h2>
    <p class="brief-lead">{brief.slotTekst}</p>
    <div class="brief-slot__actions">
      <a class="brief-slot__button" href="/team#keuzehulp">{brief.slotAfspraak}</a>
      <a class="brief-slot__ghost" href="/contact">{brief.slotContact}</a>
    </div>
  </section>
</div>
