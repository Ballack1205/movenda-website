---
// Brief homepage: Julie's section order on the lab motion (silent cover, sheet, doors).
import type { ImageMetadata } from "astro";
import LabCover from "./LabCover.astro";
import LabStrip from "./LabStrip.astro";
import PartnerBand from "./PartnerBand.astro";
import InstagramFeed from "./InstagramFeed.astro";
import GoogleReviewsFeed from "./GoogleReviewsFeed.astro";
import {
  getEvents,
  getLocaties,
  teamCounts,
  homeDeurNaam,
  homeDeurTekst,
  localizeInternalHref,
  type Pagina,
  type Partner,
  type SiteSettings,
  type Teamlid,
} from "../lib/content";
import { teamPhotoSrc } from "../lib/images";
import homeCover from "../assets/marketing/home-cover.jpg";
import homeOlympia from "../assets/marketing/home-olympia.jpg";
import homePerformance from "../assets/marketing/home-performance.jpg";
import homeGx from "../assets/marketing/home-gx.jpg";
import homeB2b from "../assets/marketing/home-b2b.jpg";
import kineHero from "../assets/marketing/kine-hero.jpg";

interface Props {
  pagina: Pagina;
  settings: SiteSettings;
  partners: Partner[];
  team: Teamlid[];
}

const { pagina, settings, partners, team } = Astro.props;
const brief = settings.homeBrief;
const today = new Date().toISOString().slice(0, 10);
const homeEvents = (await getEvents())
  .filter((event) => event.tonenOpHome)
  .sort((a, b) => (a.datum >= today ? (b.datum >= today ? a.datum.localeCompare(b.datum) : -1) : 1))
  .slice(0, 3);

const eventWhen = (event: { datum: string }) => {
  const date = new Date(`${event.datum}T12:00:00`);
  if (Number.isNaN(date.getTime())) return event.datum;
  return new Intl.DateTimeFormat("nl-BE", { day: "numeric", month: "long", year: "numeric" }).format(date);
};

const eventPhoto = (foto: string) =>
  foto.startsWith("/") ? foto : `${foto}?w=480&h=320&fit=crop&auto=format`;
const locaties = await getLocaties();
const deurFallback: Record<string, ImageMetadata> = {
  "/kinesitherapie": kineHero,
  "/mpc": homePerformance,
  "/mpc/groepslessen": homeGx,
  "/mpc/corporate-coaching": homeB2b,
  "/locaties/olympia": homeOlympia,
};

const deuren = settings.homeAanbod.map((deur, i) => ({
  n: i + 1,
  href: localizeInternalHref(deur.href, "nl"),
  title: deur.href.endsWith("/locaties/olympia") ? "Olympia" : homeDeurNaam(deur, "nl"),
  body: homeDeurTekst(deur, "nl"),
  lead: deur.href === "/kinesitherapie" || deur.href === "/mpc",
  foto: deur.foto,
  fallback: deurFallback[deur.href] ?? homeCover,
  alt: homeDeurNaam(deur, "nl"),
}));

const counts = teamCounts(team);
const proof = [
  { value: String(counts.kinesisten), label: "kinesitherapeuten" },
  { value: String(counts.trainers), label: "personal trainers" },
  { value: String(locaties.length), label: "locaties" },
  { value: brief.bewijs.jaren, label: "jaar ervaring" },
];

const paragraphs = brief.merkTekst.split(/\n\n+/).map((part) => part.trim()).filter(Boolean);
---

<LabCover
  pagina={pagina}
  fallback={homeCover}
  alt="Trainer van Movenda begeleidt een klant tijdens een training"
  nextLabel="Verder"
  crop="object-[center_72%]"
/>

<div class="lab-sheet lab-sheet--ink brief-ink">
  <section id="lab-next" class="lab-intro" data-reveal>
    <p class="brief-kicker">{brief.merkKicker}</p>
    <h1 class="lab-shout lab-intro__title">{brief.merkTitel}</h1>
    <ul class="brief-proof">
      {proof.map((item) => (
        <li>
          <span class="brief-proof__value">{item.value}</span>
          <span class="brief-proof__label">{item.label}</span>
        </li>
      ))}
    </ul>
    {paragraphs.map((part) => <p>{part}</p>)}
    <p class="brief-statement">{brief.merkStatement}</p>
    <a href="#aanbod" class="lab-intro__cta">{brief.merkCta}</a>
  </section>
</div>

<div class="lab-sheet" data-lab-light>
  <section class="brief-block" data-reveal>
    <PartnerBand
      partners={partners}
      title={settings.partnerband.titel}
      snelheid={settings.partnerband.snelheid}
      animatie={settings.partnerband.animatie}
    />
    <div class="mx-auto max-w-6xl px-4">
      <a href="/over#partners" class="brief-textlink">{brief.partnersCta}</a>
    </div>
  </section>
</div>

<div class="lab-sheet lab-sheet--ink brief-ink">
  <section id="aanbod" class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4 pb-6">
      <h2 class="brief-title brief-title--wide">{brief.aanbodKicker.replace(/\.$/, "")}</h2>
      <p class="brief-lead brief-lead--wide">{brief.aanbodTekst}</p>
    </div>
  </section>
</div>

<LabStrip items={deuren} />

<div class="lab-sheet lab-sheet--ink brief-ink">
  <section class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <p class="brief-kicker">{brief.teamKicker}</p>
      <h2 class="brief-title brief-title--wide">{brief.teamTitel}</h2>
      <p class="brief-lead brief-lead--wide">{brief.teamTekst}</p>
      <ul class="brief-team">
        {team.map((lid) => (
          <li>
            <a href={`/team/${lid.slug}`}>
              <span class="brief-team__photo">
                {lid.foto ? (
                  <img src={teamPhotoSrc(lid.foto, "card")} alt="" width="240" height="320" loading="lazy" />
                ) : (
                  <span class="brief-team__initials">{lid.voornaam[0]}{lid.naam[0]}</span>
                )}
              </span>
              <span class="brief-team__name">{lid.voornaam} {lid.naam}</span>
              <span class="brief-team__role">{lid.rol}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/team" class="brief-textlink">{brief.teamCta}</a>
    </div>
  </section>

  <section class="brief-block brief-block--flush" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <p class="brief-kicker">Events</p>
      <ul class="brief-events">
        {homeEvents.map((event) => (
          <li>
            <a class="brief-event" href="/events">
              {event.foto && (
                <img class="brief-event__photo" src={eventPhoto(event.foto)} alt="" width="240" height="160" loading="lazy" />
              )}
              <span class="brief-event__copy">
                <span class="brief-event__when">{eventWhen(event)}{event.locatie ? ` · ${event.locatie}` : ""}</span>
                <span class="brief-event__title">{event.titel}</span>
                {event.tekst && <span class="brief-event__text">{event.tekst}</span>}
              </span>
              <span class="brief-event__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/events" class="brief-textlink">Alle events</a>
    </div>
  </section>
</div>

<div class="lab-sheet" data-lab-light>
  <GoogleReviewsFeed settings={settings} />

  <section class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <a href="/blog" class="brief-textlink">Bekijk Insights/Blog</a>
    </div>
  </section>
</div>

<div class="lab-sheet lab-sheet--ink brief-ink">
  <InstagramFeed settings={settings} title="Follow us" />

  <section class="brief-slot" data-reveal>
    <h2 class="brief-title">{brief.slotTitel}</h2>
    <p class="brief-lead">{brief.slotTekst}</p>
    <div class="brief-slot__actions">
      <a class="brief-slot__button" href="/team#keuzehulp">{brief.slotAfspraak}</a>
      <a class="brief-slot__ghost" href="/contact">{brief.slotContact}</a>
    </div>
  </section>
</div>
