---
// Brief homepage: Julie's section order on the lab motion (silent cover, sheet, doors).
import type { ImageMetadata } from "astro";
import LabCover from "./LabCover.astro";
import LabStrip from "./LabStrip.astro";
import PartnerBand from "./PartnerBand.astro";
import InstagramFeed from "./InstagramFeed.astro";
import GoogleReviewsFeed from "./GoogleReviewsFeed.astro";
import {
  getEvents,
  getLocaties,
  teamCounts,
  homeDeurNaam,
  homeDeurTekst,
  localizeInternalHref,
  type Pagina,
  type Partner,
  type SiteSettings,
  type Teamlid,
} from "../lib/content";
import { teamPhotoSrc } from "../lib/images";
import { withLang, type Lang } from "../lib/i18n";
import homeCover from "../assets/marketing/home-cover.jpg";
import homeOlympia from "../assets/marketing/home-olympia.jpg";
import homePerformance from "../assets/marketing/home-performance.jpg";
import homeGx from "../assets/marketing/home-gx.jpg";
import homeB2b from "../assets/marketing/home-b2b.jpg";
import kineHero from "../assets/marketing/kine-hero.jpg";

interface Props {
  lang?: Lang;
  pagina: Pagina;
  settings: SiteSettings;
  partners: Partner[];
  team: Teamlid[];
}

const { lang = "nl", pagina, settings, partners, team } = Astro.props;
const en = lang === "en";
const rawBrief = settings.homeBrief;
const say = (nl: string, enText?: string) => (en && enText?.trim() ? enText : nl);
const brief = {
  ...rawBrief,
  merkKicker: say(rawBrief.merkKicker, rawBrief.merkKickerEn),
  merkTitel: say(rawBrief.merkTitel, rawBrief.merkTitelEn),
  merkTekst: say(rawBrief.merkTekst, rawBrief.merkTekstEn),
  merkStatement: say(rawBrief.merkStatement, rawBrief.merkStatementEn),
  merkCta: say(rawBrief.merkCta, rawBrief.merkCtaEn),
  partnersKicker: say(rawBrief.partnersKicker, rawBrief.partnersKickerEn),
  partnersCta: say(rawBrief.partnersCta, rawBrief.partnersCtaEn),
  aanbodKicker: say(rawBrief.aanbodKicker, rawBrief.aanbodKickerEn),
  aanbodTekst: say(rawBrief.aanbodTekst, rawBrief.aanbodTekstEn),
  locatiesTitel: say(rawBrief.locatiesTitel, rawBrief.locatiesTitelEn),
  hasseltNaam: say(rawBrief.hasseltNaam, rawBrief.hasseltNaamEn),
  kuringenNaam: say(rawBrief.kuringenNaam, rawBrief.kuringenNaamEn),
  hasseltProfiel: say(rawBrief.hasseltProfiel, rawBrief.hasseltProfielEn),
  kuringenProfiel: say(rawBrief.kuringenProfiel, rawBrief.kuringenProfielEn),
  eventsKicker: say(rawBrief.eventsKicker, rawBrief.eventsKickerEn),
  teamKicker: say(rawBrief.teamKicker, rawBrief.teamKickerEn),
  teamTitel: say(rawBrief.teamTitel, rawBrief.teamTitelEn),
  teamTekst: say(rawBrief.teamTekst, rawBrief.teamTekstEn),
  teamCta: say(rawBrief.teamCta, rawBrief.teamCtaEn),
  reviewsTitel: say(rawBrief.reviewsTitel, rawBrief.reviewsTitelEn),
  reviewsCta: say(rawBrief.reviewsCta, rawBrief.reviewsCtaEn),
  insightsKicker: say(rawBrief.insightsKicker, rawBrief.insightsKickerEn),
  insightsTitel: say(rawBrief.insightsTitel, rawBrief.insightsTitelEn),
  insightsTekst: say(rawBrief.insightsTekst, rawBrief.insightsTekstEn),
  insightsCta: say(rawBrief.insightsCta, rawBrief.insightsCtaEn),
  instagramTitel: say(rawBrief.instagramTitel, rawBrief.instagramTitelEn),
  instagramCta: say(rawBrief.instagramCta, rawBrief.instagramCtaEn),
  slotTitel: say(rawBrief.slotTitel, rawBrief.slotTitelEn),
  slotTekst: say(rawBrief.slotTekst, rawBrief.slotTekstEn),
  slotAfspraak: say(rawBrief.slotAfspraak, rawBrief.slotAfspraakEn),
  slotContact: say(rawBrief.slotContact, rawBrief.slotContactEn),
  bewijs: {
    ...rawBrief.bewijs,
    kinesistenLabel: say(rawBrief.bewijs.kinesistenLabel, rawBrief.bewijs.kinesistenLabelEn),
    trainersLabel: say(rawBrief.bewijs.trainersLabel, rawBrief.bewijs.trainersLabelEn),
    locatiesLabel: say(rawBrief.bewijs.locatiesLabel, rawBrief.bewijs.locatiesLabelEn),
    jarenLabel: say(rawBrief.bewijs.jarenLabel, rawBrief.bewijs.jarenLabelEn),
  },
};
const today = new Date().toISOString().slice(0, 10);
const homeEvents = (await getEvents())
  .filter((event) => event.tonenOpHome)
  .sort((a, b) => (a.datum >= today ? (b.datum >= today ? a.datum.localeCompare(b.datum) : -1) : 1))
  .slice(0, 3);

const eventWhen = (event: { datum: string }) => {
  const date = new Date(`${event.datum}T12:00:00`);
  if (Number.isNaN(date.getTime())) return event.datum;
  return new Intl.DateTimeFormat(en ? "en-GB" : "nl-BE", { day: "numeric", month: "long", year: "numeric" }).format(date);
};

const locaties = await getLocaties();
const hasselt = locaties.find((loc) => loc.slug === "olympia");
const kuringen = locaties.find((loc) => loc.slug === "mpc");
const deurFallback: Record<string, ImageMetadata> = {
  "/kinesitherapie": kineHero,
  "/movenda-kinesitherapie": kineHero,
  "/performance": homePerformance,
  "/groepslessen": homeGx,
  "/b2b": homeB2b,
  "/locaties/olympia": homeOlympia,
};

const deuren = settings.homeAanbod.map((deur, i) => ({
  n: i + 1,
  href: localizeInternalHref(deur.href, lang),
  title: deur.href.endsWith("/locaties/olympia") ? "Olympia" : homeDeurNaam(deur, lang),
  body: homeDeurTekst(deur, lang),
  lead: deur.href === "/kinesitherapie" || deur.href === "/movenda-kinesitherapie" || deur.href === "/performance",
  foto: deur.foto,
  fallback: deurFallback[deur.href] ?? homeCover,
  alt: homeDeurNaam(deur, lang),
}));

// The circles are at most 13rem wide; 640px stays sharp on retina without shipping the full photo.
const lokaleLocFoto: Record<string, string> = {
  "/locaties/olympia-ingang.jpg": "/locaties/olympia-ingang-640.webp",
  "/locaties/mpc-ingang.jpg": "/locaties/mpc-ingang-640.webp",
};
const locFoto = (src: string) =>
  /^https?:/.test(src) ? `${src}?w=640&h=640&fit=crop&auto=format` : lokaleLocFoto[src] ?? src;

const counts = teamCounts(team);
const proof = [
  { value: String(counts.kinesisten), label: brief.bewijs.kinesistenLabel },
  { value: String(counts.trainers), label: brief.bewijs.trainersLabel },
  { value: String(locaties.length), label: brief.bewijs.locatiesLabel },
  { value: brief.bewijs.jaren, label: brief.bewijs.jarenLabel },
];

const paragraphs = brief.merkTekst.split(/\n\n+/).map((part) => part.trim()).filter(Boolean);
---

<LabCover
  pagina={pagina}
  fallback={homeCover}
  alt={en ? "A Movenda trainer coaching a client during a session" : "Trainer van Movenda begeleidt een klant tijdens een training"}
  nextLabel={en ? "Continue" : "Verder"}
  crop="object-[center_72%]"
/>

<div class="lab-sheet lab-sheet--ink brief-ink">
  <section id="lab-next" class="lab-intro" data-reveal>
    <h1 class="lab-shout lab-intro__title">{brief.merkTitel}</h1>
    <ul class="brief-proof">
      {proof.map((item) => (
        <li>
          <span class="brief-proof__value">{item.value}</span>
          <span class="brief-proof__label">{item.label}</span>
        </li>
      ))}
    </ul>
    {paragraphs.map((part) => <p>{part}</p>)}
    <p class="brief-statement">{brief.merkStatement}</p>
  </section>
</div>

<div class="lab-sheet lab-sheet--ink brief-ink">
  <section class="brief-block brief-partners" data-reveal>
    <PartnerBand
      partners={partners}
      title=""
      snelheid={settings.partnerband.snelheid}
      animatie={settings.partnerband.animatie}
    />
    <div class="mx-auto max-w-6xl px-4">
      <a href={withLang("/over-ons/ons-verhaal#partners", lang)} class="brief-textlink">{brief.partnersCta}</a>
    </div>
  </section>
</div>

<div class="lab-sheet lab-sheet--ink brief-ink">
  <section id="aanbod" class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4 pb-6">
      <h2 class="brief-title brief-title--wide">{brief.aanbodKicker.replace(/\.$/, "")}</h2>
      <p class="brief-lead brief-lead--wide">{brief.aanbodTekst}</p>
    </div>
  </section>
</div>

<LabStrip items={deuren} />

<section class="brief-locs" data-reveal aria-label={brief.locatiesTitel}>
  <div class="brief-locs__grid">
    {hasselt && (
      <a class="brief-loc" href={withLang("/locaties/olympia", lang)}>
        {hasselt.foto && (
          <span class="brief-loc__ring">
            <img src={locFoto(hasselt.foto)} alt="" width="640" height="640" class="brief-loc__photo" loading="lazy" decoding="async" />
          </span>
        )}
        <span class="brief-loc__name">{brief.hasseltNaam}</span>
        <span class="brief-loc__address">{hasselt.adres}</span>
      </a>
    )}
    {kuringen?.foto && (
      <a class="brief-loc" href={withLang("/locaties/mpc", lang)}>
        <span class="brief-loc__ring">
          <img src={locFoto(kuringen.foto)} alt="" width="640" height="640" class="brief-loc__photo" loading="lazy" decoding="async" />
        </span>
        <span class="brief-loc__name">{brief.kuringenNaam}</span>
        <span class="brief-loc__address">{kuringen.adres}</span>
      </a>
    )}
  </div>
</section>

<div class="lab-sheet lab-sheet--ink brief-ink">
  <section class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <p class="brief-kicker">{brief.teamKicker}</p>
      <h2 class="brief-title brief-title--wide">{brief.teamTitel}</h2>
      <p class="brief-lead brief-lead--wide">{brief.teamTekst}</p>
      <ul class="brief-team">
        {team.map((lid) => (
          <li>
            <a href={withLang(`/team/${lid.slug}`, lang)}>
              <span class="brief-team__photo">
                {lid.foto ? (
                  <img src={teamPhotoSrc(lid.foto, "card")} alt="" width="240" height="320" loading="lazy" />
                ) : (
                  <span class="brief-team__initials">{lid.voornaam[0]}{lid.naam[0]}</span>
                )}
              </span>
              <span class="brief-team__name">{lid.voornaam} {lid.naam}</span>
              <span class="brief-team__role">{en ? lid.rolEn || lid.rol : lid.rol}</span>
              {lid.clubs.length > 0 && (
                <span class="brief-team__club">{lid.clubs.map((club) => club.naam.trim()).filter(Boolean).join(" · ")}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
      <a href={withLang("/team", lang)} class="brief-textlink">{brief.teamCta}</a>
    </div>
  </section>

  <section class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <a class="brief-kicker" href={withLang("/events", lang)}>{brief.eventsKicker}</a>
      <ul class="brief-events">
        {homeEvents.map((event) => (
          <li>
            <a class="brief-event" href={event.link ? withLang(event.link, lang) : withLang("/events", lang)}>
              <span class="brief-event__copy">
                <span class="brief-event__when">{eventWhen(event)}{event.locatie ? ` · ${event.locatie}` : ""}</span>
                <span class="brief-event__title">{en ? event.titelEn || event.titel : event.titel}</span>
                {(en ? event.tekstEn || event.tekst : event.tekst) && <span class="brief-event__text">{en ? event.tekstEn || event.tekst : event.tekst}</span>}
              </span>
              <span class="brief-event__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>

<div class="lab-sheet" data-lab-light>
  <GoogleReviewsFeed settings={settings} lang={lang} />

  <section class="brief-block" data-reveal>
    <div class="mx-auto max-w-6xl px-4">
      <a href={withLang("/blog", lang)} class="brief-textlink">{brief.insightsCta}</a>
    </div>
  </section>
</div>

<div class="lab-sheet lab-sheet--ink brief-ink">
  <InstagramFeed settings={settings} title={brief.instagramTitel} lang={lang} />

  <section class="brief-slot" data-reveal>
    <h2 class="brief-title">{brief.slotTitel}</h2>
    <p class="brief-lead">{brief.slotTekst}</p>
    <div class="brief-slot__actions">
      <a class="brief-slot__button" href={withLang("/team#keuzehulp", lang)}>{brief.slotAfspraak}</a>
      <a class="brief-slot__ghost" href={withLang("/contact", lang)}>{brief.slotContact}</a>
    </div>
  </section>
</div>
