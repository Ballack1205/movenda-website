---
import Layout from "../layouts/Layout.astro";
import LinkedText from "./LinkedText.astro";
import PrijsLijst from "./PrijsLijst.astro";
import {
  getPagina,
  getPrijzenByCategorie,
  getSiteSettings,
  paginaParagrafen,
  paginaTekst,
  getTeamleden,
  type Prijsitem,
  type Teamlid,
} from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import { PRIJZEN_INFO_EN, prijzenInfoText, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";

const settings = await getSiteSettings();
const info = settings.prijzenInfo;
const pagina = await getPagina("prijzen");
const alineas = (field: Parameters<typeof paginaParagrafen>[1]) =>
  paginaParagrafen(pagina, field, lang)
    .filter((tekst) => info.basishonorarium || !tekst.includes("{basishonorarium}"))
    .map((tekst) => tekst.replaceAll("{basishonorarium}", String(info.basishonorarium ?? "")));
const team = await getTeamleden();
const kine = await getPrijzenByCategorie("kine");
const training = await getPrijzenByCategorie("training");
const groep = await getPrijzenByCategorie("mpc-groep");
const screening = await getPrijzenByCategorie("screening");

const byNaam = (a: Teamlid, b: Teamlid) =>
  a.naam.localeCompare(b.naam, "nl") || a.voornaam.localeCompare(b.voornaam, "nl");
const kineTeam = team.filter((lid) => lid.tariefKine).sort(byNaam);
const coachTeam = team.filter((lid) => lid.tariefPtMpc || lid.tariefPerformance).sort(byNaam);

const copy = en
  ? {
      seoTitle: "Physiotherapy & personal training fees | Movenda",
      crumb: "Prices",
      kine: "Physiotherapy",
      training: "Training & Coaching",
      trainingPlace: "(Performance Centre)",
      exBtw: "*Prices excl. VAT",
      groep: "Group classes",
      screening: "Screening & data",
      pt: "Personal training",
      performance: "High performance",
      standard: PRIJZEN_INFO_EN.standaard,
      vt: PRIJZEN_INFO_EN.vt,
      terugTitel: "What do you get back?",
      situatie: "Situation",
      geschat: "Estimated reimbursement",
      cancel: PRIJZEN_INFO_EN.annulatie,
    }
  : {
      seoTitle: "Tarieven kinesitherapie & personal training | Movenda",
      crumb: "Prijzen",
      kine: "Kinesitherapie",
      training: "Training & Coaching",
      trainingPlace: "(Performance Centre)",
      exBtw: "*Prijzen zijn exclusief btw",
      groep: "Groepslessen",
      screening: "Screening & data",
      pt: "Personal training",
      performance: "High performance",
      standard: "Standaard verzekerde",
      vt: "Verhoogde tegemoetkoming (VT/BIM)",
      terugTitel: "Wat krijg je terug?",
      situatie: "Situatie",
      geschat: "Geschatte terugbetaling",
      cancel: "Annulatie:",
    };

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: prefix || "/" },
    { name: copy.crumb, path: `${prefix}/prijzen` },
  ]),
];
const intro = prijzenInfoText(info, "intro", lang);
const standaard = prijzenInfoText(info, "terugbetalingStandaard", lang);
const vt = prijzenInfoText(info, "terugbetalingVt", lang);
const voorwaarden = prijzenInfoText(info, "voorwaarden", lang);
const annulatie = prijzenInfoText(info, "annulatiebeleid", lang);
---

<Layout
  title={paginaTekst(pagina, "seoTitle", lang) || copy.seoTitle}
  description={paginaTekst(pagina, "seoDescription", lang)}
  path={`${prefix}/prijzen`}
  altPath={en ? "/prijzen" : "/en/prijzen"}
  lang={lang}
  jsonLd={jsonLd}
>
  <section class="page-ink mx-auto max-w-5xl px-4 pb-16 pt-8">
    <h1>{paginaTekst(pagina, "titel", lang)}</h1>
    {intro && <p class="mt-4 text-brand-muted">{intro}</p>}
    {alineas("intro").map((tekst) => (
      <p class="mt-3 text-brand-muted"><LinkedText text={tekst} /></p>
    ))}

    {kine.length > 0 && (
      <div class="mt-10 max-w-2xl">
        <h2 class="text-xl font-semibold">{copy.kine}</h2>
        <PrijsLijst items={kine} lang={lang} />
      </div>
    )}

    <div class="mt-12 border-t border-brand-border pt-8">
      <h2 class="text-xl font-semibold">{paginaTekst(pagina, "terugbetalingTitel", lang)}</h2>
      {alineas("terugbetalingTekst").map((tekst) => (
        <p class="mt-2 text-sm text-brand-muted"><LinkedText text={tekst} /></p>
      ))}
      {(standaard || vt) && (
        <div class="mt-6 max-w-3xl">
          <h3 class="font-semibold">{copy.terugTitel}</h3>
          <table class="mt-3 w-full text-left text-sm">
            <thead>
              <tr class="border-b border-brand-border">
                <th class="py-2 pr-4 font-semibold">{copy.situatie}</th>
                <th class="py-2 font-semibold">{copy.geschat}</th>
              </tr>
            </thead>
            <tbody>
              {standaard && (
                <tr class="border-b border-brand-border">
                  <td class="py-3 pr-4">{copy.standard}</td>
                  <td class="py-3 text-brand-muted">{standaard}</td>
                </tr>
              )}
              {vt && (
                <tr class="border-b border-brand-border">
                  <td class="py-3 pr-4">{copy.vt}</td>
                  <td class="py-3 text-brand-muted">{vt}</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      )}
      {voorwaarden && <p class="mt-4 text-xs text-brand-muted">{voorwaarden}</p>}
      {annulatie && (
        <p class="mt-4 text-sm text-brand-muted"><strong>{copy.cancel}</strong> {annulatie}</p>
      )}
    </div>

    {(training.length > 0 || groep.length > 0 || screening.length > 0) && (
      <div class="mt-14 max-w-2xl">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">{copy.training} {copy.trainingPlace}</h3>
        <p class="mt-1 text-sm text-brand-muted">{copy.exBtw}</p>
        {training.length > 0 && <PrijsLijst items={training} lang={lang} />}
        {[[copy.groep, groep], [copy.screening, screening]].map(([titel, items]) =>
          (items as Prijsitem[]).length > 0 && (
            <div class="mt-6">
              <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">{titel as string}</h3>
              <PrijsLijst items={items as Prijsitem[]} lang={lang} />
            </div>
          ),
        )}
      </div>
    )}

    {(kineTeam.length > 0 || coachTeam.length > 0) && (
      <div class="mt-14">
        <h2 class="text-xl font-semibold">{paginaTekst(pagina, "perTherapeutTitel", lang)}</h2>
        {alineas("perTherapeutTekst").map((tekst) => (
          <p class="mt-2 text-sm text-brand-muted"><LinkedText text={tekst} /></p>
        ))}

        {kineTeam.length > 0 && (
          <div id="tarief-kine" class="mt-8 max-w-2xl scroll-mt-24">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">{copy.kine}</h3>
            <div class="mt-2 divide-y divide-brand-border border-y border-brand-border">
              {kineTeam.map((lid) => (
                <details class="group">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2 text-sm [&::-webkit-details-marker]:hidden">
                    <span>{lid.voornaam} {lid.naam}</span>
                    <span class="text-brand-muted" aria-hidden="true">+</span>
                  </summary>
                  <p class="pb-3 text-sm">
                    <span class="font-medium">€{lid.tariefKine} / 30 min</span>
                  </p>
                </details>
              ))}
            </div>
          </div>
        )}

        {coachTeam.length > 0 && (
          <div id="tarief-pt" class="mt-8 max-w-2xl scroll-mt-24">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-muted">{copy.training}</h3>
            <p class="mt-1 text-xs text-brand-muted">{copy.exBtw}</p>
            <div class="mt-2 divide-y divide-brand-border border-y border-brand-border">
              {coachTeam.map((lid) => (
                <details class="group">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 py-2 text-sm [&::-webkit-details-marker]:hidden">
                    <span>{lid.voornaam} {lid.naam}</span>
                    <span class="text-brand-muted" aria-hidden="true">+</span>
                  </summary>
                  <p class="flex flex-wrap gap-x-6 gap-y-1 pb-3 text-sm">
                    {lid.tariefPtMpc && <span><span class="text-brand-muted">{copy.pt}:</span> <span class="font-medium">€{lid.tariefPtMpc} / 60 min</span></span>}
                    {lid.tariefPerformance && <span><span class="text-brand-muted">{copy.performance}:</span> <span class="font-medium">€{lid.tariefPerformance} / 60 min</span></span>}
                  </p>
                </details>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </section>
</Layout>
