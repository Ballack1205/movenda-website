---
// Body of a team profile (bio, expertise, motivation, quote, clubs), shared by NL and EN.
import { dienstHref, specialisatieNaam, type Teamlid } from "../lib/content";
import type { Lang } from "../lib/i18n";

interface Props {
  lid: Teamlid;
  lang?: Lang;
}

const { lid, lang = "nl" } = Astro.props;
const en = lang === "en";
const regels = (tekst?: string | null) => (tekst || "").split("\n").map((r) => r.trim()).filter(Boolean);
const alineas = (tekst?: string | null) => (tekst || "").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const bio = en ? lid.bioEn || lid.bio : lid.bio;
const expertise = regels(en ? lid.expertiseEn || lid.expertise : lid.expertise);
const motivatie = alineas(en ? lid.motivatieEn || lid.motivatie : lid.motivatie);
const quote = lid.quote?.trim().replace(/^[“"„]+|[”"]+$/g, "").replace(/\.{2,}$/, ".");

const kine = lid.disciplines.includes("kine");
const coach = !kine && lid.disciplines.includes("pt");
const expertiseKop = !kine && !coach
  ? en ? "At Movenda" : "Binnen Movenda"
  : en ? "Expertise and coaching" : "Expertise en begeleiding";
const motivatieKop = en
  ? `I chose ${kine ? "physiotherapy" : "coaching"} because…`
  : `Ik koos voor ${kine ? "kinesitherapie" : "coaching"} omdat…`;
const quoteKop = en
  ? `In our ${kine ? "therapist" : "coach"}'s words`
  : `Woorden van onze ${kine ? "therapeut" : "coach"}`;
const kopClass = "text-sm font-semibold uppercase tracking-wide text-brand-muted";
---

<div class="mt-6 space-y-4 text-brand-muted">
  {alineas(bio).map((p) => <p>{p}</p>)}
</div>

{expertise.length > 0 && (
  <div class="mt-8">
    <h2 class={kopClass}>{expertiseKop}</h2>
    <ul class="mt-3 divide-y divide-brand-border border-y border-brand-border">
      {expertise.map((r) => <li class="py-2.5 text-brand-text">{r}</li>)}
    </ul>
  </div>
)}

{lid.specialisaties.length > 0 && (
  <div class="mt-8">
    <h2 class={kopClass}>{en ? "Specialisations" : "Specialisaties"}</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {lid.specialisaties.map((s) => (
        <li>
          {s.dienst ? (
            <a href={dienstHref(s.dienst, lang)} class="rounded-full bg-brand-surface px-3 py-1 text-sm text-brand-primary hover:underline">{specialisatieNaam(s, lang)}</a>
          ) : (
            <span class="rounded-full bg-brand-surface px-3 py-1 text-sm text-brand-text">{specialisatieNaam(s, lang)}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
)}

{motivatie.length > 0 && (
  <div class="mt-8">
    <h2 class={kopClass}>{motivatieKop}</h2>
    <div class="mt-3 space-y-3 text-brand-muted">
      {motivatie.map((p) => <p>{p}</p>)}
    </div>
  </div>
)}

{quote && (
  <figure class="mt-10 border-l-2 border-brand-primary pl-5">
    <figcaption class={kopClass}>{quoteKop}</figcaption>
    <blockquote class="mt-2 text-2xl font-medium italic leading-snug text-brand-text">“{quote}”</blockquote>
  </figure>
)}

{lid.clubs.length > 0 && (
  <div class="mt-8">
    <h2 class={kopClass}>Clubs</h2>
    <ul class="mt-2 flex flex-wrap gap-2 text-sm">
      {lid.clubs.map((c) => (
        <li>
          {c.url ? (
            <a href={c.url} target="_blank" rel="noopener" class="text-brand-primary hover:underline">{c.naam.trim()}</a>
          ) : (
            c.naam.trim()
          )}
        </li>
      ))}
    </ul>
  </div>
)}
