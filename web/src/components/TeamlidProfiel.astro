---
// Body of a team profile (bio, motivation + quote, expertise, clubs), shared by NL and EN.
import { dienstHref, expertiseElementHref, expertiseElementNaam, specialisatieNaam, type Teamlid } from "../lib/content";
import type { Lang } from "../lib/i18n";
import RichText from "./RichText.astro";
import { isLeeg, type RichValue } from "../lib/rich-text";

interface Props {
  lid: Teamlid;
  lang?: Lang;
}

const { lid, lang = "nl" } = Astro.props;
const en = lang === "en";
const regels = (tekst?: string | null) => (tekst || "").split("\n").map((r) => r.trim()).filter(Boolean);

// English text wins when Julie filled it in; otherwise the Dutch one (same as before).
const kies = (nl: RichValue, enRich: RichValue, enPlain?: string): RichValue =>
  en ? (!isLeeg(enRich) ? enRich : enPlain || nl) : nl;
const bio = kies(lid.bioRich ?? lid.bio, lid.bioEnRich, lid.bioEn);
// Lines Julie builds in Studio (elements, optionally linked); falls back to the old plain text.
const expertiseRegels = lid.expertiseRegels ?? [];
const expertiseTekst = regels(en ? lid.expertiseEn || lid.expertise : lid.expertise);
const expertise = expertiseRegels.length > 0 ? expertiseRegels : expertiseTekst.map((r) => [{ tekst: r }]);
const motivatie = kies(lid.motivatieRich ?? lid.motivatie, lid.motivatieEnRich, lid.motivatieEn);
const quote = lid.quote?.trim().replace(/^[“"„]+|[”"]+$/g, "").replace(/\.{2,}$/, ".");

const kine = lid.disciplines.includes("kine");
const coach = !kine && lid.disciplines.includes("pt");
const expertiseKop = !kine && !coach
  ? en ? "At Movenda" : "Binnen Movenda"
  : en ? "Expertise and coaching" : "Expertise en begeleiding";
const motivatieKop = en
  ? `I chose ${kine ? "physiotherapy" : "coaching"} because…`
  : `Ik koos voor ${kine ? "kinesitherapie" : "coaching"} omdat…`;
const quoteKop = en
  ? `In our ${kine ? "therapist" : "coach"}'s words`
  : `Woorden van onze ${kine ? "therapeut" : "coach"}`;
const kopClass = "text-sm font-semibold uppercase tracking-wide text-brand-muted";
---

<div class="mt-6 space-y-4 text-brand-muted">
  <RichText value={bio} />
</div>

{(!isLeeg(motivatie) || quote) && (
  <div class="mt-8 space-y-8">
    {!isLeeg(motivatie) && (
      <div>
        <p class={kopClass}>{motivatieKop}</p>
        <div class="mt-2 space-y-3 text-brand-muted">
          <RichText value={motivatie} />
        </div>
      </div>
    )}
    {quote && (
      <figure class="border-l-2 border-brand-primary pl-5">
        <figcaption class={kopClass}>{quoteKop}</figcaption>
        <blockquote class="mt-2 text-2xl font-medium italic leading-snug text-brand-text">“{quote}”</blockquote>
      </figure>
    )}
  </div>
)}

{(expertise.length > 0 || lid.specialisaties.length > 0) && (
  <div class="mt-10">
    <h2 class={kopClass}>{expertiseKop}</h2>
    {expertise.length > 0 && (
      <ul class="mt-3 divide-y divide-brand-border border-y border-brand-border">
        {expertise.map((regel) => (
          <li class="py-2.5 text-brand-text">
            {regel.map((el, i) => {
              const href = expertiseElementHref(el, lang);
              return (
                <>
                  {i > 0 && " · "}
                  {href ? <a href={href} class="text-brand-primary hover:underline">{expertiseElementNaam(el, lang)}</a> : expertiseElementNaam(el, lang)}
                </>
              );
            })}
          </li>
        ))}
      </ul>
    )}
    {lid.specialisaties.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {lid.specialisaties.map((s) => (
          <li>
            {s.dienst ? (
              <a href={dienstHref(s.dienst, lang)} class="rounded-full bg-brand-surface px-3 py-1 text-sm text-brand-primary hover:underline">{specialisatieNaam(s, lang)}</a>
            ) : (
              <span class="rounded-full bg-brand-surface px-3 py-1 text-sm text-brand-text">{specialisatieNaam(s, lang)}</span>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
)}

{lid.clubs.length > 0 && (
  <div class="mt-8">
    <h2 class={kopClass}>Clubs</h2>
    <ul class="mt-2 flex flex-wrap gap-2 text-sm">
      {lid.clubs.map((c) => (
        <li>
          {c.url ? (
            <a href={c.url} target="_blank" rel="noopener" class="text-brand-primary hover:underline">{c.naam.trim()}</a>
          ) : (
            c.naam.trim()
          )}
        </li>
      ))}
    </ul>
  </div>
)}
