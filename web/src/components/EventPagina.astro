---
// One event, with the full text, photo, video and optional info button.
import Layout from "../layouts/Layout.astro";
import EventInstagram from "./EventInstagram.astro";
import EventVideo from "./EventVideo.astro";
import RichText from "./RichText.astro";
import { isLeeg } from "../lib/rich-text";
import { eventInfoHref, getEvents } from "../lib/content";
import { breadcrumbNode } from "../lib/schema";
import { withLang, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
  slug: string;
}

const { lang = "nl", slug } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const event = (await getEvents()).find((item) => item.slug === slug);

if (!event) {
  return Astro.redirect(withLang("/events", lang));
}

const titel = (en && event.titelEn) || event.titel;
const tekst = (en && event.tekstEn) || event.tekst || "";
// Formatted text: English when filled in, else Dutch (a plain string until converted in Sanity).
const tekstRich = en && !isLeeg(event.tekstEnRich) ? event.tekstEnRich : (event.tekstRich ?? event.tekst);
const locale = en ? "en-GB" : "nl-BE";
const date = new Date(`${event.datum}T12:00:00`);
const geldig = !Number.isNaN(date.getTime());
const dag = geldig ? String(date.getDate()) : "";
const maand = geldig ? new Intl.DateTimeFormat(locale, { month: "short" }).format(date).replace(".", "") : "";
const jaar = geldig ? String(date.getFullYear()) : "";
const weekdag = geldig ? new Intl.DateTimeFormat(locale, { weekday: "long" }).format(date) : "";
const volledig = geldig
  ? new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" }).format(date)
  : event.datum;
const instagram = event.instagram?.trim() || "";
const instagramLabel = (en && event.instagramLabelEn?.trim()) || event.instagramLabel?.trim() || "";
const path = `${prefix}/events/${event.slug}`;
const knopHref = event.link?.trim() ? eventInfoHref(event, lang) : "";
const knopExtern = /^https?:/i.test(knopHref);
const knop = event.linkLabel || (en ? "More info" : "Meer info");
// Posters are often portrait (1080×1350): show the whole frame, never a landscape crop.
const foto = event.foto ? `${event.foto}?w=1600&fit=max&auto=format` : undefined;
const fotoMaat = event.foto?.match(/-(\d+)x(\d+)\.\w+(?:\?|$)/);
const fotoBreedte = fotoMaat ? Number(fotoMaat[1]) : 1600;
const fotoHoogte = fotoMaat ? Number(fotoMaat[2]) : 1000;
const description = tekst.replace(/\s+/g, " ").trim().slice(0, 160);
const mb = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
const bijlagen = (event.bijlagen || []).map((bijlage) => {
  const bestand = bijlage.bestandsnaam || "bijlage.pdf";
  return {
    // A trailing filename on a Sanity file URL is the name the browser tab shows.
    bekijk: `${bijlage.url}/${encodeURIComponent(bestand.replace(/\s+/g, "-"))}`,
    // Sanity's ?dl= serves the file as an attachment with this filename.
    download: `${bijlage.url}?dl=${encodeURIComponent(bestand)}`,
    naam: bijlage.titel?.trim() || bestand.replace(/\.pdf$/i, ""),
    info: bijlage.grootte ? `PDF · ${mb.format(bijlage.grootte / 1_000_000)} MB` : "PDF",
  };
});
---

<Layout
  title={`${titel} | Movenda`}
  description={description}
  path={path}
  altPath={en ? `/events/${event.slug}` : `/en/events/${event.slug}`}
  lang={lang}
  ogImage={event.foto}
  jsonLd={[
    breadcrumbNode([
      { name: "Home", path: prefix || "/" },
      { name: "Events", path: `${prefix}/events` },
      { name: titel, path },
    ]),
  ]}
>
  <section class="page-ink">
    <article class="mx-auto max-w-3xl px-4 py-12 md:py-16">
      <a class="brief-textlink mt-0" href={withLang("/events", lang)}>{en ? "All events" : "Alle events"}</a>
      <div class="event-pagina__kop">
        <time class="event-pagina__datum" datetime={event.datum} aria-label={volledig}>
          <span class="event-pagina__dag">{dag}</span>
          <span class="event-pagina__maand">{maand}</span>
          <span class="event-pagina__jaar">{jaar}</span>
        </time>
        <div>
          <p class="event-pagina__meta">{weekdag}{event.locatie && ` · ${event.locatie}`}</p>
          <h1>{titel}</h1>
        </div>
      </div>
      {typeof tekstRich === "string"
        ? tekstRich.trim() && <p class="event-pagina__tekst">{tekstRich}</p>
        : !isLeeg(tekstRich) && <RichText value={tekstRich} pClass="event-pagina__tekst" />}
      {knopHref && (
        <a class="event-pagina__knop" href={knopHref} {...(knopExtern ? { target: "_blank", rel: "noopener" } : {})}>
          {knop}
        </a>
      )}
      {bijlagen.length > 0 && (
        <ul class="event-pagina__bijlagen" aria-label="Downloads">
          {bijlagen.map((bijlage) => (
            <li class="event-pagina__bijlage">
              <span class="event-pagina__bijlage-tekst">
                <span class="event-pagina__bijlage-naam">{bijlage.naam}</span>
                <span class="event-pagina__bijlage-info">{bijlage.info}</span>
              </span>
              <span class="event-pagina__bijlage-knoppen">
                <a
                  class="event-pagina__bijlage-knop"
                  href={bijlage.bekijk}
                  target="_blank"
                  rel="noopener"
                  aria-label={en ? `View ${bijlage.naam}` : `Bekijk ${bijlage.naam}`}
                >
                  {en ? "View" : "Bekijken"}
                </a>
                <a
                  class="event-pagina__bijlage-knop event-pagina__bijlage-knop--download"
                  href={bijlage.download}
                  download
                  aria-label={en ? `Download ${bijlage.naam}` : `Download ${bijlage.naam}`}
                >
                  Download
                </a>
              </span>
            </li>
          ))}
        </ul>
      )}
      {instagram ? (
        <EventInstagram href={instagram} foto={event.foto} titel={titel} label={instagramLabel} lang={lang} />
      ) : (
        <EventVideo video={event.video} foto={event.foto} titel={titel} />
      )}
      {foto && !event.video && !instagram && (
        <img class="event-pagina__foto" src={foto} alt="" width={fotoBreedte} height={fotoHoogte} />
      )}
    </article>
  </section>
</Layout>

<style>
  .event-pagina__kop {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .event-pagina__datum {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    min-width: 5.25rem;
    padding: 0.85rem 0.75rem 0.7rem;
    border-radius: 0.9rem;
    background: #f3eee4;
    line-height: 1;
    text-align: center;
  }

  .event-pagina__datum span {
    color: #161513 !important;
  }

  .event-pagina__dag {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .event-pagina__maand {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .event-pagina__jaar {
    margin-top: 0.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.6;
  }

  .event-pagina__meta {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .event-pagina__kop h1 {
    margin-top: 0.35rem;
    font-size: clamp(2rem, 1.4rem + 2vw, 3.2rem);
    line-height: 1.05;
  }

  /* Paragraphs come from RichText (set:html), so they carry no Astro scope attribute. */
  :global(.event-pagina__tekst) {
    margin-top: 1.5rem;
    line-height: 1.6;
    white-space: pre-line;
  }

  /* A blank line in the old plain text was exactly one line high (line-height 1.6). */
  :global(.event-pagina__tekst + .event-pagina__tekst) {
    margin-top: 1.6em;
  }

  :global(.event-pagina__tekst a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event-pagina__knop {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0 1.35rem;
    border-radius: 9999px;
    font-weight: 650;
    background: #f3eee4;
    color: #161513 !important;
  }

  .event-pagina__knop::after {
    content: "→";
  }

  .event-pagina__bijlagen {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
    list-style: none;
  }

  .event-pagina__bijlage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 1rem 1rem 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 1rem;
  }

  .event-pagina__bijlage-tekst {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .event-pagina__bijlage-naam {
    font-weight: 650;
  }

  .event-pagina__bijlage-info {
    font-size: 0.82rem;
    opacity: 0.65;
  }

  .event-pagina__bijlage-knoppen {
    display: flex;
    gap: 0.5rem;
  }

  .event-pagina__bijlage-knop {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    padding: 0 1.15rem;
    border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    border-radius: 9999px;
    font-size: 0.92rem;
    font-weight: 650;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .event-pagina__bijlage-knop:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .event-pagina__bijlage-knop--download {
    gap: 0.45rem;
    border-color: transparent;
    background: #f3eee4;
    color: #161513 !important;
  }

  .event-pagina__bijlage-knop--download::before {
    content: "↓";
  }

  .event-pagina__bijlage-knop--download:hover {
    background: #fffdf8;
  }

  .event-pagina__foto {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(85vh, 46rem);
    margin-top: 1.75rem;
    border-radius: 1rem;
  }
</style>
