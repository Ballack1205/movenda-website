---
import type { BlogPost } from "../lib/content";
import { blogPhotoSrc } from "../lib/images";

interface Props {
  post: BlogPost;
  flipped?: boolean;
}

const { post, flipped = false } = Astro.props;
const contain = post.coverFit === "contain";

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("nl-BE", { day: "numeric", month: "long", year: "numeric" });
}
---

<a href={`/blog/${post.slug}`} class="group grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
  {post.cover && (
    <div
      class:list={[
        "overflow-hidden rounded-3xl shadow-xl",
        contain ? "bg-white" : "bg-brand-header/10",
        flipped && "lg:order-2",
      ]}
    >
      <img
        src={blogPhotoSrc(post.cover, "card")}
        alt={post.titel}
        width="1100"
        height="1400"
        class:list={[
          "w-full transition duration-500 group-hover:scale-[1.03]",
          contain
            ? "aspect-[5/4] object-contain p-6 sm:p-10"
            : "aspect-[16/10] object-cover object-top sm:aspect-[5/4] lg:aspect-[4/5]",
        ]}
      />
    </div>
  )}
  <div class:list={[flipped && "lg:order-1"]}>
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-muted">
      {formatDate(post.publicatiedatum)}
      {post.auteurNaam ? ` · ${post.auteurNaam}` : ""}
    </p>
    <h2 class="mt-3 text-pretty text-3xl font-bold tracking-tight sm:text-4xl">{post.titel}</h2>
    {post.excerpt && <p class="mt-4 text-lg leading-relaxed text-brand-muted">{post.excerpt}</p>}
    <span class="mt-6 inline-block text-sm font-semibold text-brand-primary">Meer lezen →</span>
  </div>
</a>
