---
import type { BlogPost } from "../lib/content";
import { blogPhotoSrc } from "../lib/images";
import { blogTagLabel, formatBlogDate } from "../lib/blog";
import { withLang, type Lang } from "../lib/i18n";

interface Props {
  post: BlogPost;
  lang?: Lang;
}

const { post, lang = "nl" } = Astro.props;
const contain = post.coverFit === "contain";
const tag = post.tags?.[0];
const titel = lang === "en" ? post.titelEn || post.titel : post.titel;
const excerpt = lang === "en" ? post.excerptEn || post.excerpt : post.excerpt;
---

<a href={withLang(`/blog/${post.slug}`, lang)} class="group grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
  {post.cover && (
    <div
      class:list={[
        "overflow-hidden rounded-3xl shadow-xl",
        contain ? "bg-white" : "bg-brand-header/10",
      ]}
    >
      <img
        src={blogPhotoSrc(post.cover, "hero")}
        alt={titel}
        width="1400"
        height="880"
        class:list={[
          "aspect-[16/10] w-full transition duration-500 group-hover:scale-[1.03]",
          contain ? "object-contain p-6 sm:p-8" : "object-cover object-top",
        ]}
      />
    </div>
  )}
  <div>
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-muted">
      {tag ? `${blogTagLabel(tag, lang)} · ` : ""}
      {formatBlogDate(post.publicatiedatum, lang)}
      {post.auteurNaam ? ` · ${post.auteurNaam}` : ""}
    </p>
    <h2 class="mt-3 text-pretty text-3xl font-bold tracking-tight sm:text-4xl">{titel}</h2>
    {excerpt && <p class="mt-4 text-lg leading-relaxed text-brand-muted">{excerpt}</p>}
    <span class="mt-6 inline-block text-sm font-semibold text-brand-primary">
      {lang === "en" ? "Read more →" : "Meer lezen →"}
    </span>
  </div>
</a>
