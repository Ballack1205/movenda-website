---
// The event's Instagram Reel or post. A click leaves the site and opens Instagram.
interface Props {
  href: string;
  foto?: string;
  titel: string;
  lang?: "nl" | "en";
}

const { href, foto, titel, lang = "nl" } = Astro.props;
const label = lang === "en" ? `Watch ${titel} on Instagram` : `Bekijk ${titel} op Instagram`;
const src = foto ? `${foto}?w=1200&fit=max&auto=format` : undefined;
---

<a class="event-ig" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
  {src && <img src={src} alt="" width="1200" height="750" />}
  <span class="event-ig__label">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10c0 1.1.9 2 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 2A1.8 1.8 0 1 0 13.8 12 1.8 1.8 0 0 0 12 10.2zM17.2 6.8a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"
      />
    </svg>
    {lang === "en" ? "Watch on Instagram" : "Bekijk op Instagram"}
  </span>
</a>

<style>
  .event-ig {
    display: block;
    margin-top: 1.25rem;
  }

  .event-ig img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 0.9rem;
    object-fit: cover;
    object-position: center 32%;
  }

  .event-ig__label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.75rem;
    color: inherit;
    font-size: 0.95rem;
    font-weight: 650;
  }

  .event-ig__label svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }

  .event-ig:hover .event-ig__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
