---
import VerwijskompasVisual from "./VerwijskompasVisual.astro";
import type { KompasWeergave, VerwijskompasTree } from "../lib/content";

interface Props {
  tree: VerwijskompasTree;
  weergave?: { mobiel: KompasWeergave; desktop: KompasWeergave };
  team?: { slug: string; rol?: string; locatie?: string; locaties?: string[]; face: string | null }[];
}

const { tree, weergave = { mobiel: "stappen", desktop: "stappen" }, team = [] } = Astro.props;
const useVisual = weergave.mobiel === "visual" || weergave.desktop === "visual";
---

{useVisual && <VerwijskompasVisual tree={tree} team={team} />}

<dialog
  data-verwijskompas
  aria-labelledby="verwijskompas-titel"
  class="m-auto w-[min(100vw-2rem,40rem)] max-h-[min(100dvh-2rem,44rem)] rounded-2xl bg-brand-surface p-0 text-brand-text shadow-2xl backdrop:bg-brand-header/60 backdrop:backdrop-blur-sm max-sm:mb-0 max-sm:mt-auto max-sm:max-h-[92dvh] max-sm:w-screen max-sm:max-w-none max-sm:rounded-b-none md:w-[min(100vw-3rem,56rem)] md:max-h-[min(100dvh-3rem,48rem)]"
>
  <div class="flex max-h-[inherit] flex-col">
    <header class="flex items-start justify-between gap-3 border-b border-brand-border px-4 py-4 sm:px-6">
      <div class="min-w-0">
        <h2 id="verwijskompas-titel" class="text-xl font-semibold">Verwijskompas</h2>
        <p class="mt-1 text-sm text-brand-muted" data-kompas-lead>
          Kies je vraag en boek meteen online.
        </p>
      </div>
      <button
        type="button"
        data-kompas-close
        class="-mr-2 -mt-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-brand-muted transition hover:bg-brand-bg hover:text-brand-text"
        aria-label="Sluiten"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </header>
    <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4 sm:px-6 sm:py-5">
      <button type="button" data-kompas-back hidden class="mb-3 text-sm font-semibold text-brand-primary hover:underline">
        Terug
      </button>
      <p class="text-sm font-semibold" data-kompas-title></p>
      <div class="mt-3 flex flex-col gap-2" data-kompas-body></div>
    </div>
  </div>
</dialog>

<script define:vars={{ tree, weergave }} is:inline>
  const dialog = document.querySelector("[data-verwijskompas]");
  const visual = document.querySelector("[data-kompas-visual]");
  const wantsVisual = () => {
    const desktop = window.matchMedia("(min-width: 1024px)").matches;
    return Boolean(visual) && (desktop ? weergave.desktop : weergave.mobiel) === "visual";
  };
  if (dialog) {
    const titleEl = dialog.querySelector("[data-kompas-title]");
    const bodyEl = dialog.querySelector("[data-kompas-body]");
    const backBtn = dialog.querySelector("[data-kompas-back]");
    const stack = [];
    const byId = (list) => Object.fromEntries(list.map((item) => [item.id, item]));
    const contexts = byId(tree.contexts);
    const regions = byId(tree.regions);
    const sports = byId(tree.sports);
    const training = byId(tree.training);

    const esc = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

    function personHtml(id) {
      const person = tree.people[id];
      if (!person) return "";
      if (person.book) {
        return `<a class="font-semibold text-brand-primary underline decoration-brand-border underline-offset-4 hover:decoration-brand-primary" href="${esc(person.book)}" target="_blank" rel="noopener noreferrer">${esc(person.naam)}</a>`;
      }
      return `<span>${esc(person.naam)}</span>`;
    }

    function choiceButton(label, key) {
      return `<button type="button" data-kompas-choice="${esc(key)}" class="min-h-11 rounded-xl border border-brand-border bg-brand-bg px-4 py-3 text-left text-sm font-medium leading-snug transition hover:border-brand-primary">${esc(label)}</button>`;
    }

    function setBodyLayout(split) {
      bodyEl.className = split
        ? "mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2"
        : "mt-3 flex flex-col gap-3";
    }

    function showResult(item, heading) {
      const names = item.people || [];
      const people = names.map((id) => `<li class="border-b border-brand-border py-2.5">${personHtml(id)}</li>`).join("");
      const book = item.book
        ? `<a class="inline-flex min-h-11 items-center self-start rounded-full bg-brand-primary px-5 py-2 text-sm font-semibold text-white hover:opacity-90" href="${esc(item.book)}" target="_blank" rel="noopener noreferrer">Boek online ↗</a>`
        : "";
      titleEl.textContent = heading;
      setBodyLayout(false);
      const cols = names.length >= 4 ? "sm:grid-cols-2 sm:gap-x-8" : "";
      bodyEl.innerHTML = `${book}${!book && names.length ? `<ul class="grid grid-cols-1 ${cols}">${people}</ul>` : ""}`;
    }

    function showChoices(heading, choices) {
      titleEl.textContent = heading;
      setBodyLayout(choices.length >= 2);
      bodyEl.innerHTML = choices.map((choice) => choiceButton(choice.label, choice.key)).join("");
    }

    function render() {
      const frame = stack[stack.length - 1];
      backBtn.hidden = stack.length < 2;
      if (frame.kind === "home") {
        showChoices("Waar ben je naar op zoek?", [
          { label: "Kinesitherapie", key: "kine" },
          { label: "Training & coaching", key: "training" },
        ]);
      } else if (frame.kind === "contexts") {
        showChoices("Wat past het best?", tree.contexts.map((item) => ({ label: item.label, key: item.id })));
      } else if (frame.kind === "regions") {
        showChoices("Kies een regio", tree.regions.map((item) => ({ label: item.label, key: item.id })));
      } else if (frame.kind === "sports") {
        showChoices("Kies een sport", tree.sports.map((item) => ({ label: item.label, key: item.id })));
      } else if (frame.kind === "training") {
        showChoices("Training & coaching", tree.training.map((item) => ({ label: item.label, key: item.id })));
      } else if (frame.kind === "result") {
        showResult(frame.item, frame.heading);
      }
    }

    function push(frame) {
      stack.push(frame);
      render();
    }

    function open() {
      if (wantsVisual()) {
        visual.dispatchEvent(new CustomEvent("kompas:open"));
        return;
      }
      stack.length = 0;
      push({ kind: "home" });
      if (!dialog.open) dialog.showModal();
      if (location.hash !== "#keuzehulp") history.replaceState(null, "", `${location.pathname}${location.search}#keuzehulp`);
    }

    bodyEl.addEventListener("click", (event) => {
      const button = event.target.closest("[data-kompas-choice]");
      if (!button) return;
      const key = button.dataset.kompasChoice;
      const frame = stack[stack.length - 1];
      if (frame.kind === "home") {
        push({ kind: key === "training" ? "training" : "contexts" });
        return;
      }
      if (frame.kind === "contexts") {
        const item = contexts[key];
        if (item.next === "regio") push({ kind: "regions" });
        else if (item.next === "sport") push({ kind: "sports" });
        else push({ kind: "result", item, heading: item.label });
        return;
      }
      if (frame.kind === "regions") {
        const item = regions[key];
        push({ kind: "result", item, heading: item.label });
        return;
      }
      if (frame.kind === "sports") {
        const item = sports[key];
        push({ kind: "result", item, heading: item.label });
        return;
      }
      if (frame.kind === "training") {
        const item = training[key];
        push({ kind: "result", item, heading: item.label });
      }
    });

    backBtn.addEventListener("click", () => {
      if (stack.length > 1) stack.pop();
      render();
    });
    dialog.querySelector("[data-kompas-close]").addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      if (location.hash === "#keuzehulp") history.replaceState(null, "", `${location.pathname}${location.search}`);
    });
    document.querySelectorAll("[data-open-keuzehulp]").forEach((button) => button.addEventListener("click", open));
    if (location.hash === "#keuzehulp") open();
  }
</script>
