---
import Layout from "../layouts/Layout.astro";
import LinkedText from "./LinkedText.astro";
import { getLocaties, getPagina, getSiteSettings, paginaBlokKop, paginaBlokTekst, paginaTekst, tekstChunks, uiTekst } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import { prijzenInfoText, withLang, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const locaties = await getLocaties();
const settings = await getSiteSettings();
const pagina = await getPagina("voorwaarden");
const annulatie = prijzenInfoText(settings.prijzenInfo, "annulatiebeleid", lang);
const path = `${prefix}/voorwaarden`;
const [eerste, ...rest] = pagina.blokken;
const privacyZin = paginaTekst(pagina, "privacyZin", lang).replace("](/privacy)", `](${withLang("/privacy", lang)})`);
---

<Layout
  title={paginaTekst(pagina, "seoTitle", lang)}
  description={paginaTekst(pagina, "seoDescription", lang)}
  path={path}
  altPath={en ? "/voorwaarden" : "/en/voorwaarden"}
  lang={lang}
  jsonLd={[breadcrumbSchema([{ name: "Home", path: prefix || "/" }, { name: paginaTekst(pagina, "titel", lang), path }])]}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    {paginaTekst(pagina, "ondertitel", lang) && (
      <p class="text-sm font-semibold uppercase tracking-wide">{paginaTekst(pagina, "ondertitel", lang)}</p>
    )}
    <h1 class="mt-2 text-3xl font-bold">{paginaTekst(pagina, "titel", lang)}</h1>
    {paginaTekst(pagina, "intro", lang) && <p class="mt-4 text-brand-muted">{paginaTekst(pagina, "intro", lang)}</p>}

    <h2 class="mt-8 text-xl font-semibold">{paginaTekst(pagina, "wieTitel", lang)}</h2>
    <ul class="mt-3 space-y-2 text-brand-muted">
      {locaties.map((locatie) => (
        <li>
          {locatie.slug === "mpc" ? "Performance Centre" : "Movenda"} — {locatie.adres} — {uiTekst(settings, "locatie", "btw", lang)} {locatie.btw}
        </li>
      ))}
    </ul>

    {eerste && (
      <section>
        <h2 class="mt-8 text-xl font-semibold">{paginaBlokKop(eerste, lang)}</h2>
        {tekstChunks(paginaBlokTekst(eerste, lang)).map((chunk) =>
          chunk.kind === "ul" ? (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-brand-muted">
              {chunk.lines.map((line) => <li><LinkedText text={line} /></li>)}
            </ul>
          ) : (
            chunk.lines.map((line) => <p class="mt-3 text-brand-muted"><LinkedText text={line} /></p>)
          ),
        )}
      </section>
    )}

    {annulatie && (
      <>
        <h2 class="mt-8 text-xl font-semibold">{paginaTekst(pagina, "annulatieTitel", lang)}</h2>
        <p class="mt-3 text-brand-muted">{annulatie}</p>
      </>
    )}

    {rest.map((blok) => (
      <section>
        <h2 class="mt-8 text-xl font-semibold">{paginaBlokKop(blok, lang)}</h2>
        {tekstChunks(paginaBlokTekst(blok, lang)).map((chunk) =>
          chunk.kind === "ul" ? (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-brand-muted">
              {chunk.lines.map((line) => <li><LinkedText text={line} /></li>)}
            </ul>
          ) : (
            chunk.lines.map((line) => <p class="mt-3 text-brand-muted"><LinkedText text={line} /></p>)
          ),
        )}
      </section>
    ))}

    {privacyZin && (
      <p class="mt-6 text-sm text-brand-muted">
        <LinkedText text={privacyZin} linkClass="underline" />
      </p>
    )}
  </article>
</Layout>
