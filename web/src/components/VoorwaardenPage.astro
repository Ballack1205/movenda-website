---
import Layout from "../layouts/Layout.astro";
import { getLocaties, getSiteSettings } from "../lib/content";
import { breadcrumbSchema } from "../lib/schema";
import { prijzenInfoText, withLang, type Lang } from "../lib/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "nl" } = Astro.props;
const en = lang === "en";
const prefix = en ? "/en" : "";
const locaties = await getLocaties();
const settings = await getSiteSettings();
const annulatie = prijzenInfoText(settings.prijzenInfo, "annulatiebeleid", lang);
const path = `${prefix}/voorwaarden`;
---

<Layout
  title={en ? "Terms | Movenda" : "Algemene voorwaarden | Movenda"}
  description={en
    ? "Draft terms for Movenda and the Performance Centre. Still to be reviewed."
    : "Concept algemene voorwaarden van Movenda en het Performance Centre. Nog na te lezen."}
  path={path}
  altPath={en ? "/voorwaarden" : "/en/voorwaarden"}
  lang={lang}
  jsonLd={[breadcrumbSchema([{ name: "Home", path: prefix || "/" }, { name: en ? "Terms" : "Algemene voorwaarden", path }])]}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <p class="text-sm font-semibold uppercase tracking-wide">{en ? "Draft" : "Concept"}</p>
    <h1 class="mt-2 text-3xl font-bold">{en ? "Terms" : "Algemene voorwaarden"}</h1>
    <p class="mt-4 text-brand-muted">
      {en
        ? "This is a draft for the two practices. Have the accountant or a lawyer read it before go-live."
        : "Dit is een concept voor de twee praktijken. Laat het nalezen door de boekhouder of jurist voor het live gaat."}
    </p>
    <h2 class="mt-8 text-xl font-semibold">{en ? "Who" : "Wie"}</h2>
    <ul class="mt-3 space-y-2 text-brand-muted">
      {locaties.map((locatie) => (
        <li>{locatie.slug === "mpc" ? "Performance Centre" : "Movenda"} — {locatie.adres} — {en ? "VAT" : "BTW"} {locatie.btw}</li>
      ))}
    </ul>
    <h2 class="mt-8 text-xl font-semibold">{en ? "Appointments" : "Afspraken"}</h2>
    <p class="mt-3 text-brand-muted">
      {en
        ? "We work by appointment only. A session lasts about 30 minutes, including administration and changing, unless agreed otherwise."
        : "We werken enkel op afspraak. Een sessie duurt ongeveer 30 minuten, inclusief administratie en omkleden, tenzij anders afgesproken."}
    </p>
    {annulatie && (
      <>
        <h2 class="mt-8 text-xl font-semibold">{en ? "Cancellation" : "Annuleren"}</h2>
        <p class="mt-3 text-brand-muted">{annulatie}</p>
      </>
    )}
    <h2 class="mt-8 text-xl font-semibold">{en ? "Fees and reimbursement" : "Tarieven en terugbetaling"}</h2>
    <p class="mt-3 text-brand-muted">
      {en
        ? "Fees are on the prices page and can differ per therapist. You receive a certificate of care and claim reimbursement from your health insurance fund yourself."
        : "De tarieven staan op de prijspagina en kunnen per therapeut verschillen. Je krijgt een getuigschrift en vraagt de terugbetaling zelf aan bij je ziekenfonds."}
    </p>
    <p class="mt-6 text-sm text-brand-muted">
      {en ? "See also the" : "Zie ook de"} <a class="underline" href={withLang("/privacy", lang)}>{en ? "privacy policy" : "privacyverklaring"}</a>.
    </p>
  </article>
</Layout>
